<bar protocol-version="0" widget="true"
     category="ai"
     version="1.2.1"
     icon="data:image/svg+xml;base64,"
     description="Monitor AI coding token usage, daily spend, model breakdown, and multi-device submissions on Tokens (tokens.ci)."
     license="AGPL-3.0-only"
     homepage="https://tokens.ci"
     id="tokens"
     title="Tokens"
     refresh="5m"
     material="solid">

  <permissions>
    <network origin="{{ inputs.baseURL }}" />
    <network origin="https://avatars.githubusercontent.com" />
    <file path="{{ inputs.credentials }}" />
  </permissions>

  <inputs>
    <input name="username"
           type="string"
           label="GitHub Username"
           placeholder="Auto-detect from ~/.config/tokens/credentials.json"
           help="Optional when logged in with the Tokens CLI (`tokens login`). Enter any GitHub username to view a public profile." />
    <input name="token"
           type="secret"
           label="Read or API Token"
           help="Optional. A read token (`tkr_…`) unlocks a private profile; a personal API token (`tt_…`) unlocks unmasked device names." />
    <input name="readToken"
           type="secret"
           label="Private Read Token"
           help="Saved automatically by Connect Private Account. You can also paste a read token (`tkr_…`) here. Takes priority over a read token in Read or API Token." />
    <input name="trayFormat"
           type="select"
           label="Tray Display"
           default="today_cost"
           help="Metrics displayed in the macOS menu bar / system tray.">
      <option value="today_cost" label="14.2M · $8.40 (Today Tokens + Today Cost - Default)" />
      <option value="today_rank" label="14.2M · #38 (Today Tokens + Rank)" />
      <option value="total_rank" label="1.2B · #38 (Total Tokens + Rank)" />
      <option value="total_cost" label="1.2B · $420 (Total Tokens + Total Cost)" />
      <option value="today_only" label="14.2M (Today Tokens Only)" />
      <option value="cost_only" label="$8.40 (Today Cost Only)" />
    </input>
    <input name="baseURL"
           type="string"
           label="Tokens Server URL"
           default="https://tokens.ci"
           required="true"
           help="Base URL of the Tokens instance (default: `https://tokens.ci`)." />
    <input name="credentials"
           type="file"
           label="Tokens CLI Credentials"
           default="~/.config/tokens/credentials.json"
           help="Path to the credentials file written by `tokens login` (`~/.config/tokens/credentials.json`)." />
  </inputs>

  <docs><![CDATA[Reads your Tokens account automatically from ~/.config/tokens/credentials.json after running `tokens login`. If a private account only shows totals, click Connect Private Account to create and securely save a read token using your CLI login. Connecting enables Private Mode; it never makes the account public. Your CLI credentials and existing API token are preserved. You can also enter any GitHub username in Inputs to view a public profile without signing in, or paste a Read Token (tkr_…) into Private Read Token. Add a small, medium, or large Metrix.Bar widget through your system's widget picker and select Tokens.]]></docs>

  <script apis="app auth clipboard dialog localStorage match-media screenshot shell"><![CDATA[
// Tokens (tokens.ci) AI coding usage dashboard for Metrix.Bar.

const h = (type, props, ...children) => ({
  type,
  props: props || {},
  children: children.flat().filter(c => c !== null && c !== undefined && c !== false),
});
const TX = (text, props) => h("Text", props, String(text));

const K = {
  muted: "textMuted",
  hover: "surfaceHover",
  press: "surfacePressed",
  line: "border",
  up: "success",
  warn: "warning",
  down: "danger",
  accent: "accent",
};
const W = 420;

const svg = paths =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

// Official Tokens brand mark: public/brand/tokens-mark.svg
const BRAND = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 64 64" fill="none"><g stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none"><path d="M14 15h36"/><path d="M32 15v34"/><path d="M22 27h20" opacity="0.75"/><path d="M24.5 37h15" opacity="0.5"/><path d="M27 47h10" opacity="0.3"/></g></svg>`;

const ICON = {
  brand: BRAND,
  refresh: svg(`<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>`),
  external: svg(`<path d="M7 7h10v10"/><path d="M7 17 17 7"/>`),
  back: svg(`<path d="m15 18-6-6 6-6"/>`),
  alert: svg(`<circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>`),
  check: svg(`<path d="M20 6 9 17l-5-5"/>`),
  sun: svg(`<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>`),
  zap: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h8l-1 8 10-12h-8l1-8z"/></svg>`,
  clock: svg(`<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`),
  flame: svg(`<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>`),
  coins: svg(`<circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/>`),
  calendar: svg(`<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>`),
  upload: svg(`<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>`),
  pie: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M11 2.05V13h10.95A10.003 10.003 0 0 1 12 22C6.477 22 2 17.523 2 12c0-5.185 3.947-9.449 9-9.95Zm2 0A10.003 10.003 0 0 1 21.95 11H13V2.05Z"/></svg>`,
  grid: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="3" width="4.5" height="4.5" rx="1"/><rect x="16.5" y="3" width="4.5" height="4.5" rx="1"/><rect x="3" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="16.5" y="9.75" width="4.5" height="4.5" rx="1"/><rect x="3" y="16.5" width="4.5" height="4.5" rx="1"/><rect x="9.75" y="16.5" width="4.5" height="4.5" rx="1"/><rect x="16.5" y="16.5" width="4.5" height="4.5" rx="1"/></svg>`,
  layers: svg(`<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>`),
  cpu: svg(`<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>`),
  laptop: svg(`<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/>`),
  chart: svg(`<line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/>`),
  lock: svg(`<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>`),
  trophy: svg(`<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>`),
  receipt: svg(`<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>`),
  palette: svg(`<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>`),
  copy: svg(`<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>`),
  download: svg(`<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>`),
  chevLeft: svg(`<path d="m15 18-6-6 6-6"/>`),
  chevRight: svg(`<path d="m9 18 6-6-6-6"/>`),
  chevDown: svg(`<path d="m6 9 6 6 6-6"/>`),
  chevUp: svg(`<path d="m18 15-6-6-6 6"/>`),
};

const Icon = (name, size, color, extra) =>
  h("Icon", {
    svg: ICON[name] || BRAND,
    ...extra,
    tw: `text-[${size || 14}px] size-[${size || 14}px] text-${color || K.muted} shrink-0 ${(extra && extra.tw) || ""}`,
  });

// ---------------------------------------------------------------------------
// Client Display Names & Brand Colors (from missuo/tokens web/src/lib/constants.ts)
// ---------------------------------------------------------------------------

const CLIENT_NAMES = {
