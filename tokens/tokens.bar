const MODEL_ICON_RULES = [
  { needles: ["composer", "cursor"], icon: "cursor", color: "#22c55e" },
  { needles: ["claude", "anthropic", "fable", "sonnet", "opus", "haiku"], icon: "claude", color: "#d97757" },
  { needles: ["gpt", "codex", "openai", "o1-", "o3-", "o4-"], icon: "openai", color: "text" },
  { needles: ["gemini", "gemma"], icon: "gemini", color: "#3b82f6" },
  { needles: ["deepseek"], icon: "deepseek", color: "#4D6BFE" },
  { needles: ["kimi", "moonshot", "k2p", "k2-", "k2.", "k3"], icon: "kimi", color: "#8B5CF6" },
  { needles: ["glm", "chatglm", "z-ai", "zai"], icon: "zai", color: "#10b981" },
  { needles: ["grok", "x-ai", "xai"], icon: "grok", color: "text" },
  { needles: ["qwen"], icon: "qwen", color: "#6366f1" },
  { needles: ["minimax"], icon: "minimax", color: "#F04438" },
  { needles: ["mistral", "magistral", "devstral"], icon: "mistral", color: "#f97316" },
];

function matchModelIconRule(model) {
  const id = String(model || "").toLowerCase();
  for (const rule of MODEL_ICON_RULES) {
    if (rule.needles.some(n => id.includes(n))) return rule;
  }
  return null;
}

const MIX_DEFS = [
  { key: "input", labelZh: "Input", labelEn: "Input", color: "#0ea5e9" },
  { key: "output", labelZh: "Output", labelEn: "Output", color: "#10b981" },
  { key: "cacheRead", labelZh: "Cache Read", labelEn: "Cache Read", color: "#a855f7" },
  { key: "cacheWrite", labelZh: "Cache Write", labelEn: "Cache Write", color: "#f97316" },
  { key: "reasoning", labelZh: "Reasoning", labelEn: "Reasoning", color: "#f43f5e" },
];

// Cloud session device grouping (mirrors web/src/lib/devices/cloud.ts)
const CLOUD_DEVICE_PROVIDERS = {
  claude: { client: "claude", label: "Claude Code cloud" },
  codex: { client: "codex", label: "Codex cloud" },
};
const CLOUD_DEVICE_KEY_RE = /^cloud_([a-z]+)_([0-9a-f]{32})$/;

function parseCloudDeviceKey(deviceKey) {
  const m = CLOUD_DEVICE_KEY_RE.exec(String(deviceKey || ""));
  if (!m) return null;
  const provider = m[1];
  if (!Object.prototype.hasOwnProperty.call(CLOUD_DEVICE_PROVIDERS, provider)) return null;
  return { provider, hash: m[2], ...CLOUD_DEVICE_PROVIDERS[provider] };
}

function groupCloudDevices(devices) {
  const result = [];
  const groups = new Map();

  for (const device of devices) {
    const cloud = parseCloudDeviceKey(device.deviceKey);
    if (!cloud) {
      result.push(device);
      continue;
    }
    const existing = groups.get(cloud.provider);
    if (!existing) {
      const row = {
        ...device,
        id: `cloud:${cloud.provider}`,
        displayName: cloud.label,
        cloudSessions: 1,
        activeDays:
          device.cloudGroupActiveDays != null
            ? device.cloudGroupActiveDays
            : device.activeDays,
        sessions: [device],
      };
      groups.set(cloud.provider, row);
      result.push(row);
      continue;
    }
    existing.cloudSessions = (existing.cloudSessions || 1) + 1;
    existing.totalTokens += device.totalTokens;
    existing.totalCost += device.totalCost;
    existing.inputTokens += device.inputTokens;
    existing.outputTokens += device.outputTokens;
    existing.activeDays =
      device.cloudGroupActiveDays != null
        ? device.cloudGroupActiveDays
        : Math.max(existing.activeDays, device.activeDays);
    if (
      device.lastSubmittedAt &&
      (!existing.lastSubmittedAt || device.lastSubmittedAt > existing.lastSubmittedAt)
    ) {
      existing.lastSubmittedAt = device.lastSubmittedAt;
    }
    existing.sessions.push(device);
  }
  return result;
}

function clientName(id) {
  const k = String(id || "").toLowerCase();
  return CLIENT_NAMES[k] || String(id || "Unknown");
}

function clientColor(id) {
  const k = String(id || "").toLowerCase();
  return CLIENT_COLORS[k] || "#3b82f6";
}

function clientLogoURL(id) {
  const k = String(id || "").toLowerCase();
  const rel = CLIENT_LOGOS[k];
  if (!rel || !baseURL) return "";
  return `${baseURL}${rel}`;
}

function ClientIcon(id, size = 14, mono = false) {
  const url = clientLogoURL(id);
  if (url) {
    return h("Image", {
      src: url,
      width: size,
      height: size,
      ...(mono ? { grayscale: true } : {}),
      tw: `w-[${size}px] h-[${size}px] rounded-[3.5px] object-contain shrink-0`,
    });
  }
  return h("Box", {
    tw: `w-2.5 h-2.5 rounded-full shrink-0 bg-[${mono ? "#1f1d20" : clientColor(id)}]`,
  });
}

function ModelIcon(modelId, size = 13, mono = false) {
  const rule = matchModelIconRule(modelId);
  const paths = rule ? MODEL_BRAND_PATHS[rule.icon] : null;
  if (paths) {
    const rawSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">${paths}</svg>`;
    const c = mono
      ? "[#1f1d20]"
      : rule.color && rule.color !== "text"
      ? `[${rule.color}]`
      : "text";
    return h("Icon", {
      svg: rawSvg,
      tw: `text-[${size}px] size-[${size}px] text-${c} shrink-0`,
    });
  }
  const clean = String(modelId || "").replace(/^.*\//, "");
  const initial = (clean[0] || "M").toUpperCase();
  const palette = ["#ec4899", "#8b5cf6", "#0ea5e9", "#f59e0b", "#10b981"];
  const color = mono ? "#1f1d20" : palette[clean.charCodeAt(0) % palette.length] || "#ec4899";
  return h(
    "Row",
    {
      tw: `w-[${size}px] h-[${size}px] rounded-[4px] bg-[${color}] items-center justify-center shrink-0`,
    },
    TX(initial, { tw: `text-[9px] font-bold text-[${mono ? "#f7f4ed" : "#ffffff"}] leading-none` })
  );
}

// ---------------------------------------------------------------------------
// UI Copy (Unified English)
// ---------------------------------------------------------------------------

const I18N = {
  usageDetailTitle: "Usage Detail",
  periodAll: "All Time",
  periodMonth: "30 Days",
  periodWeek: "7 Days",
  todayTitle: "Today",
  todayEmpty: "No usage recorded for today yet",
  latestActive: (d, tok, cost) => `Last active ${d} · ${tok} · ${cost}`,
  messagesUnit: n => `${n} msgs`,
  totalTokens: "Total Tokens",
  periodTokens: "Period Tokens",
  totalCost: "Est. Cost",
  periodCost: "Period Cost",
  activeDays: "Active Days",
  submissions: "Submissions",
  sessionsSub: n => (n > 0 ? `${n} sessions` : "All clients"),
  dailyAvgSub: v => `Avg ${v}/active day`,
  updatedSub: (age, ver) => (age ? `Updated ${age}${ver ? " · v" + ver : ""}` : "No submissions"),
  ioSub: (i, o) => `In ${i} · Out ${o}`,
  tokenMixTitle: "Token Breakdown",
  trendTitle: "Daily Trend",
  metricTokens: "Tokens",
  metricCost: "Cost ($)",
  heatmapTitle: "Activity",
  heatmapActiveDays: n => `${n} active days`,
  selectedDayTitle: d => `${d} Breakdown`,
  clientsUsedTitle: "Active Clients",
  modelsTitle: "Models",
  sortByCost: "Cost",
  sortByTokens: "Tokens",
  noModels: "No model breakdown recorded for this period",
  devicesTitle: "Devices",
  devicesCount: n => `${n} ${n === 1 ? "device" : "devices"}`,
  noDevices: "No devices found",
  cloudSessionsCount: n => `${n} ${n === 1 ? "session" : "sessions"}`,
  cloudSessionsListTitle: "Cloud Sessions",
  lastSubmitted: age => (age ? `Last submitted ${age}` : "Never submitted"),
  daysActive: n => `${n}d active`,
  backToMain: "Back",
  deviceDetailTitle: "Device Detail",
  deviceRecentDays: "Daily Submissions",
  privateModeBadge: "Private",
  privateFallbackNotice: "Client and model details need a read token. Connect using your CLI login to create one and enable Private Mode.",
  privateFallbackManual: "Client and model details need a read token. Add one in Inputs, or run `tokens login` to connect.",
  connectPrivate: "Connect Private Account",
  connectingPrivate: "Connecting…",
  bannedNotice: r => `Account banned${r ? ": " + r : ""}`,
  setupTitle: "Connect to Tokens",
  setupDesc: "Run `tokens login` in your terminal for automatic detection, or enter any GitHub username in this dashboard's Inputs.",
  invalidUrlTitle: "Invalid Server URL",
  connErrTitle: "Couldn't load Tokens data",
  retry: "Retry",
  refresh: "Refresh",
  openProfile: "Open Profile on tokens.ci",
  openLeaderboard: "Open Leaderboard",
  trayTooltip: (u, tTok, tCost, allTok, allCost, rank) =>
    `@${u} · Today ${tTok} (${tCost}) · Total ${allTok} (${allCost})${rank ? " · #" + rank : ""}`,
};

function T() {
  return I18N;
}

function isDarkTheme() {
  try {
    return !!(globalThis.matchMedia && globalThis.matchMedia("(prefers-color-scheme: dark)").matches);
  } catch (e) {
    return true;
  }
}

function cardBorder() {
  return isDarkTheme() ? "[#ffffff12]" : "[#00000010]";
}

function Line() {
  return h("Box", { tw: `w-full h-px bg-${cardBorder()} shrink-0` });
}

// ---------------------------------------------------------------------------
// Formatting Helpers
// ---------------------------------------------------------------------------

const num = (v, d = 0) => {
  const n = Number(v);
  return Number.isFinite(n) ? n : d;
};
const str = v => (typeof v === "string" ? v.trim() : "");
const clampPct = v => Math.max(0, Math.min(100, num(v, 0)));

function comma(n) {
  const v = Math.round(num(n, 0));
  return String(v).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}

function formatTokens(n, decimals = 1) {
  const v = Math.max(0, num(n, 0));
  if (v >= 1e12) return `${(v / 1e12).toFixed(decimals).replace(/\.0+$/, "")}T`;
  if (v >= 1e9) return `${(v / 1e9).toFixed(decimals).replace(/\.0+$/, "")}B`;
  if (v >= 1e6) return `${(v / 1e6).toFixed(decimals).replace(/\.0+$/, "")}M`;
  if (v >= 1e3) return `${(v / 1e3).toFixed(decimals).replace(/\.0+$/, "")}K`;
  return String(Math.round(v));
}

function formatCost(c, compact = false) {
  const v = Math.max(0, num(c, 0));
  if (v === 0) return "$0.00";
  if (compact && v >= 1e6) return `$${(v / 1e6).toFixed(2)}M`;
  if (compact && v >= 1e3) return `$${(v / 1e3).toFixed(2)}K`;
  if (v < 0.01) return "<$0.01";
  const parts = v.toFixed(2).split(".");
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  return `$${parts.join(".")}`;
}

function formatPercent(p) {
  const v = Math.max(0, num(p, 0));
  if (v === 0) return "0%";
  if (v < 0.01) return "<0.01%";
  if (v < 1) return `${v.toFixed(2)}%`;
  return `${v.toFixed(1).replace(/\.0$/, "")}%`;
}

const MONTHS_SHORT = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
function formatPrettyDate(ymd) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(ymd || ""));
  if (!m) return String(ymd || "");
  const yr = Number(m[1]);
  const mo = Number(m[2]) - 1;
  const dy = Number(m[3]);
  return `${MONTHS_SHORT[mo] || m[2]} ${dy}, ${yr}`;
}

function formatAge(iso) {
  if (!iso) return "";
  const t = typeof iso === "number" ? iso : Date.parse(String(iso));
  if (!Number.isFinite(t)) return "";
  const sec = Math.max(0, Math.floor((Date.now() - t) / 1000));
  if (sec < 60) return "just now";
  if (sec < 3600) return `${Math.floor(sec / 60)}m ago`;
  if (sec < 86400) return `${Math.floor(sec / 3600)}h ago`;
  return `${Math.floor(sec / 86400)}d ago`;
}

function localDateKey(d = new Date()) {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
}

function shiftDateKey(dateKey, deltaDays) {
  const [y, m, d] = String(dateKey || "").split("-").map(Number);
  if (!y || !m || !d) return localDateKey();
  return new Date(Date.UTC(y, m - 1, d + deltaDays)).toISOString().slice(0, 10);
}

function triggerReceiptCapture(mode) {
  if (receiptBusy || !receiptDateKey) return;
  receiptBusy = true;
  receiptCleanShot = true;
  setTimeout(async () => {
    let blob = null;
    let errMsg = "";
    try {
      blob = await $metrix.panel.screenshot({
        width: W,
        height: Math.min(2048, Math.max(520, Math.ceil(receiptShotHeight))),
        scale: 2,
      });
    } catch (e) {
      errMsg = String((e && e.message) || e);
    } finally {
      receiptCleanShot = false;
      receiptBusy = false;
      $metrix.invalidate();
    }
    if (!blob) {
      if (errMsg) $metrix.toast(`Capture failed: ${errMsg}`);
      return;
    }
    try {
      if (mode === "copy") {
        await navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
        receiptCopied = true;
        $metrix.toast("Copied receipt image to clipboard");
        $metrix.invalidate();
        setTimeout(() => {
          receiptCopied = false;
          $metrix.invalidate();
        }, 1800);
      } else {
        const dest = await $metrix.showSaveDialog({
          defaultPath: `tokens-statement-${receiptDateKey}.png`,
        });
        if (dest) {
          await $metrix.writeFile(dest, await blob.arrayBuffer());
          $metrix.toast(`Saved to ${dest}`);
        }
      }
    } catch (e) {
      $metrix.toast(`Share failed: ${String((e && e.message) || e)}`);
    }
  }, 60);
}

function rankBadgeColor(rank) {
  if (rank === 1) return "[#E3B341]";
  if (rank === 2) return "[#A8B3C5]";
  if (rank === 3) return "[#DA7E1A]";
  return "accent";
}

// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------

let baseURL = "https://tokens.ci";
let inputUsername = "";
let credentialsPath = "~/.config/tokens/credentials.json";
let secretToken = "";
let savedReadToken = "";
let trayFormat = "today_cost";
let inputErr = "";
let connectingPrivate = false;
let privateConnectError = "";
let pendingReadToken = "";

// Resolved identity & tokens
let resolvedUsername = "";
let resolvedApiToken = ""; // tt_...
let resolvedReadToken = ""; // tkr_...

// UI navigation & preferences
let activePeriod = localStorage.getItem("tokens.period") || "all";
if (!["all", "month", "week"].includes(activePeriod)) activePeriod = "all";
let trendMetric = localStorage.getItem("tokens.trendMetric") === "cost" ? "cost" : "tokens";
let modelSort = localStorage.getItem("tokens.modelSort") === "cost" ? "cost" : "tokens";
let showAllModels = false;
let selectedDate = null; // YYYY-MM-DD in heatmap
let selectedDeviceId = null;
let receiptDateKey = null; // YYYY-MM-DD when Receipt view is open
let receiptTheme = localStorage.getItem("tokens.receiptTheme") || "sage";
let receiptCleanShot = false;
let receiptShotHeight = 680;
let receiptCopied = false;
let receiptBusy = false;
const collapsedClients = new Set();

const RECEIPT_THEMES = {
  sage: { label: "Sage", dot: "#6b8e80", from: "#567568", to: "#84a597", angle: 145 },
  terracotta: { label: "Terracotta", dot: "#a46851", from: "#8a543f", to: "#b87c64", angle: 145 },
  nordic: { label: "Nordic", dot: "#556882", from: "#415268", to: "#6c809a", angle: 145 },
  charcoal: { label: "Charcoal", dot: "#2a2c30", from: "#1d1e21", to: "#32353b", angle: 145 },
};
if (!RECEIPT_THEMES[receiptTheme]) receiptTheme = "sage";

// Cached API payloads
const profileCache = new Map(); // period -> normalized profile object
let devicesList = [];
let meStatsData = null;
let todayRank = null;
const deviceDetailCache = new Map(); // deviceId -> { loading, error, data, loadedAt }

let loading = false;
let loadedAt = 0;
let error = "";
let inflight = null;

function parseBaseURL(raw) {
  const s = str(raw || "https://tokens.ci").replace(/\/+$/, "");
  if (!s) return { url: "https://tokens.ci", err: "" };
  try {
    const u = new URL(s);
    if (u.protocol !== "https:" && u.protocol !== "http:") {
      return { url: "", err: "Tokens Server URL must use https:// or authorized local http://." };
    }
    return { url: u.origin + u.pathname.replace(/\/+$/, ""), err: "" };
  } catch (e) {
    return { url: "", err: "Invalid Tokens Server URL. Example: https://tokens.ci" };
  }
}

function readSecret(name) {
  try {
    return str($metrix.secret(name));
  } catch (e) {
    return "";
  }
}

function redact(msg) {
  let text = String(msg || "");
  for (const s of [secretToken, savedReadToken, pendingReadToken, resolvedApiToken, resolvedReadToken]) {
    if (s && s.length >= 4) text = text.split(s).join("•••");
  }
  return text.replace(/\b(?:tkr|tt)_[A-Za-z0-9_-]+/g, "•••").slice(0, 220);
}

function syncInputs(env) {
  syncInputs.env = env;
  const inputs = (env && env.inputs) || {};
  const parsed = parseBaseURL(inputs.baseURL);
  const nextUser = str(inputs.username).replace(/^@/, "");
  const nextCreds = str(inputs.credentials) || "~/.config/tokens/credentials.json";
  const nextSecret = readSecret("token");
  const nextReadToken = readSecret("readToken");
  const nextTray = str(inputs.trayFormat) || "today_cost";
  if (["today_cost", "today_rank", "total_rank", "total_cost", "today_only", "cost_only"].includes(nextTray)) {
    trayFormat = nextTray;
  }

  const sig = `${parsed.url}\n${parsed.err}\n${nextUser}\n${nextCreds}\n${nextSecret}\n${nextReadToken}`;
  if (sig === syncInputs.sig) return;
  syncInputs.sig = sig;
  baseURL = parsed.url;
  inputErr = parsed.err;
  inputUsername = nextUser;
  credentialsPath = nextCreds;
  secretToken = nextSecret;
  savedReadToken = nextReadToken;
  privateConnectError = "";
  pendingReadToken = "";

  resolvedUsername = inputUsername;
  resolvedApiToken = "";
  resolvedReadToken = "";
  profileCache.clear();
  devicesList = [];
  meStatsData = null;
  todayRank = null;
  deviceDetailCache.clear();
  selectedDeviceId = null;
  selectedDate = null;
  error = "";
  loadedAt = 0;
}

// ---------------------------------------------------------------------------
// Authentication & API Fetching
// ---------------------------------------------------------------------------

async function resolveCredentials() {
  let fileUser = "";
  let fileToken = "";
  if (credentialsPath) {
    try {
      const raw = await $metrix.readFile(credentialsPath);
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === "object") {
        fileUser = str(parsed.username);
        fileToken = str(parsed.token);
      }
    } catch (e) {}
  }

  let readTok = "";
  let apiTok = "";
  if (secretToken.startsWith("tkr_")) {
    readTok = secretToken;
  } else if (secretToken.startsWith("tt_")) {
    apiTok = secretToken;
  } else if (secretToken) {
    readTok = secretToken;
  }

  const targetUser = inputUsername || fileUser;
  if (!apiTok && fileToken.startsWith("tt_")) {
    if (!inputUsername || inputUsername.toLowerCase() === fileUser.toLowerCase()) {
      apiTok = fileToken;
    }
  }

  resolvedReadToken = savedReadToken || readTok;
  resolvedApiToken = "";
  resolvedUsername = targetUser;

  if (apiTok && baseURL) {
    try {
      const data = await fetchJSON("/api/auth/token", apiTok, { redirect: "error" });
      const owner = str(data && data.user && data.user.username);
      if (owner && (!targetUser || owner.toLowerCase() === targetUser.toLowerCase())) {
        resolvedUsername = targetUser || owner;
        resolvedApiToken = apiTok;
      }
    } catch (e) {}
  }
}

async function fetchJSON(path, token, options = {}) {
  const headers = { Accept: "application/json", ...options.headers };
  if (token) headers.Authorization = `Bearer ${token}`;
  const res = await fetch(baseURL + path, { ...options, headers });
  const text = await res.text();
  let data = null;
  try {
    data = text ? JSON.parse(text) : null;
  } catch (e) {
    data = null;
  }
  if (!res.ok) {
    const msg = (data && data.error) || `HTTP ${res.status}`;
    const err = new Error(redact(msg));
    err.status = res.status;
    throw err;
  }
  return data;
}

function connectPrivateAccount() {
  const prof = currentProfile();
  if (connectingPrivate || loading || !resolvedApiToken || !prof || !prof.privateFallback) return;
  const sig = syncInputs.sig;
  const username = resolvedUsername;
  const apiToken = resolvedApiToken;
  connectingPrivate = true;
  privateConnectError = "";
  $metrix.invalidate();
  void (async () => {
    let failure = "Couldn't verify your CLI login. Sign in with `tokens login` and retry.";
    try {
      const auth = await fetchJSON("/api/auth/token", apiToken, { redirect: "error" });
      if (str(auth && auth.user && auth.user.username).toLowerCase() !== username.toLowerCase()) {
        failure = "Your CLI login belongs to a different account. Check the dashboard's Inputs.";
        throw new Error(failure);
      }
      failure = "Account settings changed. Please retry.";
      if (sig !== syncInputs.sig) throw new Error(failure);
      if (!pendingReadToken) {
        failure = "Couldn't create a read token. Please retry or add one in Inputs.";
        const data = await fetchJSON("/api/me/private", apiToken, {
          method: "POST",
          redirect: "error",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ tokenName: "Metrix.Bar" }),
        });
        const token = data && data.readToken && data.readToken.token;
        if (!data || data.private !== true || typeof token !== "string" || !/^tkr_[0-9a-f]{48}$/.test(token)) {
          throw new Error(failure);
        }
        failure = "Account settings changed. Please retry.";
        if (sig !== syncInputs.sig) throw new Error(failure);
        pendingReadToken = token;
      }
      failure = "Couldn't save the read token. Retry to finish connecting.";
      await $metrix.setSecret("readToken", pendingReadToken);
      if (inflight) await inflight;
      syncInputs(syncInputs.env);
      profileCache.clear();
      deviceDetailCache.clear();
      await refresh();
    } catch (e) {
      privateConnectError = failure;
    } finally {
      connectingPrivate = false;
      $metrix.invalidate();
    }
  })();
}

function buildProfileFromMeStats(me, username) {
  const days = Array.isArray(me && me.days) ? me.days : [];
  const maxCost = Math.max(0, ...days.map(d => num(d.cost, 0)));
  let totalInput = 0;
  let totalOutput = 0;
  let activeDays = 0;
  const contributions = days.map(d => {
    const tok = num(d.tokens, 0);
    const cost = num(d.cost, 0);
    const inp = num(d.inputTokens, 0);
    const out = num(d.outputTokens, 0);
    totalInput += inp;
    totalOutput += out;
    if (tok > 0) activeDays++;
    const intensity =
      maxCost <= 0 || cost <= 0 ? 0 : cost <= maxCost * 0.25 ? 1 : cost <= maxCost * 0.5 ? 2 : cost <= maxCost * 0.75 ? 3 : 4;
    return {
      date: str(d.date),
      totals: { tokens: tok, cost, messages: 0 },
      intensity,
      tokenBreakdown: { input: inp, output: out, cacheRead: 0, cacheWrite: 0, reasoning: 0 },
      clients: [],
    };
  });

  return {
    privateFallback: true,
    banned: false,
    user: {
      username: username || "me",
      displayName: username || "Private Account",
      avatarUrl: null,
      isPrivate: true,
      rank: null,
      verified: false,
    },
    stats: {
      totalTokens: num(me && me.totalTokens, 0),
      totalCost: num(me && me.totalCost, 0),
      inputTokens: totalInput,
      outputTokens: totalOutput,
      cacheReadTokens: 0,
      cacheWriteTokens: 0,
      reasoningTokens: 0,
      submissionCount: days.length,
      activeDays,
      sessionCount: 0,
    },
    updatedAt: (me && me.lastSubmittedAt) || null,
    submissionFreshness: null,
    clients: [],
    models: [],
    modelUsage: [],
    contributions,
    period: "all",
  };
}

function normalizeProfile(raw, period) {
  if (!raw || typeof raw !== "object") throw new Error("Invalid profile response.");
  if (raw.banned) {
    return {
      banned: true,
      banReason: str(raw.banReason),
      user: {
        username: str(raw.user && raw.user.username),
        displayName: str(raw.user && raw.user.displayName) || null,
        avatarUrl: str(raw.user && raw.user.avatarUrl) || null,
        isPrivate: false,
        rank: null,
        verified: false,
      },
      stats: {
        totalTokens: 0,
        totalCost: 0,
        inputTokens: 0,
        outputTokens: 0,
        cacheReadTokens: 0,
        cacheWriteTokens: 0,
        reasoningTokens: 0,
        submissionCount: 0,
        activeDays: 0,
        sessionCount: 0,
      },
      updatedAt: null,
      submissionFreshness: null,
      clients: [],
      models: [],
      modelUsage: [],
      contributions: [],
      period,
    };
  }
  const u = raw.user || {};
  const st = raw.stats || {};
  return {
    privateFallback: false,
    banned: false,
    user: {
      username: str(u.username),
      displayName: str(u.displayName) || null,
      avatarUrl: str(u.avatarUrl) || null,
      isPrivate: u.isPrivate === true,
      rank: num(u.rank, 0) > 0 ? num(u.rank, 0) : null,
      verified: u.verified === true,
    },
    stats: {
      totalTokens: num(st.totalTokens, 0),
      totalCost: num(st.totalCost, 0),
      inputTokens: num(st.inputTokens, 0),
      outputTokens: num(st.outputTokens, 0),
      cacheReadTokens: num(st.cacheReadTokens, 0),
      cacheWriteTokens: num(st.cacheWriteTokens, 0),
      reasoningTokens: num(st.reasoningTokens, 0),
      submissionCount: num(st.submissionCount, 0),
      activeDays: num(st.activeDays, 0),
      sessionCount: num(st.sessionCount, 0),
    },
    updatedAt: str(raw.updatedAt) || null,
    submissionFreshness: raw.submissionFreshness || null,
    clients: Array.isArray(raw.clients) ? raw.clients : [],
    models: Array.isArray(raw.models) ? raw.models : [],
    modelUsage: Array.isArray(raw.modelUsage) ? raw.modelUsage : [],
    contributions: Array.isArray(raw.contributions) ? raw.contributions : [],
    period: str(raw.period) || period,
  };
}

async function loadPeriodData(period) {
  await resolveCredentials();
  if (!baseURL || !resolvedUsername) return;

  const query = period === "all" ? "" : `?period=${encodeURIComponent(period)}`;
  const userPath = `/api/users/${encodeURIComponent(resolvedUsername)}${query}`;
  const devicesPath = `/api/users/${encodeURIComponent(resolvedUsername)}/devices`;
  const todayKey = localDateKey();
  const todayRankPath = `/api/leaderboard?period=today&from=${encodeURIComponent(todayKey)}&search=${encodeURIComponent(resolvedUsername)}&limit=5`;

  const tasks = [
    fetchJSON(userPath, resolvedReadToken),
    fetchJSON(devicesPath, resolvedReadToken).catch(() => null),
    resolvedApiToken ? fetchJSON("/api/me/stats", resolvedApiToken).catch(() => null) : Promise.resolve(null),
    fetchJSON(todayRankPath).catch(() => null),
  ];
  if (period !== "all" && !profileCache.has("all")) {
    tasks.push(fetchJSON(`/api/users/${encodeURIComponent(resolvedUsername)}`, resolvedReadToken).catch(() => null));
  }

  const [profSettled, devSettled, meSettled, todayRankSettled, allSettled] = await Promise.allSettled(tasks);

  const meVal = meSettled && meSettled.status === "fulfilled" ? meSettled.value : null;
  if (meVal) meStatsData = meVal;

  const trVal = todayRankSettled && todayRankSettled.status === "fulfilled" ? todayRankSettled.value : null;
  if (trVal && Array.isArray(trVal.users)) {
    const matched = trVal.users.find(
      u => u && String(u.username || "").toLowerCase() === resolvedUsername.toLowerCase()
    );
    todayRank = matched && num(matched.rank, 0) > 0 ? num(matched.rank, 0) : null;
  }

  if (allSettled && allSettled.status === "fulfilled" && allSettled.value) {
    profileCache.set("all", normalizeProfile(allSettled.value, "all"));
  }

  if (profSettled.status === "fulfilled" && profSettled.value) {
    const norm = normalizeProfile(profSettled.value, period);
    profileCache.set(period, norm);
  } else {
    const reason = profSettled.reason;
    if (reason && reason.status === 404 && meStatsData) {
      const fallback = buildProfileFromMeStats(meStatsData, resolvedUsername);
      profileCache.set(period, fallback);
      profileCache.set("all", fallback);
    } else {
      throw reason || new Error("Failed to load profile");
    }
  }

  const nameById = new Map();
  if (meStatsData && Array.isArray(meStatsData.devices)) {
    for (const d of meStatsData.devices) {
      if (d && d.id && str(d.displayName)) nameById.set(String(d.id), str(d.displayName));
    }
  }

  const devVal = devSettled && devSettled.status === "fulfilled" ? devSettled.value : null;
  if (devVal && Array.isArray(devVal.devices)) {
    const rawDevices = devVal.devices.map(d => ({
      id: str(d.id),
      deviceKey: str(d.deviceKey),
      displayName: nameById.get(str(d.id)) || str(d.displayName) || "Device",
      lastSubmittedAt: str(d.lastSubmittedAt) || null,
      totalTokens: num(d.totalTokens, 0),
      totalCost: num(d.totalCost, 0),
      inputTokens: num(d.inputTokens, 0),
      outputTokens: num(d.outputTokens, 0),
      activeDays: num(d.activeDays, 0),
      cloudGroupActiveDays:
        d.cloudGroupActiveDays != null ? num(d.cloudGroupActiveDays, 0) : null,
      firstDay: str(d.firstDay) || null,
      lastDay: str(d.lastDay) || null,
    }));
    devicesList = groupCloudDevices(rawDevices);
  } else if (meStatsData && Array.isArray(meStatsData.devices)) {
    devicesList = meStatsData.devices.map(d => ({
      id: str(d.id),
      deviceKey: "",
      displayName: str(d.displayName) || "Device",
      lastSubmittedAt: str(d.lastSubmittedAt) || null,
      totalTokens: 0,
      totalCost: 0,
      inputTokens: 0,
      outputTokens: 0,
      activeDays: 0,
      firstDay: null,
      lastDay: null,
    }));
  }
}

async function loadDeviceDetail(deviceId) {
  if (!baseURL || !resolvedUsername || !deviceId || String(deviceId).startsWith("cloud:")) return;
  const prev = deviceDetailCache.get(deviceId) || { data: null, loadedAt: 0 };
  deviceDetailCache.set(deviceId, { ...prev, loading: true, error: "" });
  $metrix.invalidate();

  try {
    const data = await fetchJSON(
      `/api/users/${encodeURIComponent(resolvedUsername)}/devices/${encodeURIComponent(deviceId)}`,
      resolvedReadToken
    );
    if (meStatsData && Array.isArray(meStatsData.devices) && data && data.device) {
      const found = meStatsData.devices.find(d => d && String(d.id) === String(deviceId));
      if (found && str(found.displayName)) data.device.displayName = str(found.displayName);
    }
    deviceDetailCache.set(deviceId, { data, loading: false, error: "", loadedAt: Date.now() });
  } catch (e) {
    deviceDetailCache.set(deviceId, {
      ...prev,
      loading: false,
      error: redact((e && e.message) || e),
    });
  }
  $metrix.invalidate();
}

function refresh() {
  if (inputErr || !baseURL) return Promise.resolve();
  if (inflight) return inflight;
  loading = true;
  $metrix.invalidate();
  inflight = loadPeriodData(activePeriod)
    .then(() => {
      error = "";
      loadedAt = Date.now();
      if (selectedDeviceId) {
        return loadDeviceDetail(selectedDeviceId);
      }
    })
    .catch(e => {
      error = redact((e && e.message) || e);
    })
    .finally(() => {
      inflight = null;
      loading = false;
      $metrix.invalidate();
    });
  return inflight;
}

const launchRefresh = () => {
  void refresh();
};

function switchPeriod(nextPeriod) {
  if (!["all", "month", "week"].includes(nextPeriod) || nextPeriod === activePeriod) return;
  activePeriod = nextPeriod;
  selectedDate = null;
  localStorage.setItem("tokens.period", activePeriod);
  $metrix.invalidate();
  if (!profileCache.has(activePeriod)) {
    launchRefresh();
  }
}

function selectDevice(deviceId) {
  selectedDeviceId = deviceId;
  if (String(deviceId).startsWith("cloud:")) {
    $metrix.invalidate();
    return;
  }
  const cached = deviceDetailCache.get(deviceId);
  $metrix.invalidate();
  if (!cached || Date.now() - cached.loadedAt > 60e3) {
    void loadDeviceDetail(deviceId);
  }
}

// ---------------------------------------------------------------------------
// Derived Helpers (Today, All-Time & Contribution Day Details)
// ---------------------------------------------------------------------------

function currentProfile() {
  return profileCache.get(activePeriod) || profileCache.get("all") || null;
}

function allTimeProfile() {
  return profileCache.get("all") || currentProfile();
}

function findTodayAndLatest(prof) {
  const baseProf = allTimeProfile() || prof;
  const list = (baseProf && baseProf.contributions) || [];
  const todayKey = localDateKey();
  const utcTodayKey = new Date().toISOString().slice(0, 10);
  let todayDay = list.find(d => d.date === todayKey) || list.find(d => d.date === utcTodayKey) || null;
  let latestDay = null;
  for (let i = list.length - 1; i >= 0; i--) {
    if (num(list[i].totals && list[i].totals.tokens, 0) > 0) {
      latestDay = list[i];
      break;
    }
  }
  return { todayKey, todayDay, latestDay };
}

function extractDayClients(day) {
  if (!day || !Array.isArray(day.clients)) return [];
  const out = [];
  for (const c of day.clients) {
    const tokObj = c.tokens || {};
    const totalTokens =
      num(tokObj.input, 0) +
      num(tokObj.output, 0) +
      num(tokObj.cacheRead, 0) +
      num(tokObj.cacheWrite, 0) +
      num(tokObj.reasoning, 0);
    const models = [];
    if (c.models && typeof c.models === "object") {
      for (const [mId, mData] of Object.entries(c.models)) {
        if (!mId || mId === "<synthetic>") continue;
        const mInput = num(mData && mData.input, 0);
        const mOutput = num(mData && mData.output, 0);
        const mCacheRead = num(mData && mData.cacheRead, 0);
        const mCacheWrite = num(mData && mData.cacheWrite, 0);
        const mReasoning = num(mData && mData.reasoning, 0);
        const mTok = Math.max(
          num(mData && mData.tokens, 0),
          mInput + mOutput + mCacheRead + mCacheWrite + mReasoning
        );
        models.push({
          modelId: mId,
          tokens: mTok,
          cost: num(mData && mData.cost, 0),
          input: mInput,
          output: mOutput,
          cacheRead: mCacheRead,
          cacheWrite: mCacheWrite,
          reasoning: mReasoning,
          messages: num(mData && mData.messages, 0),
          speedUsage: Array.isArray(mData && mData.speedUsage) ? mData.speedUsage : [],
        });
      }
    }
    models.sort((a, b) => b.cost - a.cost || b.tokens - a.tokens);
    out.push({
      client: str(c.client),
      totalTokens,
      cost: num(c.cost, 0),
      messages: num(c.messages, 0),
      models,
    });
  }
  out.sort((a, b) => b.cost - a.cost || b.totalTokens - a.totalTokens);
  return out;
}

function buildModelBreakdownLine(m) {
  const parts = [`${formatTokens(m.tokens, 1)} tokens`];
  if (m.input > 0) parts.push(`Input ${formatTokens(m.input, 1)}`);
  if (m.output > 0) parts.push(`Output ${formatTokens(m.output, 1)}`);
  if (m.cacheRead > 0) parts.push(`Cache read ${formatTokens(m.cacheRead, 1)}`);
  if (m.cacheWrite > 0) parts.push(`Cache write ${formatTokens(m.cacheWrite, 1)}`);
  if (m.reasoning > 0) parts.push(`Reasoning ${formatTokens(m.reasoning, 1)}`);
  if (m.messages > 0) parts.push(`${comma(m.messages)} messages`);
  return parts.join(" · ");
}

function renderSpeedTierPills(speedUsage, totalTokens, keyPrefix) {
  if (!Array.isArray(speedUsage) || !speedUsage.length || totalTokens <= 0) return null;
  const valid = speedUsage
    .filter(s => s && num(s.tokens, 0) > 0 && (s.speed === "fast" || s.speed === "standard"))
    .slice()
    .sort((a, b) => num(b.tokens, 0) - num(a.tokens, 0));
  if (!valid.length) return null;
  return h(
    "Row",
    { tw: "flex-wrap gap-1.5 items-center pl-5 pt-0.5 w-full" },
    valid.map((s, idx) => {
      const isFast = s.speed === "fast";
      const pct = Math.max(1, Math.min(100, Math.round((num(s.tokens, 0) / totalTokens) * 100)));
      return h(
        "Row",
        {
          key: `${keyPrefix}-sp-${s.speed}-${idx}`,
          tw: `items-center gap-1 py-0.5 px-2 rounded-full shrink-0 ${
            isFast ? "bg-[#f59e0b1f]" : "bg-surfaceHover"
          }`,
        },
        Icon(isFast ? "zap" : "clock", 10, isFast ? "[#f59e0b]" : K.muted),
        TX(`${isFast ? "Fast" : "Standard"} ${pct}%`, {
          tw: `text-[10px] font-semibold tabular-nums ${isFast ? "text-[#f59e0b]" : "text-textMuted"}`,
        })
      );
    })
  );
}

function renderDayTokenCategories(day, keyPrefix) {
  const tb = (day && day.tokenBreakdown) || {};
  const rows = [
    { ...MIX_DEFS[0], value: Math.max(0, num(tb.input, 0)) },
    { ...MIX_DEFS[1], value: Math.max(0, num(tb.output, 0)) },
    { ...MIX_DEFS[2], value: Math.max(0, num(tb.cacheRead, 0)) },
    { ...MIX_DEFS[3], value: Math.max(0, num(tb.cacheWrite, 0)) },
    { ...MIX_DEFS[4], value: Math.max(0, num(tb.reasoning, 0)) },
  ];
  const sum = rows.reduce((acc, r) => acc + r.value, 0);
  if (sum <= 0) return null;
  const nonZero = rows.filter(r => r.value > 0);

  return h(
    "Column",
    { tw: "gap-2 pt-1 w-full min-w-0" },
    Line(),
    TX("TOKEN BREAKDOWN", {
      tw: "text-[10px] font-bold text-textMuted tracking-[0.6px] pt-0.5",
    }),
    // Proportional bar
    h(
      "Row",
      { tw: "gap-[2px] h-2 rounded-full overflow-hidden w-full bg-border" },
      nonZero.map(r =>
        h("Box", {
          key: `${keyPrefix}-bar-${r.key}`,
          tw: `h-2 rounded-full bg-[${r.color}]`,
          grow: Math.max((r.value / sum) * 100, 1.5),
          basis: 0,
          tooltip: `${r.labelEn}: ${formatTokens(r.value, 1)} (${formatPercent((r.value / sum) * 100)})`,
        })
      )
    ),
    // 5-row vertical breakdown
    h(
      "Column",
      { tw: "gap-1.5 w-full min-w-0" },
      rows.map(r => {
        const share = sum > 0 ? (r.value / sum) * 100 : 0;
        return h(
          "Row",
          { key: `${keyPrefix}-cat-${r.key}`, tw: "items-center gap-2 w-full min-w-0" },
          h("Box", { tw: `w-2 h-2 rounded-full shrink-0 bg-[${r.color}]` }),
          TX(r.labelEn, { tw: "text-xs text-text truncate min-w-0 shrink grow" }),
          TX(formatTokens(r.value, 1), {
            tw: "text-xs font-bold tabular-nums shrink-0",
          }),
          TX(formatPercent(share), {
            tw: "text-[11px] text-textMuted tabular-nums w-12 text-end shrink-0",
          })
        );
      })
    )
  );
}

function renderDayClientsAndModels(clients, keyPrefix) {
  if (!Array.isArray(clients) || !clients.length) return null;
  return h(
    "Column",
    { tw: "gap-2.5 pt-1 w-full min-w-0" },
    Line(),
    TX("CLIENTS & MODELS", {
      tw: "text-[10px] font-bold text-textMuted tracking-[0.6px] pt-0.5",
    }),
    ...clients.map(c => {
      const collapseKey = `${keyPrefix}:${c.client}`;
      const isCollapsed = collapsedClients.has(collapseKey);
      return h(
        "Column",
        { key: `${keyPrefix}-c-${c.client}`, tw: "gap-2 w-full min-w-0" },
        // Client Header Row
        h(
          "Row",
          {
            tw: "items-center gap-2 py-0.5 cursor-pointer w-full min-w-0",
            onClick: () => {
              if (collapsedClients.has(collapseKey)) collapsedClients.delete(collapseKey);
              else collapsedClients.add(collapseKey);
              $metrix.invalidate();
            },
          },
          ClientIcon(c.client, 18),
          TX(clientName(c.client), { tw: "text-[13px] font-bold truncate min-w-0 shrink grow" }),
          TX(`${formatTokens(c.totalTokens, 1)} · ${formatCost(c.cost, false)}`, {
            tw: "text-xs text-textMuted tabular-nums shrink-0",
          }),
          Icon(isCollapsed ? "chevRight" : "chevDown", 13, K.muted)
        ),
        // Nested Models
        !isCollapsed && c.models.length > 0
          ? h(
              "Column",
              { tw: "gap-2.5 pl-4 w-full min-w-0" },
              ...c.models.map(m =>
                h(
                  "Column",
                  { key: `${keyPrefix}-m-${c.client}-${m.modelId}`, tw: "gap-1 w-full min-w-0" },
                  // Row 1: Model Icon + Model Name + Cost
                  h(
                    "Row",
                    { tw: "items-center gap-1.5 w-full min-w-0" },
                    ModelIcon(m.modelId, 13),
                    TX(m.modelId, {
                      tw: "text-xs font-mono font-bold truncate min-w-0 shrink grow",
                      tooltip: m.modelId,
                    }),
                    TX(formatCost(m.cost, false), {
                      tw: "text-xs font-bold tabular-nums shrink-0",
                    })
                  ),
                  // Row 2: Detailed token & message breakdown string
                  h(
                    "Row",
                    { tw: "pl-5 w-full min-w-0" },
                    TX(buildModelBreakdownLine(m), {
                      tw: "text-[11px] text-textMuted leading-[1.35] whitespace-normal tabular-nums min-w-0 shrink grow",
                    })
                  ),
                  // Row 3: Speed tier pills (Fast / Standard)
                  renderSpeedTierPills(m.speedUsage, m.tokens, `${keyPrefix}-${c.client}-${m.modelId}`)
                )
              )
            )
          : null
      );
    })
  );
}

function dayMessageCount(day, clients) {
  const sum = clients.reduce((acc, c) => acc + num(c.messages, 0), 0);
  return sum > 0 ? sum : num(day && day.totals && day.totals.messages, 0);
}

// ---------------------------------------------------------------------------
// Reusable UI Building Blocks
// ---------------------------------------------------------------------------

const bone = (w, hgt, extra) =>
  h("Box", {
    ...extra,
    tw: `w-[${w}px] h-[${hgt}px] rounded bg-surfaceHover shrink-0 ${(extra && extra.tw) || ""}`,
  });

function IconButton(name, label, onClick, busy, key) {
  return h(
    "Column",
    {
      key,
      tw: "w-7 h-7 items-center justify-center rounded-[7px] shrink-0 cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed",
      label,
      tooltip: label,
      onClick,
    },
    Icon(
      name,
      15,
      K.muted,
      busy
        ? {
            keyframes: {
              duration: 900,
              repeat: -1,
              ease: "linear",
              frames: [
                { at: 0, rotate: 0 },
                { at: 1, rotate: 360 },
              ],
            },
          }
        : null
    )
  );
}

function CompactToggle(items, value, onChange, keyPrefix) {
  return h(
    "Row",
    { tw: "p-[2px] rounded-[6px] bg-surfaceHover items-center gap-[2px] shrink-0" },
    items.map(it => {
      const active = it.value === value;
      return h(
        "Row",
        {
          key: `${keyPrefix}-${it.value}`,
          tw: `py-[2px] px-2 rounded-[4px] cursor-pointer items-center ${
            active ? "bg-background shadow-sm" : ""
          }`,
          onClick: () => {
            if (!active) onChange(it.value);
          },
        },
        TX(it.label, {
          tw: `text-[10.5px] leading-tight ${
            active ? "font-semibold text-text" : "font-medium text-textMuted"
          }`,
        })
      );
    })
  );
}

function profileURL() {
  const b = baseURL || "https://tokens.ci";
  return resolvedUsername ? `${b}/u/${encodeURIComponent(resolvedUsername)}` : b;
}

function Header() {
  const t = T();
  const prof = currentProfile();
  const allProf = allTimeProfile();
  const rank = (allProf && allProf.user && allProf.user.rank) || (prof && prof.user && prof.user.rank) || null;
  const verified = !!(prof && prof.user && prof.user.verified);
  const isPrivate = !!(prof && prof.user && prof.user.isPrivate);
  const avatarUrl =
    prof && prof.user && prof.user.avatarUrl && prof.user.avatarUrl.startsWith("https://avatars.githubusercontent.com/")
      ? prof.user.avatarUrl
      : "";

  if (receiptDateKey) {
    if (receiptCleanShot) return null;
    const todayKey = localDateKey();
    const canNext = receiptDateKey < todayKey;
    const themeKeys = Object.keys(RECEIPT_THEMES);
    const curTheme = RECEIPT_THEMES[receiptTheme] || RECEIPT_THEMES.sage;
    const cycleTheme = () => {
      const idx = themeKeys.indexOf(receiptTheme);
      receiptTheme = themeKeys[(idx + 1) % themeKeys.length];
      localStorage.setItem("tokens.receiptTheme", receiptTheme);
      $metrix.invalidate();
    };
    return h(
      "Column",
      { tw: "w-full shrink-0" },
      h(
        "Row",
        { tw: "gap-1.5 pt-3 pr-3 pb-2.5 pl-3.5 items-center w-full min-w-0" },
        IconButton(
          "back",
          t.backToMain,
          () => {
            receiptDateKey = null;
            $metrix.invalidate();
          },
          false,
          "btn-rcpt-back"
        ),
        Icon("receipt", 15, `[${curTheme.dot}]`),
        TX("Statement", { tw: "text-sm font-bold shrink-0" }),
        h("Spacer"),
        // Clean borderless date switcher
        h(
          "Row",
          { tw: "items-center gap-0.5 shrink-0" },
          h(
            "Column",
            {
              tw: "w-6 h-6 items-center justify-center rounded-[6px] cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed",
              tooltip: "Previous day",
              onClick: () => {
                receiptDateKey = shiftDateKey(receiptDateKey, -1);
                $metrix.invalidate();
              },
            },
            Icon("chevLeft", 13, K.muted)
          ),
          TX(formatPrettyDate(receiptDateKey), {
            tw: "text-xs font-medium text-textMuted px-0.5 tabular-nums",
          }),
          h(
            "Column",
            {
              tw: `w-6 h-6 items-center justify-center rounded-[6px] ${
                canNext ? "cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed" : "opacity-30"
              }`,
              tooltip: "Next day",
              onClick: () => {
                if (canNext) {
                  receiptDateKey = shiftDateKey(receiptDateKey, 1);
                  $metrix.invalidate();
                }
              },
            },
            Icon("chevRight", 13, K.muted)
          )
        ),
        // 3 Unified 28x28 Icon Buttons: Backdrop Theme, Copy, Save
        h(
          "Column",
          {
            key: "btn-rcpt-theme",
            tw: "w-7 h-7 items-center justify-center rounded-[7px] shrink-0 cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed",
            tooltip: `Backdrop: ${curTheme.label} (click to switch)`,
            onClick: cycleTheme,
            popoverMenu: themeKeys.map(k => ({
              label: RECEIPT_THEMES[k].label,
              checked: receiptTheme === k,
              radio: true,
              onClick: () => {
                receiptTheme = k;
                localStorage.setItem("tokens.receiptTheme", k);
                $metrix.invalidate();
              },
            })),
          },
          Icon("palette", 15, `[${curTheme.dot}]`)
        ),
        h(
          "Column",
          {
            key: "btn-rcpt-copy",
            tw: "w-7 h-7 items-center justify-center rounded-[7px] shrink-0 cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed",
            tooltip: receiptCopied ? "Copied!" : "Copy image to clipboard",
            onClick: () => triggerReceiptCapture("copy"),
          },
          Icon(receiptCopied ? "check" : "copy", 15, receiptCopied ? "[#10b981]" : K.muted)
        ),
        IconButton(
          "download",
          "Save PNG image",
          () => triggerReceiptCapture("save"),
          false,
          "btn-rcpt-save"
        )
      ),
      Line()
    );
  }

  if (selectedDeviceId) {
    const dev = devicesList.find(d => d.id === selectedDeviceId);
    const title = (dev && dev.displayName) || t.deviceDetailTitle;
    const isCloudGroup = String(selectedDeviceId).startsWith("cloud:");
    return h(
      "Column",
      { tw: "w-full shrink-0" },
      h(
        "Row",
        { tw: "gap-2 pt-3 pr-3 pb-2.5 pl-3.5 items-center w-full min-w-0" },
        IconButton(
          "back",
          t.backToMain,
          () => {
            selectedDeviceId = null;
            $metrix.invalidate();
          },
          false,
          "btn-back"
        ),
        Icon("laptop", 15, "accent"),
        TX(title, { tw: "text-sm font-bold truncate min-w-0 shrink" }),
        dev && dev.activeDays > 0
          ? h("Badge", {
              text: t.daysActive(dev.activeDays),
              textColor: K.muted,
              background: K.hover,
            })
          : null,
        h("Spacer"),
        IconButton(
          "refresh",
          t.refresh,
          () => (isCloudGroup ? launchRefresh() : loadDeviceDetail(selectedDeviceId)),
          loading,
          "btn-refresh-dev"
        ),
        IconButton("external", t.openProfile, () => $metrix.openURL(profileURL()), false, "btn-open")
      ),
      Line()
    );
  }

  return h(
    "Column",
    { tw: "w-full shrink-0" },
    h(
      "Row",
      { tw: "gap-2 pt-3 pr-3 pb-2.5 pl-4 items-center w-full min-w-0" },
      Icon("brand", 18, "accent"),
      resolvedUsername
        ? h("Avatar", {
            name: resolvedUsername,
            ...(avatarUrl ? { src: avatarUrl } : {}),
            width: 20,
            height: 20,
          })
        : null,
      TX(resolvedUsername ? `@${resolvedUsername}` : "Tokens", {
        tw: "text-sm font-bold truncate min-w-0 shrink",
      }),
      verified
        ? h(
            "Row",
            {
              tw: "w-4 h-4 rounded-full bg-[#2F8FFF22] items-center justify-center shrink-0",
              tooltip: "Verified profile",
            },
            Icon("check", 10, "[#2F8FFF]")
          )
        : null,
      rank
        ? h("Badge", {
            text: `#${comma(rank)}`,
            textColor: rankBadgeColor(rank),
            background: K.hover,
          })
        : null,
      isPrivate
        ? h("Badge", {
            text: t.privateModeBadge,
            textColor: K.warn,
            background: K.hover,
          })
        : null,
      h("Spacer"),
      resolvedUsername
        ? IconButton(
            "receipt",
            "Daily AI Statement",
            () => {
              receiptDateKey = selectedDate || localDateKey();
              $metrix.invalidate();
            },
            false,
            "btn-receipt"
          )
        : null,
      resolvedUsername ? IconButton("refresh", t.refresh, launchRefresh, loading, "btn-refresh") : null,
      IconButton("external", t.openProfile, () => $metrix.openURL(profileURL()), false, "btn-open")
    ),
    Line()
  );
}

function PeriodHeaderBar() {
  const t = T();
  return h(
    "Row",
    { tw: "gap-2 pt-1 items-center w-full min-w-0" },
    TX(t.usageDetailTitle, { tw: "text-xs font-bold text-textMuted shrink-0" }),
    h("Spacer"),
    CompactToggle(
      [
        { label: t.periodAll, value: "all" },
        { label: t.periodMonth, value: "month" },
        { label: t.periodWeek, value: "week" },
      ],
      activePeriod,
      v => switchPeriod(String(v || "all")),
      "seg-period"
    )
  );
}

function Banner() {
  const t = T();
  const prof = currentProfile();
  if (!error && !(prof && prof.privateFallback)) return null;
  return h(
    "Column",
    { tw: "gap-2 w-full min-w-0" },
    error
      ? h(
          "Row",
          { tw: "gap-2 py-2 px-2.5 rounded-lg bg-surfaceHover items-center w-full min-w-0" },
          Icon("alert", 14, K.down),
          TX(error, { tw: "text-xs min-w-0 shrink grow leading-[1.3]" }),
          h(
            "Row",
            {
              tw: "py-0.75 px-2 rounded-[5px] cursor-pointer shrink-0 hover:bg-surfacePressed",
              label: t.retry,
              onClick: launchRefresh,
            },
            TX(t.retry, { tw: "text-xs font-medium" })
          )
        )
      : null,
    prof && prof.privateFallback
      ? h(
          "Column",
          { tw: "gap-2 py-2 px-2.5 rounded-lg bg-surfaceHover w-full min-w-0" },
          h(
            "Row",
            { tw: "gap-2 items-center w-full min-w-0" },
            Icon("lock", 13, K.warn),
            TX(resolvedApiToken ? t.privateFallbackNotice : t.privateFallbackManual, {
              tw: "text-[11px] text-textMuted min-w-0 shrink grow leading-[1.35]",
            })
          ),
          resolvedApiToken
            ? h("Button", {
                key: "connect-private-account",
                label: t.connectPrivate,
                disabled: connectingPrivate || loading,
                onClick: connectPrivateAccount,
                tw: "self-start text-[11px]",
              }, connectingPrivate ? t.connectingPrivate : t.connectPrivate)
            : null,
          privateConnectError
            ? TX(privateConnectError, { tw: "text-[11px] text-danger leading-[1.35]" })
            : null
        )
      : null
  );
}

// ---------------------------------------------------------------------------
// Tab 1: Overview Components
// ---------------------------------------------------------------------------

function TodayHeroCard(prof) {
  const t = T();
  const { todayKey, todayDay, latestDay } = findTodayAndLatest(prof);
  const tok = num(todayDay && todayDay.totals && todayDay.totals.tokens, 0);
  const cost = num(todayDay && todayDay.totals && todayDay.totals.cost, 0);
  const clients = extractDayClients(todayDay);
  const msgs = dayMessageCount(todayDay, clients);

  return h(
    "Column",
    {
      tw: "gap-3 py-1 px-0.5 w-full min-w-0",
    },
    // 1. Top Header: Sun Icon + Today + Formatted Date
    h(
      "Row",
      { tw: "items-center gap-2 w-full min-w-0" },
      Icon("sun", 15, "[#10b981]"),
      TX("Today", { tw: "text-[13px] font-bold text-[#10b981] shrink-0" }),
      h("Spacer"),
      TX(formatPrettyDate(todayKey), { tw: "text-xs text-textMuted tabular-nums shrink-0" })
    ),
    // 2. Hero Figure (187.4M tokens) + Today Rank Badge (🏆 #61 today)
    h(
      "Row",
      { tw: "items-center justify-between gap-2 w-full min-w-0" },
      h(
        "Row",
        { tw: "items-end gap-1.5 min-w-0 shrink", tooltip: `${comma(tok)} tokens` },
        TX(formatTokens(tok, 1), {
          tw: "text-3xl font-bold tabular-nums leading-none tracking-[-0.5px]",
          contentTransition: { numeric: true },
        }),
        TX("tokens", { tw: "text-sm text-textMuted pb-0.5 shrink-0" })
      ),
      todayRank
        ? h(
            "Row",
            {
              tw: "items-center gap-1 py-1 px-2.5 rounded-full bg-[#10b9811a] shrink-0",
              tooltip: `Rank #${todayRank} on today's leaderboard`,
            },
            Icon("trophy", 12, "[#10b981]"),
            TX(`#${comma(todayRank)}`, { tw: "text-xs font-bold text-[#10b981] tabular-nums" }),
            TX("today", { tw: "text-[11px] text-[#10b981]" })
          )
        : null
    ),
    // 3. Sub-metrics: Cost & Messages
    h(
      "Grid",
      { tw: "grid-cols-2 gap-3 w-full min-w-0 pt-0.5" },
      h(
        "Column",
        { tw: "gap-0.5 min-w-0" },
        TX(formatCost(cost, false), { tw: "text-[13px] font-bold tabular-nums truncate" }),
        TX("Cost", { tw: "text-[10.5px] text-textMuted" })
      ),
      h(
        "Column",
        { tw: "gap-0.5 min-w-0" },
        TX(comma(msgs), { tw: "text-[13px] font-bold tabular-nums truncate" }),
        TX("Messages", { tw: "text-[10.5px] text-textMuted" })
      )
    ),
    // 4. TOKEN CATEGORIES
    todayDay ? renderDayTokenCategories(todayDay, "today") : null,
    // 5. CLIENTS & MODELS
    clients.length > 0 ? renderDayClientsAndModels(clients, "today") : null,
    // Fallback when today is 0
    tok === 0
      ? h(
          "Row",
          { tw: "items-center justify-between pt-0.5 w-full min-w-0" },
          TX(
            latestDay
              ? t.latestActive(
                  latestDay.date,
                  formatTokens(latestDay.totals && latestDay.totals.tokens, 1),
                  formatCost(latestDay.totals && latestDay.totals.cost, false)
                )
              : t.todayEmpty,
            { tw: "text-[11px] text-textMuted truncate" }
          )
        )
      : null
  );
}

function SummaryGrid(prof) {
  const t = T();
  const st = prof.stats;
  const isAll = activePeriod === "all";
  const avgCost = st.activeDays > 0 ? st.totalCost / st.activeDays : 0;
  const cliVer = prof.submissionFreshness && str(prof.submissionFreshness.cliVersion);
  const updAge = formatAge(prof.updatedAt);

  const card = (iconName, iconColor, tintHex, label, value, sub, tip) =>
    h(
      "Column",
      {
        tw: `justify-between gap-1.5 py-2.5 px-3 rounded-xl border border-${cardBorder()} bg-background min-w-0`,
        linearGradient: { from: `${tintHex}12`, to: "background", angle: 135 },
        ...(tip ? { tooltip: tip } : {}),
      },
      h(
        "Row",
        { tw: "items-center w-full min-w-0" },
        TX(label, { tw: "text-[11px] font-medium text-textMuted truncate min-w-0 shrink grow" }),
        Icon(iconName, 12, iconColor)
      ),
      TX(value, {
        tw: "text-lg font-bold tabular-nums leading-tight truncate",
        contentTransition: { numeric: true },
      }),
      TX(sub, { tw: "text-[10px] text-textMuted tabular-nums truncate w-full" })
    );

  return h(
    "Grid",
    { tw: "grid-cols-2 gap-2 w-full min-w-0" },
    card(
      "layers",
      "[#3b82f6]",
      "#3b82f6",
      isAll ? t.totalTokens : t.periodTokens,
      formatTokens(st.totalTokens, 2),
      t.ioSub(formatTokens(st.inputTokens, 1), formatTokens(st.outputTokens, 1)),
      `${comma(st.totalTokens)} tokens`
    ),
    card(
      "coins",
      "[#10b981]",
      "#10b981",
      isAll ? t.totalCost : t.periodCost,
      formatCost(st.totalCost, false),
      t.dailyAvgSub(formatCost(avgCost, false)),
      formatCost(st.totalCost, false)
    ),
    card(
      "calendar",
      "[#8b5cf6]",
      "#8b5cf6",
      t.activeDays,
      comma(st.activeDays),
      t.sessionsSub(st.sessionCount),
      `${st.activeDays} active days`
    ),
    card(
      "upload",
      "[#f59e0b]",
      "#f59e0b",
      t.submissions,
      comma(st.submissionCount),
      t.updatedSub(updAge, cliVer),
      prof.updatedAt ? `Updated ${prof.updatedAt}` : ""
    )
  );
}

function TokenMixCard(prof) {
  const t = T();
  const st = prof.stats;
  const rows = [
    { ...MIX_DEFS[0], value: Math.max(0, st.inputTokens) },
    { ...MIX_DEFS[1], value: Math.max(0, st.outputTokens) },
    { ...MIX_DEFS[2], value: Math.max(0, st.cacheReadTokens) },
    { ...MIX_DEFS[3], value: Math.max(0, st.cacheWriteTokens) },
    { ...MIX_DEFS[4], value: Math.max(0, st.reasoningTokens) },
  ];

  const sum = rows.reduce((acc, r) => acc + r.value, 0);
  if (sum <= 0) return null;
  const nonZero = rows.filter(r => r.value > 0);

  return h(
    "Column",
    { tw: `gap-2.5 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      Icon("pie", 13, K.muted),
      TX(t.tokenMixTitle, { tw: "text-xs font-bold text-textMuted" }),
      h("Spacer"),
      TX(formatTokens(sum, 2), { tw: "text-[11px] font-mono text-textMuted tabular-nums" })
    ),
    // Proportional Bar
    h(
      "Row",
      { tw: "gap-[2px] h-2 rounded-full overflow-hidden w-full bg-border" },
      nonZero.map(r =>
        h("Box", {
          key: `mix-bar-${r.key}`,
          tw: `h-2 rounded-full bg-[${r.color}]`,
          grow: Math.max((r.value / sum) * 100, 1.5),
          basis: 0,
          tooltip: `${r.labelEn}: ${formatTokens(r.value, 2)} (${formatPercent((r.value / sum) * 100)})`,
        })
      )
    ),
    // 5-row vertical breakdown
    h(
      "Column",
      { tw: "gap-1.5 w-full min-w-0" },
      rows.map(r => {
        const share = sum > 0 ? (r.value / sum) * 100 : 0;
        return h(
          "Row",
          { key: `mix-leg-${r.key}`, tw: "items-center gap-2 w-full min-w-0" },
          h("Box", { tw: `w-2 h-2 rounded-full shrink-0 bg-[${r.color}]` }),
          TX(r.labelEn, { tw: "text-xs text-text truncate min-w-0 shrink grow" }),
          TX(formatTokens(r.value, 1), { tw: "text-xs font-bold tabular-nums shrink-0" }),
          TX(formatPercent(share), { tw: "text-[11px] text-textMuted tabular-nums w-12 text-end shrink-0" })
        );
      })
    )
  );
}

function DailyTrendCard(prof) {
  const t = T();
  const allDays = Array.isArray(prof.contributions) ? prof.contributions : [];
  if (allDays.length < 2) return null;

  const limit = activePeriod === "week" ? 7 : 30;
  const sliced = allDays.slice(-limit);
  const isCost = trendMetric === "cost";
  const color = isCost ? "#10b981" : "#2F8FFF";

  const points = [];
  for (const d of sliced) {
    const ts = Date.parse(`${d.date}T00:00:00Z`);
    if (!Number.isFinite(ts)) continue;
    const tok = num(d.totals && d.totals.tokens, 0);
    const cost = num(d.totals && d.totals.cost, 0);
    const yVal = isCost ? Number(cost.toFixed(2)) : Number((tok / 1e6).toFixed(2));
    points.push({
      x: ts,
      y: yVal,
      label: d.date,
      valueLabel: isCost
        ? `${formatCost(cost, false)} (${formatTokens(tok, 1)})`
        : `${formatTokens(tok, 2)} (${formatCost(cost, false)})`,
    });
  }
  points.sort((a, b) => a.x - b.x);
  if (points.length < 2) return null;

  return h(
    "Column",
    { tw: `gap-2 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      Icon("chart", 13, K.muted),
      TX(t.trendTitle, { tw: "text-xs font-bold text-textMuted shrink-0" }),
      h("Spacer"),
      CompactToggle(
        [
          { label: t.metricTokens, value: "tokens" },
          { label: t.metricCost, value: "cost" },
        ],
        trendMetric,
        v => {
          trendMetric = v === "cost" ? "cost" : "tokens";
          localStorage.setItem("tokens.trendMetric", trendMetric);
          $metrix.invalidate();
        },
        "seg-trend"
      )
    ),
    h("Chart", {
      key: `trend-chart-${activePeriod}-${trendMetric}`,
      type: "area",
      curve: "monotone",
      xKind: "time",
      height: 120,
      hover: true,
      tw: "w-full",
      series: [
        {
          name: isCost ? "Cost (USD)" : "Tokens (M)",
          color,
          fill: { from: 0.28, to: 0.02 },
          points,
        },
      ],
    })
  );
}

function HeatmapCard(prof) {
  const t = T();
  const baseProf = allTimeProfile() || prof;
  const contribs = (baseProf && baseProf.contributions) || [];
  if (!contribs.length) return null;

  const byDate = new Map();
  for (const c of contribs) {
    if (c && c.date) byDate.set(c.date, c);
  }

  const now = new Date();
  const todayUTC = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
  const endCalendarUTC = new Date(todayUTC);
  endCalendarUTC.setUTCDate(endCalendarUTC.getUTCDate() + (6 - endCalendarUTC.getUTCDay())); // Saturday align
  const weeksCount = 53;
  const startUTC = new Date(endCalendarUTC);
  startUTC.setUTCDate(endCalendarUTC.getUTCDate() - (weeksCount * 7 - 1)); // Sunday align (53 weeks)
  const rangeStartKey = startUTC.toISOString().slice(0, 10);
  const todayKeyUTC = todayUTC.toISOString().slice(0, 10);

  const dark = isDarkTheme();
  const grades = dark
    ? ["[#22262c]", "[#0e4429]", "[#006d32]", "[#26a641]", "[#39d353]"]
    : ["[#ebedf0]", "[#9be9a8]", "[#40c463]", "[#30a14e]", "[#216e39]"];

  // Compute intensity from daily token counts (P92 of active days in 53-week window)
  const windowTokens = [];
  for (let w = 0; w < weeksCount; w++) {
    for (let d = 0; d < 7; d++) {
      const cur = new Date(startUTC);
      cur.setUTCDate(startUTC.getUTCDate() + w * 7 + d);
      const dKey = cur.toISOString().slice(0, 10);
      if (dKey > todayKeyUTC) continue;
      const entry = byDate.get(dKey);
      const tok = num(entry && entry.totals && entry.totals.tokens, 0);
      if (tok > 0) windowTokens.push(tok);
    }
  }
  windowTokens.sort((a, b) => a - b);
  const refMaxTokens =
    windowTokens.length >= 5
      ? windowTokens[Math.min(windowTokens.length - 1, Math.floor(windowTokens.length * 0.92))]
      : windowTokens.length > 0
      ? windowTokens[windowTokens.length - 1]
      : 0;

  let activeInGrid = 0;
  let lastMonth = -1;
  let lastMonthWeek = -10;
  const weekColumns = [];
  for (let w = 0; w < weeksCount; w++) {
    const weekStart = new Date(startUTC);
    weekStart.setUTCDate(startUTC.getUTCDate() + w * 7);
    const mIdx = weekStart.getUTCMonth();
    let monthLabel = "";
    if (mIdx !== lastMonth) {
      lastMonth = mIdx;
      if (w - lastMonthWeek >= 3) {
        monthLabel = MONTHS_SHORT[mIdx] || "";
        lastMonthWeek = w;
      }
    }

    const dayCells = [];
    for (let d = 0; d < 7; d++) {
      const cur = new Date(startUTC);
      cur.setUTCDate(startUTC.getUTCDate() + w * 7 + d);
      const dKey = cur.toISOString().slice(0, 10);
      if (dKey > todayKeyUTC) {
        dayCells.push(
          h("Box", {
            key: `hm-${dKey}`,
            tw: `w-[10px] h-[10px] rounded-[2px] bg-${grades[0]}`,
            tooltip: dKey,
          })
        );
        continue;
      }
      const entry = byDate.get(dKey);
      const tok = num(entry && entry.totals && entry.totals.tokens, 0);
      const cost = num(entry && entry.totals && entry.totals.cost, 0);
      const level =
        tok <= 0 || refMaxTokens <= 0
          ? 0
          : tok >= refMaxTokens * 0.75
          ? 4
          : tok >= refMaxTokens * 0.5
          ? 3
          : tok >= refMaxTokens * 0.25
          ? 2
          : 1;
      if (tok > 0) activeInGrid++;
      const isSel = selectedDate === dKey;
      dayCells.push(
        h("Box", {
          key: `hm-${dKey}`,
          tw: `w-[10px] h-[10px] rounded-[2px] bg-${grades[level]} cursor-pointer ${
            isSel ? "border border-text" : ""
          }`,
          tooltip: `${dKey} · ${formatTokens(tok, 1)} · ${formatCost(cost, false)}`,
          onClick: () => {
            selectedDate = selectedDate === dKey ? null : dKey;
            $metrix.invalidate();
          },
        })
      );
    }
    weekColumns.push(
      h(
        "Column",
        { key: `hm-w-${w}`, tw: "gap-[3px] items-start shrink-0" },
        h(
          "Box",
          { tw: "w-[10px] h-[13px]" },
          monthLabel
            ? TX(monthLabel, {
                tw: "text-[9.5px] text-textMuted leading-none whitespace-nowrap",
              })
            : null
        ),
        ...dayCells
      )
    );
  }

  const inspectedDay = selectedDate ? byDate.get(selectedDate) : null;
  const inspectedClients = inspectedDay ? extractDayClients(inspectedDay) : [];

  return h(
    "Column",
    { tw: `gap-2.5 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
    // Header: Icon + Title
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      Icon("grid", 13, K.muted),
      TX(t.heatmapTitle, { tw: "text-xs font-bold text-textMuted shrink-0" })
    ),
    // Horizontally Scrollable 53-week Calendar Grid
    h(
      "ScrollHorizontal",
      { key: "hm-scroll-53w", direction: "rtl", tw: "w-full pb-3" },
      h("Row", { direction: "ltr", tw: "gap-[3px] items-end" }, weekColumns)
    ),
    // Legend Row
    h(
      "Row",
      { tw: "items-center justify-between w-full min-w-0" },
      TX(t.heatmapActiveDays(activeInGrid), {
        tw: "text-[11px] text-textMuted tabular-nums",
      }),
      h(
        "Row",
        { tw: "items-center gap-1 shrink-0" },
        TX("Less", { tw: "text-[10px] text-textMuted" }),
        ...grades.map((g, i) =>
          h("Box", { key: `lg-${i}`, tw: `w-[9px] h-[9px] rounded-[2px] bg-${g}` })
        ),
        TX("More", { tw: "text-[10px] text-textMuted" })
      )
    ),
    inspectedDay
      ? h(
          "Column",
          { tw: "gap-2 pt-1 w-full min-w-0" },
          Line(),
          h(
            "Row",
            { tw: "items-center gap-2 w-full min-w-0" },
            TX(formatPrettyDate(selectedDate), { tw: "text-xs font-bold" }),
            h("Spacer"),
            TX(
              `${formatTokens(inspectedDay.totals && inspectedDay.totals.tokens, 1)} · ${formatCost(
                inspectedDay.totals && inspectedDay.totals.cost,
                false
              )}`,
              { tw: "text-xs font-bold text-[#10b981] tabular-nums" }
            ),
            h(
              "Row",
              {
                tw: "items-center gap-1 py-0.5 px-2 rounded-md bg-surfaceHover cursor-pointer shrink-0 hover:bg-surfacePressed",
                tooltip: "Open Daily AI Statement Receipt",
                onClick: () => {
                  receiptDateKey = selectedDate;
                  $metrix.invalidate();
                },
              },
              Icon("receipt", 11, K.muted),
              TX("Receipt", { tw: "text-[10.5px] font-medium text-textMuted" })
            )
          ),
          renderDayTokenCategories(inspectedDay, `hm-${selectedDate}`),
          renderDayClientsAndModels(inspectedClients, `hm-${selectedDate}`)
        )
      : null
  );
}

// ---------------------------------------------------------------------------
// Tab 2: Models & Devices Components
// ---------------------------------------------------------------------------

function ClientsUsedCard(prof) {
  const t = T();
  const clients = Array.isArray(prof.clients) ? prof.clients : [];
  if (!clients.length) return null;
  return h(
    "Column",
    { tw: `gap-2 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      Icon("layers", 13, K.muted),
      TX(t.clientsUsedTitle, { tw: "text-xs font-bold text-textMuted" }),
      h("Spacer"),
      TX(String(clients.length), { tw: "text-[11px] font-mono text-textMuted tabular-nums" })
    ),
    h(
      "Row",
      { tw: "flex-wrap gap-1.5 items-center w-full" },
      clients.map(cid =>
        h(
          "Row",
          {
            key: `cl-pill-${cid}`,
            tw: "items-center gap-1.5 py-1 px-2.5 rounded-full bg-surfaceHover shrink-0",
          },
          ClientIcon(cid, 14),
          TX(clientName(cid), { tw: "text-[11px] font-medium" })
        )
      )
    )
  );
}

function ModelsListCard(prof) {
  const t = T();
  const rawModels = Array.isArray(prof.modelUsage) ? prof.modelUsage : [];
  const sorted = rawModels
    .slice()
    .sort((a, b) =>
      modelSort === "tokens"
        ? num(b.tokens, 0) - num(a.tokens, 0) || num(b.cost, 0) - num(a.cost, 0)
        : num(b.cost, 0) - num(a.cost, 0) || num(b.tokens, 0) - num(a.tokens, 0)
    );

  const totalMetric = sorted.reduce(
    (acc, m) => acc + (modelSort === "tokens" ? num(m.tokens, 0) : num(m.cost, 0)),
    0
  );
  const visibleModels = showAllModels ? sorted : sorted.slice(0, 6);

  return h(
    "Column",
    { tw: `gap-3 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
    // Card Title Bar
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      Icon("cpu", 13, K.muted),
      TX(t.modelsTitle, { tw: "text-xs font-bold text-textMuted shrink-0" }),
      h("Spacer"),
      CompactToggle(
        [
          { label: t.sortByTokens, value: "tokens" },
          { label: t.sortByCost, value: "cost" },
        ],
        modelSort,
        v => {
          modelSort = v === "tokens" ? "tokens" : "cost";
          localStorage.setItem("tokens.modelSort", modelSort);
          $metrix.invalidate();
        },
        "seg-model-sort"
      )
    ),
    sorted.length === 0
      ? h(
          "Row",
          { tw: "py-4 items-center justify-center w-full" },
          TX(t.noModels, { tw: "text-xs text-textMuted" })
        )
      : h(
          "Column",
          { tw: "gap-2.5 w-full min-w-0" },
          ...visibleModels.map((m, idx) => {
            const tok = num(m.tokens, 0);
            const cost = num(m.cost, 0);
            const val = modelSort === "tokens" ? tok : cost;
            const share = totalMetric > 0 ? clampPct((val / totalMetric) * 100) : clampPct(m.percentage);

            return h(
              "Column",
              { key: `mod-${m.model || idx}`, tw: "gap-1.5 w-full min-w-0" },
              h(
                "Row",
                { tw: "items-center gap-2 w-full min-w-0" },
                ModelIcon(m.model, 15),
                TX(str(m.model), {
                  tw: "text-[12.5px] font-medium truncate min-w-0 shrink grow",
                  tooltip: str(m.model),
                }),
                TX(modelSort === "tokens" ? formatTokens(tok, 1) : formatCost(cost, true), {
                  tw: "text-xs font-semibold tabular-nums shrink-0",
                  tooltip: `${comma(tok)} tokens · ${formatCost(cost, false)}`,
                }),
                TX(`${share.toFixed(1)}%`, {
                  tw: "text-xs text-textMuted tabular-nums w-11 text-end shrink-0",
                })
              ),
              h(
                "Row",
                { tw: "w-full h-1 rounded-full bg-surfaceHover overflow-hidden" },
                h("Box", {
                  tw: "h-1 rounded-full bg-[#10b981]",
                  width: `${Math.max(share, 1.5)}%`,
                })
              )
            );
          }),
          sorted.length > 6
            ? h(
                "Row",
                { tw: "pt-1 items-center justify-center w-full" },
                h(
                  "Row",
                  {
                    tw: `py-1 px-3.5 rounded-full border border-${cardBorder()} cursor-pointer items-center justify-center hover:bg-surfaceHover`,
                    onClick: () => {
                      showAllModels = !showAllModels;
                      $metrix.invalidate();
                    },
                  },
                  TX(showAllModels ? "Show Less" : `Show All ${sorted.length}`, {
                    tw: "text-xs font-medium text-[#10b981] tabular-nums",
                  })
                )
              )
            : null
        )
  );
}

function DevicesListCard() {
  const t = T();
  const totalDevTokens = devicesList.reduce((acc, d) => acc + Math.max(0, num(d.totalTokens, 0)), 0);

  return h(
    "Column",
    { tw: `gap-3 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
    // Card Title Bar
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      Icon("laptop", 13, K.muted),
      TX(t.devicesTitle, { tw: "text-xs font-bold text-textMuted" }),
      h("Spacer"),
      TX(t.devicesCount(devicesList.length), {
        tw: "text-[11px] text-textMuted tabular-nums",
      })
    ),
    devicesList.length === 0
      ? h(
          "Row",
          { tw: "py-4 items-center justify-center w-full" },
          TX(t.noDevices, { tw: "text-xs text-textMuted" })
        )
      : h(
          "Column",
          { tw: "gap-3 w-full min-w-0" },
          ...devicesList.map(d => {
            const devShare =
              totalDevTokens > 0 ? clampPct((Math.max(0, num(d.totalTokens, 0)) / totalDevTokens) * 100) : 0;
            const daysLabel = `${comma(d.activeDays)} ${d.activeDays === 1 ? "day" : "days"}`;
            return h(
              "Column",
              {
                key: `dev-${d.id}`,
                tw: "gap-1.5 py-1 px-1 -mx-1 rounded-lg cursor-pointer w-full min-w-0 hover:bg-surfaceHover",
                onClick: () => selectDevice(d.id),
              },
              h(
                "Row",
                { tw: "items-center gap-2 w-full min-w-0" },
                h(
                  "Column",
                  { tw: "gap-0.5 min-w-0 shrink grow" },
                  TX(d.displayName, { tw: "text-[13px] font-semibold truncate" }),
                  TX(
                    [
                      d.cloudSessions != null ? t.cloudSessionsCount(d.cloudSessions) : "",
                      t.lastSubmitted(formatAge(d.lastSubmittedAt)),
                    ]
                      .filter(Boolean)
                      .join(" · "),
                    { tw: "text-[11px] text-textMuted truncate tabular-nums" }
                  )
                ),
                h(
                  "Column",
                  { tw: "items-end gap-0.5 shrink-0" },
                  TX(formatTokens(d.totalTokens, 1), {
                    tw: "text-[13px] font-bold tabular-nums",
                    tooltip: `${comma(d.totalTokens)} tokens`,
                  }),
                  TX(formatCost(d.totalCost, true), {
                    tw: "text-[11px] text-textMuted tabular-nums",
                    tooltip: formatCost(d.totalCost, false),
                  })
                )
              ),
              h(
                "Row",
                { tw: "items-center gap-3 w-full min-w-0" },
                h(
                  "Row",
                  { tw: "grow h-1 rounded-full bg-surfaceHover overflow-hidden min-w-0" },
                  h("Box", {
                    tw: "h-1 rounded-full bg-[#10b981]",
                    width: `${Math.max(devShare, 2)}%`,
                  })
                ),
                TX(daysLabel, {
                  tw: "text-[11px] text-textMuted tabular-nums shrink-0",
                })
              )
            );
          })
        )
  );
}

// ---------------------------------------------------------------------------
// Secondary View: Daily AI Statement Receipt (inspired by magpie day-card)
// ---------------------------------------------------------------------------

function ReceiptDashedRule() {
  const cmds = [];
  for (let x = 4; x < 312; x += 9) {
    cmds.push({ op: "rect", rect: { x, y: 3, width: 5, height: 1 }, color: "#a8a49c" });
  }
  return h("Canvas", { width: 316, height: 7, commands: cmds, tw: "w-full h-[7px]" });
}

function ReceiptTornEdge() {
  const W_PAPER = 364;
  const H_TEETH = 6;
  const H_CANVAS = 14;
  const teeth = 36;
  const tw = W_PAPER / teeth;
  const makeTeethPath = dy => {
    const p = [["M", 0, 0], ["L", W_PAPER, 0]];
    for (let i = teeth - 1; i >= 0; i--) {
      p.push(["L", Number((i * tw + tw / 2).toFixed(2)), H_TEETH + dy]);
      p.push(["L", Number((i * tw).toFixed(2)), dy]);
    }
    p.push(["Z"]);
    return p;
  };
  return h("Canvas", {
    width: W_PAPER,
    height: H_CANVAS,
    commands: [
      { op: "path", path: makeTeethPath(4), color: "#00000010" },
      { op: "path", path: makeTeethPath(2), color: "#0000001a" },
      { op: "path", path: makeTeethPath(0), color: "#f7f4ed" },
    ],
    tw: "w-full h-[14px]",
  });
}

function ReceiptView(prof) {
  const baseProf = allTimeProfile() || prof;
  const contribs = (baseProf && baseProf.contributions) || [];
  const byDate = new Map();
  for (const c of contribs) {
    if (c && c.date) byDate.set(c.date, c);
  }

  const dKey = receiptDateKey || localDateKey();
  const todayKey = localDateKey();
  const day = byDate.get(dKey) || null;
  const tok = num(day && day.totals && day.totals.tokens, 0);
  const cost = num(day && day.totals && day.totals.cost, 0);
  const clients = extractDayClients(day);
  const msgs = dayMessageCount(day, clients);

  // Streak ending at dKey
  const activeSet = new Set(
    contribs.filter(c => c && c.date && num(c.totals && c.totals.tokens, 0) > 0).map(c => c.date)
  );
  let cursor = dKey;
  if (!activeSet.has(cursor) && cursor === todayKey) {
    cursor = shiftDateKey(cursor, -1);
  }
  let streakDays = 0;
  while (activeSet.has(cursor)) {
    streakDays++;
    cursor = shiftDateKey(cursor, -1);
  }

  // Average active day before dKey
  const priorDays = contribs.filter(
    c => c && c.date && c.date < dKey && num(c.totals && c.totals.tokens, 0) > 0
  );
  let vsAvgStr = "–";
  if (priorDays.length > 0) {
    const sumCost = priorDays.reduce((acc, c) => acc + num(c.totals && c.totals.cost, 0), 0);
    const sumTok = priorDays.reduce((acc, c) => acc + num(c.totals && c.totals.tokens, 0), 0);
    const avgCost = sumCost / priorDays.length;
    const avgTok = sumTok / priorDays.length;
    let ratio = 0;
    if (avgCost > 0 && cost > 0) ratio = cost / avgCost;
    else if (avgTok > 0 && tok > 0) ratio = tok / avgTok;
    if (ratio > 0) {
      vsAvgStr = ratio < 0.1 ? "<0.1×" : `${ratio >= 100 ? Math.round(ratio) : ratio.toFixed(1)}×`;
    }
  }

  // Cache hit rate: cacheRead / (input + cacheRead + cacheWrite)
  const tb = (day && day.tokenBreakdown) || {};
  const inTok = Math.max(0, num(tb.input, 0));
  const outTok = Math.max(0, num(tb.output, 0));
  const cRead = Math.max(0, num(tb.cacheRead, 0));
  const cWrite = Math.max(0, num(tb.cacheWrite, 0));
  const promptTotal = inTok + cRead + cWrite;
  const hitRateStr =
    promptTotal > 0 ? `${Math.min(100, (cRead / promptTotal) * 100).toFixed(1)}%` : "–";

  const now = new Date();
  const pad2 = n => String(n).padStart(2, "0");
  const issuedStr = `${formatPrettyDate(localDateKey(now)).toUpperCase()} AT ${pad2(
    now.getHours()
  )}:${pad2(now.getMinutes())}`;
  const dateUpper = formatPrettyDate(dKey).toUpperCase();
  const rank =
    (baseProf && baseProf.user && baseProf.user.rank) ||
    (prof && prof.user && prof.user.rank) ||
    null;
  const uname = resolvedUsername || (prof && prof.user && prof.user.username) || "tokens";
  const th = RECEIPT_THEMES[receiptTheme] || RECEIPT_THEMES.sage;

  const shownClients = clients.slice(0, 6);
  const modelRowsCount = shownClients.reduce((acc, cl) => acc + Math.min(5, cl.models.length), 0);
  const moreRowsCount = shownClients.filter(cl => cl.models.length > 5).length;
  receiptShotHeight =
    475 + shownClients.length * 26 + modelRowsCount * 21 + moreRowsCount * 18;

  const INK = "[#1f1d20]";
  const MUTED = "[#76736e]";

  const kvRow = (label, value, bold = false) =>
    h(
      "Row",
      { tw: "items-center justify-between gap-2 w-full min-w-0" },
      TX(label, { tw: `text-[11px] font-mono text-${MUTED} shrink-0` }),
      TX(value, {
        tw: `text-[11px] font-mono ${bold ? "font-bold" : "font-medium"} text-${INK} tabular-nums truncate`,
      })
    );

  return h(
    receiptCleanShot ? "Column" : "Scroll",
    {
      tw: "grow min-h-0 w-full",
      ...(receiptCleanShot ? {} : { scrollbars: true }),
      linearGradient: { from: th.from, to: th.to, angle: th.angle, oklab: true },
    },
    h(
      "Column",
      {
        tw: "items-center justify-center py-6 px-7 w-full grow",
      },
      // Paper container + Torn Bottom Edge
      h(
        "Column",
        { tw: "w-full" },
        // Main Paper Slip
        h(
          "Column",
          {
            radius: [4, 4, 0, 0],
            tw: "gap-2.5 pt-5 pr-5 pb-4 pl-5 bg-[#f7f4ed] w-full min-w-0",
          },
          // 1. Receipt Title & Tagline
          h(
            "Column",
            { tw: "items-center gap-0.5 pb-1 w-full" },
            TX("DAILY AI STATEMENT", {
              tw: `text-lg font-mono font-extrabold text-${INK} tracking-[1.2px] text-center`,
            }),
            TX(`Tracked via tokens.ci · @${uname}`, {
              tw: `text-[10.5px] font-mono text-${MUTED} text-center`,
            })
          ),
          // 2. Date & Issued At
          h(
            "Column",
            { tw: "gap-1 w-full" },
            kvRow("DATE", dateUpper),
            kvRow("ISSUED", issuedStr)
          ),
          ReceiptDashedRule(),
          // 3. Total API Cost
          h(
            "Column",
            { tw: "items-center gap-1 py-1 w-full" },
            TX("TOTAL API COST", {
              tw: `text-[10.5px] font-mono text-${MUTED} tracking-[2px]`,
            }),
            TX(formatCost(cost, false), {
              tw: `text-3xl font-mono font-extrabold text-${INK} tabular-nums leading-none py-0.5`,
            }),
            TX("API-EQUIVALENT COST · NOT AN INVOICE", {
              tw: `text-[9px] font-mono text-${MUTED} tracking-[0.8px]`,
            })
          ),
          ReceiptDashedRule(),
          // 4. Streak, Messages, vs Average Day
          h(
            "Column",
            { tw: "gap-1 w-full" },
            kvRow("STREAK", `${streakDays} ${streakDays === 1 ? "DAY" : "DAYS"}`, true),
            kvRow("MESSAGES", comma(msgs), true),
            kvRow("VS AVERAGE DAY", vsAvgStr, true)
          ),
          ReceiptDashedRule(),
          // 5. Client / Model Breakdown
          h(
            "Column",
            { tw: "gap-1.5 w-full min-w-0" },
            h(
              "Row",
              { tw: "items-center justify-between w-full" },
              TX("CLIENT / MODEL", { tw: `text-[10px] font-mono text-${MUTED}` }),
              TX("COST", { tw: `text-[10px] font-mono text-${MUTED}` })
            ),
            clients.length === 0
              ? TX("No activity recorded on this day.", {
                  tw: `text-[11px] font-mono text-${MUTED} py-2`,
                })
              : h(
                  "Column",
                  { tw: "gap-2 w-full min-w-0" },
                  ...clients.slice(0, 6).map(cl =>
                    h(
                      "Column",
                      { key: `rcpt-cl-${cl.client}`, tw: "gap-1 w-full min-w-0" },
                      h(
                        "Row",
                        { tw: "items-center gap-1.5 w-full min-w-0" },
                        ClientIcon(cl.client, 13, true),
                        TX(clientName(cl.client).toUpperCase(), {
                          tw: `text-xs font-mono font-bold text-${INK} truncate min-w-0 shrink grow`,
                        }),
                        TX(formatCost(cl.cost, false), {
                          tw: `text-xs font-mono font-bold text-${INK} tabular-nums shrink-0`,
                        })
                      ),
                      ...cl.models.slice(0, 5).map((m, idx) =>
                        h(
                          "Row",
                          {
                            key: `rcpt-m-${cl.client}-${m.modelId || m.model || idx}`,
                            tw: "items-center gap-1.5 pl-4 w-full min-w-0",
                          },
                          ModelIcon(m.modelId || m.model, 11, true),
                          TX(String(m.modelId || m.model || "").toUpperCase(), {
                            tw: `text-[10.5px] font-mono text-${INK} truncate min-w-0 shrink grow`,
                          }),
                          TX(formatCost(m.cost, false), {
                            tw: `text-[10.5px] font-mono text-${MUTED} tabular-nums shrink-0`,
                          })
                        )
                      ),
                      cl.models.length > 5
                        ? TX(`+${cl.models.length - 5} MORE`, {
                            tw: `text-[10px] font-mono text-${MUTED} pl-4`,
                          })
                        : null
                    )
                  )
                )
          ),
          ReceiptDashedRule(),
          // 6. Token Totals & Cache Hit Rate
          h(
            "Column",
            { tw: "gap-1 w-full" },
            kvRow("TOTAL TOKENS", formatTokens(tok, 1), true),
            kvRow("INPUT", formatTokens(inTok, 1)),
            kvRow("OUTPUT", formatTokens(outTok, 1)),
            kvRow("CACHE HIT RATE", hitRateStr, true)
          ),
          ReceiptDashedRule(),
          // 7. Footer
          h(
            "Column",
            { tw: "items-center gap-0.5 pt-1 w-full" },
            TX(
              `@${uname}${rank ? " · GLOBAL #" + comma(rank) : ""}${
                todayRank && dKey === todayKey ? " · TODAY #" + comma(todayRank) : ""
              }`,
              {
                tw: `text-[10px] font-mono font-bold text-${INK} text-center`,
              }
            ),
            TX("tokens.ci · metrix.bar", {
              tw: `text-[9.5px] font-mono text-${MUTED} text-center`,
            })
          )
        ),
        // Torn Teeth Bottom Edge
        ReceiptTornEdge()
      )
    )
  );
}

// ---------------------------------------------------------------------------
// Secondary View: Single Device Detail
// ---------------------------------------------------------------------------

function DeviceDetailView() {
  const t = T();
  const fallbackDev = devicesList.find(d => d.id === selectedDeviceId);

  if (String(selectedDeviceId).startsWith("cloud:") && fallbackDev) {
    const sessions = Array.isArray(fallbackDev.sessions) ? fallbackDev.sessions : [];
    return h(
      "Scroll",
      { tw: "grow min-h-0 w-full" },
      h(
        "Column",
        { tw: "gap-3 pt-3.5 pr-4 pb-4 pl-4 w-full min-w-0" },
        h(
          "Grid",
          { tw: "grid-cols-2 gap-2 w-full min-w-0" },
          h(
            "Column",
            { tw: `gap-1 py-2.5 px-3 rounded-xl border border-${cardBorder()} bg-background min-w-0` },
            TX(t.totalTokens, { tw: "text-[11px] text-textMuted" }),
            TX(formatTokens(fallbackDev.totalTokens, 2), { tw: "text-lg font-bold tabular-nums" }),
            TX(
              t.ioSub(formatTokens(fallbackDev.inputTokens, 1), formatTokens(fallbackDev.outputTokens, 1)),
              { tw: "text-[10px] text-textMuted tabular-nums truncate" }
            )
          ),
          h(
            "Column",
            { tw: `gap-1 py-2.5 px-3 rounded-xl border border-${cardBorder()} bg-background min-w-0` },
            TX(t.totalCost, { tw: "text-[11px] text-textMuted" }),
            TX(formatCost(fallbackDev.totalCost, false), { tw: "text-lg font-bold text-[#10b981] tabular-nums" }),
            TX(
              `${t.cloudSessionsCount(fallbackDev.cloudSessions || sessions.length)} · ${t.daysActive(fallbackDev.activeDays)}`,
              { tw: "text-[10px] text-textMuted tabular-nums truncate" }
            )
          )
        ),
        sessions.length > 0
          ? h(
              "Column",
              { tw: `gap-1.5 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
              TX(t.cloudSessionsListTitle, { tw: "text-xs font-bold pb-1" }),
              ...sessions.map((s, idx) =>
                h(
                  "Column",
                  { key: `cs-${s.id || idx}`, tw: "w-full min-w-0" },
                  Line(),
                  h(
                    "Row",
                    { tw: "items-center gap-2 py-1.5 w-full min-w-0" },
                    TX(`#${idx + 1} · ${String(s.deviceKey || "").slice(-8)}`, {
                      tw: "text-xs font-mono text-textMuted shrink-0",
                    }),
                    TX(t.lastSubmitted(formatAge(s.lastSubmittedAt)), {
                      tw: "text-[10.5px] text-textMuted truncate min-w-0 shrink grow tabular-nums",
                    }),
                    TX(formatCost(s.totalCost, false), {
                      tw: "text-[11px] font-semibold text-[#10b981] tabular-nums shrink-0",
                    }),
                    TX(formatTokens(s.totalTokens, 1), {
                      tw: "text-xs font-bold tabular-nums shrink-0 w-14 text-end",
                    })
                  )
                )
              )
            )
          : null
      )
    );
  }

  const entry = deviceDetailCache.get(selectedDeviceId);

  if (!entry || (entry.loading && !entry.data)) {
    return h(
      "Scroll",
      { tw: "grow min-h-0 w-full" },
      h(
        "Column",
        { tw: "gap-3 pt-3.5 pr-4 pb-4 pl-4 w-full" },
        bone(388, 92, { tw: "rounded-xl w-full" }),
        bone(388, 160, { tw: "rounded-xl w-full" }),
        bone(388, 180, { tw: "rounded-xl w-full" })
      )
    );
  }

  if (entry.error && !entry.data) {
    return Problem(t.connErrTitle, entry.error, true, () => loadDeviceDetail(selectedDeviceId));
  }

  const data = entry.data || {};
  const totals = data.totals || fallbackDev || {};
  const contribs = Array.isArray(data.contributions) ? data.contributions : [];

  const points = contribs
    .slice(0, 30)
    .map(c => {
      const ts = Date.parse(`${c.date}T00:00:00Z`);
      const tok = num(c.tokens, 0);
      const cost = num(c.cost, 0);
      return {
        x: ts,
        y: Number((tok / 1e6).toFixed(2)),
        label: c.date,
        valueLabel: `${formatTokens(tok, 2)} (${formatCost(cost, false)})`,
      };
    })
    .filter(p => Number.isFinite(p.x))
    .sort((a, b) => a.x - b.x);

  return h(
    "Scroll",
    { tw: "grow min-h-0 w-full" },
    h(
      "Column",
      { tw: "gap-3 pt-3.5 pr-4 pb-4 pl-4 w-full min-w-0" },
      // Summary Card
      h(
        "Grid",
        { tw: "grid-cols-2 gap-2 w-full min-w-0" },
        h(
          "Column",
          { tw: `gap-1 py-2.5 px-3 rounded-xl border border-${cardBorder()} bg-background min-w-0` },
          TX(t.totalTokens, { tw: "text-[11px] text-textMuted" }),
          TX(formatTokens(totals.totalTokens, 2), { tw: "text-lg font-bold tabular-nums" }),
          TX(
            t.ioSub(formatTokens(totals.inputTokens, 1), formatTokens(totals.outputTokens, 1)),
            { tw: "text-[10px] text-textMuted tabular-nums truncate" }
          )
        ),
        h(
          "Column",
          { tw: `gap-1 py-2.5 px-3 rounded-xl border border-${cardBorder()} bg-background min-w-0` },
          TX(t.totalCost, { tw: "text-[11px] text-textMuted" }),
          TX(formatCost(totals.totalCost, false), { tw: "text-lg font-bold text-[#10b981] tabular-nums" }),
          TX(t.daysActive(num(totals.activeDays, 0)), { tw: "text-[10px] text-textMuted tabular-nums" })
        )
      ),
      // Device Chart
      points.length >= 2
        ? h(
            "Column",
            { tw: `gap-2 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
            TX(t.trendTitle, { tw: "text-xs font-bold" }),
            h("Chart", {
              key: `dev-chart-${selectedDeviceId}`,
              type: "area",
              curve: "monotone",
              xKind: "time",
              height: 118,
              hover: true,
              tw: "w-full",
              series: [
                {
                  name: "Tokens (M)",
                  color: "#8b5cf6",
                  fill: { from: 0.28, to: 0.02 },
                  points,
                },
              ],
            })
          )
        : null,
      // Recent Days Table
      contribs.length > 0
        ? h(
            "Column",
            { tw: `gap-1.5 py-3 px-3.5 rounded-xl border border-${cardBorder()} bg-background w-full min-w-0` },
            TX(t.deviceRecentDays, { tw: "text-xs font-bold pb-1" }),
            ...contribs.slice(0, 14).map(c =>
              h(
                "Column",
                { key: `dc-${c.date}`, tw: "w-full min-w-0" },
                Line(),
                h(
                  "Row",
                  { tw: "items-center gap-2 py-1 w-full min-w-0" },
                  TX(c.date, { tw: "text-xs font-mono tabular-nums shrink-0" }),
                  TX(
                    t.ioSub(formatTokens(c.inputTokens, 1), formatTokens(c.outputTokens, 1)),
                    { tw: "text-[10.5px] text-textMuted truncate min-w-0 shrink grow tabular-nums" }
                  ),
                  TX(formatCost(c.cost, false), {
                    tw: "text-[11px] font-semibold text-[#10b981] tabular-nums shrink-0",
                  }),
                  TX(formatTokens(c.tokens, 1), {
                    tw: "text-xs font-bold tabular-nums shrink-0 w-14 text-end",
                  })
                )
              )
            )
          )
        : null
    )
  );
}

// ---------------------------------------------------------------------------
// Empty / Error / Skeleton States & Root Views
// ---------------------------------------------------------------------------

function Problem(title, detail, retry, onRetry = launchRefresh) {
  const t = T();
  return h(
    "Column",
    { tw: "grow items-center justify-center gap-2 py-8 px-8" },
    Icon("alert", 22, K.down),
    TX(title, { tw: "text-sm font-semibold text-center" }),
    TX(detail, { tw: "text-xs text-textMuted text-center leading-[1.35]" }),
    retry
      ? h("Row", { tw: "mt-1.5" }, h("Button", { key: "btn-retry", onClick: onRetry }, t.retry))
      : null
  );
}

function SetupGuide() {
  const t = T();
  return h(
    "Column",
    { tw: "grow items-center justify-center gap-2.5 py-8 px-8" },
    h(
      "Column",
      { tw: "w-11 h-11 rounded-xl bg-accent items-center justify-center mb-1" },
      Icon("brand", 24, "accentText")
    ),
    TX(t.setupTitle, { tw: "text-base font-semibold text-center" }),
    TX(t.setupDesc, { tw: "text-xs text-textMuted text-center leading-[1.4]" })
  );
}

function Skeleton() {
  return h(
    "Column",
    { tw: "gap-3 pt-3.5 pr-4 pb-4 pl-4 w-full" },
    bone(388, 28, { tw: "rounded-md w-full" }),
    bone(388, 110, { tw: "rounded-xl w-full" }),
    h(
      "Grid",
      { tw: "grid-cols-2 gap-2 w-full" },
      [0, 1, 2, 3].map(i => bone(180, 68, { key: `sk-g-${i}`, tw: "rounded-xl w-full" }))
    ),
    bone(388, 140, { tw: "rounded-xl w-full" })
  );
}

function Body() {
  const t = T();
  if (inputErr) return Problem(t.invalidUrlTitle, inputErr, false);
  if (!resolvedUsername && !loading && loadedAt > 0 && !error) return SetupGuide();
  if (!resolvedUsername && !loading && !loadedAt) return SetupGuide();

  if (selectedDeviceId) return DeviceDetailView();

  const prof = currentProfile();
  if (!prof) {
    return error ? Problem(t.connErrTitle, error, true) : Skeleton();
  }
  if (prof.banned) {
    return Problem("Tokens", t.bannedNotice(prof.banReason), false);
  }
  if (receiptDateKey) {
    return ReceiptView(prof);
  }

  return h(
    "Scroll",
    { tw: "grow min-h-0 w-full" },
    h(
      "Column",
      { tw: "gap-3 pt-3 pr-4 pb-4 pl-4 w-full min-w-0" },
      Banner(),
      TodayHeroCard(prof),
      Line(),
      PeriodHeaderBar(),
      SummaryGrid(prof),
      TokenMixCard(prof),
      DailyTrendCard(prof),
      HeatmapCard(prof),
      ClientsUsedCard(prof),
      ModelsListCard(prof),
      DevicesListCard()
    )
  );
}

function panelTree() {
  return h(
    "Column",
    {
      preferredWidth: W,
      preferredHeight: 620,
      safeArea: true,
      tw: "size-full text-[13px] text-text min-w-0 min-h-0",
      shortcuts: {
        "CmdOrCtrl+R": launchRefresh,
        "CmdOrCtrl+1": () => switchPeriod("all"),
        "CmdOrCtrl+2": () => switchPeriod("month"),
        "CmdOrCtrl+3": () => switchPeriod("week"),
        Escape: () => {
          if (receiptDateKey) {
            receiptDateKey = null;
            $metrix.invalidate();
          } else if (selectedDeviceId) {
            selectedDeviceId = null;
            $metrix.invalidate();
          } else if (selectedDate) {
            selectedDate = null;
            $metrix.invalidate();
          }
        },
      },
    },
    Header(),
    Body()
  );
}

function trayTree() {
  const t = T();
  const prof = currentProfile();
  const allProf = allTimeProfile() || prof;
  let title = "";
  let tooltip = "Tokens";

  if (prof && !prof.banned) {
    const { todayDay } = findTodayAndLatest(prof);
    const todayTok = num(todayDay && todayDay.totals && todayDay.totals.tokens, 0);
    const todayCost = num(todayDay && todayDay.totals && todayDay.totals.cost, 0);
    const totalTok = num(allProf && allProf.stats && allProf.stats.totalTokens, 0);
    const totalCost = num(allProf && allProf.stats && allProf.stats.totalCost, 0);
    const rank = (allProf && allProf.user && allProf.user.rank) || null;

    const tTokStr = formatTokens(todayTok, 1);
    const tCostStr = formatCost(todayCost, true);
    const allTokStr = formatTokens(totalTok, 1);
    const allCostStr = formatCost(totalCost, true);
    const rankStr = rank ? `#${rank}` : "";

    if (trayFormat === "today_rank") {
      title = rankStr ? `${tTokStr} · ${rankStr}` : tTokStr;
    } else if (trayFormat === "total_rank") {
      title = rankStr ? `${allTokStr} · ${rankStr}` : allTokStr;
    } else if (trayFormat === "total_cost") {
      title = `${allTokStr} · ${allCostStr}`;
    } else if (trayFormat === "today_only") {
      title = tTokStr;
    } else if (trayFormat === "cost_only") {
      title = tCostStr;
    } else {
      // Default: today_cost (14.2M · $8.40)
      title = `${tTokStr} · ${tCostStr}`;
    }

    tooltip = t.trayTooltip(
      resolvedUsername || (prof.user && prof.user.username) || "tokens",
      tTokStr,
      formatCost(todayCost, false),
      allTokStr,
      formatCost(totalCost, false),
      rank
    );
  }

  return {
    icon: "data:image/svg+xml," + encodeURIComponent(BRAND),
    iconTemplate: true,
    title,
    tooltip,
    error: error || inputErr,
    menu: [
      { label: t.refresh, onClick: launchRefresh, disabled: !baseURL },
      { label: t.openProfile, onClick: () => $metrix.openURL(profileURL()) },
      { label: t.openLeaderboard, onClick: () => $metrix.openURL(`${baseURL || "https://tokens.ci"}/leaderboard`) },
    ],
  };
}

function widgetTree(family) {
  const prof = allTimeProfile();
  const heading = h(
    "Row",
    { gap: 6, alignItems: "center" },
    h("Icon", { svg: BRAND, size: 14, color: "success" }),
    TX(family === "small" || !resolvedUsername ? "Tokens" : `@${resolvedUsername}`, {
      fontSize: 12,
      fontWeight: 600,
      maxLines: 1,
    }),
    h("Spacer"),
    TX(error && prof && !prof.banned ? "Cached" : "Today", {
      fontSize: 11,
      color: error && prof && !prof.banned ? "warning" : "secondary",
    })
  );

  if (inputErr || !prof || prof.banned) {
    const message = inputErr
      ? "Open Tokens to check the server URL."
      : prof && prof.banned
      ? "This account is unavailable."
      : error
      ? "Couldn't load usage. Open Tokens to retry."
      : !resolvedUsername && !loading
      ? "Open Tokens to connect your account."
      : "Loading usage…";
    return h(
      "Column",
      { gap: 8 },
      heading,
      h("Spacer"),
      TX(message, { fontSize: 12, color: "secondary", maxLines: 3 }),
      h("Spacer")
    );
  }

  const { todayKey, todayDay } = findTodayAndLatest(prof);
  const tokens = Math.max(0, num(todayDay && todayDay.totals && todayDay.totals.tokens, 0));
  const cost = Math.max(0, num(todayDay && todayDay.totals && todayDay.totals.cost, 0));
  const clients = extractDayClients(todayDay);
  const messages = dayMessageCount(todayDay, clients);
  const rank = todayRank
    ? h("Badge", { text: `#${comma(todayRank)}`, fontSize: 11, color: "success" })
    : null;
  const hero = h(
    "Column",
    { gap: 2 },
    TX(formatTokens(tokens, 1), { fontSize: family === "large" ? 36 : 30, fontWeight: 700 }),
    TX("tokens", { fontSize: 11, color: "secondary" })
  );

  if (family === "small") {
    return h(
      "Column",
      { gap: 4 },
      heading,
      h("Spacer"),
      hero,
      h("Spacer"),
      h(
        "Row",
        { gap: 6, alignItems: "center" },
        TX(formatCost(cost, true), { fontSize: 14, fontWeight: 600 }),
        h("Spacer"),
        rank
      )
    );
  }

  const dailyTokens = new Map();
  for (const day of prof.contributions || []) {
    if (day && day.date) {
      dailyTokens.set(day.date, Math.max(0, num(day.totals && day.totals.tokens, 0)));
    }
  }
  const days = family === "medium" ? 7 : 30;
  const points = Array.from({ length: days }, (_, index) =>
    (dailyTokens.get(shiftDateKey(todayKey, index - days + 1)) || 0) / 1e6
  );
  const trend = h(
    "Column",
    { gap: 4 },
    h("Chart", {
      type: "area",
      height: family === "medium" ? 48 : 64,
      series: [{ name: "Tokens (M)", color: "success", points }],
    }),
    h(
      "Row",
      { gap: 4 },
      TX(`Last ${days} days`, { fontSize: 11, color: "secondary" }),
      h("Spacer"),
      TX("Tokens", { fontSize: 11, color: "secondary" })
    )
  );

  if (family === "medium") {
    return h(
      "Column",
      { gap: 8 },
      heading,
      h("Spacer"),
      h(
        "Row",
        { gap: 16, alignItems: "end" },
        h(
          "Column",
          { gap: 4, width: 124 },
          hero,
          h(
            "Row",
            { gap: 6, alignItems: "center" },
            TX(formatCost(cost, true), { fontSize: 14, fontWeight: 600 }),
            rank
          ),
          TX(`${comma(messages)} messages`, { fontSize: 11, color: "secondary" })
        ),
        trend
      ),
      h("Spacer")
    );
  }

  return h(
    "Column",
    { gap: 8 },
    h("Row", { gap: 6, alignItems: "center" }, heading, rank),
    h(
      "Row",
      { gap: 16, alignItems: "end" },
      hero,
      h("Spacer"),
      h(
        "Column",
        { gap: 4 },
        TX(`${formatCost(cost, true)} cost`, { fontSize: 14, fontWeight: 600 }),
        TX(`${comma(messages)} messages`, { fontSize: 12, color: "secondary" })
      )
    ),
    trend,
    h("Divider"),
    TX("Clients · today", { fontSize: 12, fontWeight: 600, color: "secondary" }),
    clients.length
      ? clients.slice().sort((left, right) => right.totalTokens - left.totalTokens).slice(0, 3).map(client => {
          const logo = clientLogoURL(client.client);
          return h(
            "Row",
            { key: `widget-client-${client.client}`, gap: 6, alignItems: "center" },
            logo
              ? h("Image", { src: logo, width: 16, height: 16, radius: 3 })
              : h("Icon", { svg: ICON.layers, size: 16, color: "secondary" }),
            TX(clientName(client.client), { fontSize: 12, maxLines: 1 }),
            h("Spacer"),
            TX(formatTokens(client.totalTokens, 1), { fontSize: 12, fontWeight: 600 }),
            TX(formatCost(client.cost, true), { fontSize: 11, color: "secondary" })
          );
        })
      : TX(tokens > 0 ? "Client breakdown unavailable." : "No activity recorded today.", {
          fontSize: 12,
          color: "secondary",
          maxLines: 2,
        }),
    h("Spacer")
  );
}

export default {
  async scheduled(env) {
    syncInputs(env);
    await refresh();
  },

  render(env) {
    syncInputs(env);
    return {
      tray: trayTree(),
      panel: panelTree(),
      widget: {
        small: widgetTree("small"),
        medium: widgetTree("medium"),
        large: widgetTree("large"),
      },
    };
  },

  event(name, payload) {
    if (
      name === "lifecycle" &&
      payload &&
      payload.type === "expand" &&
      baseURL &&
      !inflight &&
      Date.now() - loadedAt > 60e3
    ) {
      launchRefresh();
    }
  },
};
  ]]></script>
</bar>
