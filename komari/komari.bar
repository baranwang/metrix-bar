    emptyDesc: "No visible nodes were returned by this Komari instance.",
    retry: "Retry",
    refresh: "Refresh",
    openKomari: "Open Komari",
    backToList: "Back to servers",
    offlineAlertTitle: "Komari · Server Offline",
    offlineAlertBody: (name, r) => `${name}${r ? " (" + r + ")" : ""} is offline.`,
    trayTooltip: (site, on, total, down, up, cpu) =>
      `${site} · ${on}/${total} online · ↓ ${down} · ↑ ${up} · Avg CPU ${cpu}`,
    dlSeries: "Download (KB/s)",
    ulSeries: "Upload (KB/s)",
    cycleMonth: "/mo",
    cycleQuarter: "/qtr",
    cycleHalfYear: "/6mo",
    cycleYear: "/yr",
    cycleDays: d => `/${d}d`,
    infoSuffix: "Node Info",
    secSystem: "System",
    secResource: "Resources",
    secNetwork: "Network",
    lblStatus: "Status",
    lblGpu: "GPU",
    lblVirt: "Virtualization",
    lblArch: "Arch",
    lblLiveNet: "Live Net",
    lblLastUpdate: "Updated",
    lblPeakSpeed: "Peak Speed",
    lblTotalTraffic: "Total Traffic",
    tabLoad: "Load",
    tabPing: "Ping",
    spanRealtime: "Live",
    span1h: "1H",
    span4h: "4H",
    span24h: "1D",
    loadChartsTitle: "Load Charts",
    pingChartsTitle: "Ping Charts",
    pingLatency: "Latency",
    pingLoss: "Loss Rate",
    coverage: (a, b) => `${a} - ${b}`,
    samples: n => `${n} pts`,
    usageSub: "Usage",
    usedSpaceSub: "Used Space",
    connTitle: "Connections",
    connSub: "Connections",
    procTitle: "Processes",
  },
};

let hostLocale = "";

async function detectHostLocale() {
  if (hostLocale) return;
  try {
    const loc = await $metrix.system("app.locale");
    if (typeof loc === "string" && loc) hostLocale = loc;
  } catch (e) {}
  if (!hostLocale) {
    try {
      const langs = await $metrix.system("app.languages");
      if (Array.isArray(langs) && langs.length) hostLocale = String(langs[0]);
    } catch (e) {}
  }
}

function currentLang() {
  const candidates = [
    hostLocale,
    ...(typeof navigator !== "undefined" && Array.isArray(navigator.languages) ? navigator.languages : []),
    typeof navigator !== "undefined" ? navigator.language : "",
  ];
  for (const c of candidates) {
    const lc = String(c || "").toLowerCase();
    if (lc.startsWith("zh")) return "zh";
    if (lc.startsWith("en")) return "en";
  }
  return "zh";
}

function T() {
  return I18N[currentLang()];
}

// ---------------------------------------------------------------------------
// Formatting helpers
// ---------------------------------------------------------------------------

const num = (v, d = 0) => {
  const n = Number(v);
  return Number.isFinite(n) ? n : d;
};
const str = v => (typeof v === "string" ? v.trim() : "");
const clampPct = v => Math.max(0, Math.min(100, num(v, 0)));
const pctText = v => `${Math.round(clampPct(v))}%`;
const pctFixed = (v, d = 2) => `${clampPct(v).toFixed(d)}%`;
const levelColor = v => (v >= 90 ? K.down : v >= 70 ? K.warn : K.accent);

function splitBytes(bytes, decimals = 2) {
  const b = Math.max(0, num(bytes, 0));
  if (b === 0) return { num: "0", unit: "B" };
  const units = ["B", "KB", "MB", "GB", "TB", "PB"];
  const i = Math.min(units.length - 1, Math.floor(Math.log(b) / Math.log(1024)));
  const val = b / Math.pow(1024, i);
  const fixed = i === 0 ? val.toFixed(0) : val >= 100 ? val.toFixed(0) : val >= 10 ? val.toFixed(Math.min(decimals, 1)) : val.toFixed(decimals);
  return { num: fixed, unit: units[i] };
}

function formatBytes(bytes, decimals = 2) {
  const s = splitBytes(bytes, decimals);
  return `${s.num} ${s.unit}`;
}

function splitRate(bytesPerSec, decimals = 2) {
  const b = Math.max(0, num(bytesPerSec, 0));
  if (b < 1024) return { num: String(Math.round(b)), unit: "B/s" };
  const units = ["B/s", "KB/s", "MB/s", "GB/s", "TB/s"];
  const i = Math.min(units.length - 1, Math.floor(Math.log(b) / Math.log(1024)));
  const val = b / Math.pow(1024, i);
  const fixed = val >= 100 ? val.toFixed(0) : val >= 10 ? val.toFixed(1) : val.toFixed(decimals);
  return { num: fixed, unit: units[i] };
}

function formatRate(bytesPerSec, compactMode = false) {
  const b = Math.max(0, num(bytesPerSec, 0));
  if (b < 1024) return compactMode ? `${Math.round(b)}B/s` : `${Math.round(b)} B/s`;
  const units = compactMode ? ["B/s", "K/s", "M/s", "G/s", "T/s"] : ["B/s", "KB/s", "MB/s", "GB/s", "TB/s"];
  const i = Math.min(units.length - 1, Math.floor(Math.log(b) / Math.log(1024)));
  const val = b / Math.pow(1024, i);
  const fixed = val >= 100 ? val.toFixed(0) : val.toFixed(1).replace(/\.0$/, "");
  return compactMode ? `${fixed}${units[i]}` : `${fixed} ${units[i]}`;
}

function formatUptimeDays(seconds) {
  const s = Math.max(0, Math.floor(num(seconds, 0)));
  if (!s) return "—";
  const zh = currentLang() === "zh";
  const days = Math.floor(s / 86400);
  const hours = Math.floor((s % 86400) / 3600);
  if (days > 0) return zh ? `${days} 天` : `${days}d`;
  if (hours > 0) return zh ? `${hours} 小时` : `${hours}h`;
  return zh ? `${Math.max(1, Math.floor(s / 60))} 分钟` : `${Math.max(1, Math.floor(s / 60))}m`;
}

function formatUptime(seconds) {
  const s = Math.max(0, Math.floor(num(seconds, 0)));
  if (!s) return "—";
  const days = Math.floor(s / 86400);
  const hours = Math.floor((s % 86400) / 3600);
  const mins = Math.floor((s % 3600) / 60);
  if (days > 0) return `${days}d ${hours}h`;
  if (hours > 0) return `${hours}h ${mins}m`;
  return `${Math.max(1, mins)}m`;
}

function formatAge(iso) {
  if (!iso) return "";
  const t = typeof iso === "number" ? iso : Date.parse(String(iso));
  if (!Number.isFinite(t)) return "";
  const sec = Math.max(0, Math.floor((Date.now() - t) / 1000));
  const zh = currentLang() === "zh";
  if (sec < 60) return zh ? `${sec}秒前` : `${sec}s ago`;
  if (sec < 3600) return zh ? `${Math.floor(sec / 60)}分钟前` : `${Math.floor(sec / 60)}m ago`;
  if (sec < 86400) return zh ? `${Math.floor(sec / 3600)}小时前` : `${Math.floor(sec / 3600)}h ago`;
  return zh ? `${Math.floor(sec / 86400)}天前` : `${Math.floor(sec / 86400)}d ago`;
}

function calcDaysLeft(iso) {
  if (!iso) return null;
  const ts = Date.parse(String(iso));
  if (!Number.isFinite(ts) || ts <= 0) return null;
  return Math.ceil((ts - Date.now()) / 86400000);
}

function formatPricePill(node) {
  if (!node || !Number.isFinite(node.price) || node.price <= 0) return "";
  const t = T();
  const cur = str(node.currency) || "$";
  const cycle = num(node.billingCycle, 30);
  let unit = t.cycleMonth;
  if (cycle >= 360 && cycle <= 370) unit = t.cycleYear;
  else if (cycle >= 175 && cycle <= 190) unit = t.cycleHalfYear;
  else if (cycle >= 85 && cycle <= 95) unit = t.cycleQuarter;
  else if (cycle !== 30 && cycle !== 31 && cycle > 0) unit = t.cycleDays(cycle);
  const priceStr = node.price.toFixed(2);
  return `${cur}${priceStr}${unit}`;
}

function calcTrafficUsed(status, limitType) {
  const up = num(status && status.totalUp, 0);
  const down = num(status && status.totalDown, 0);
  switch (str(limitType).toLowerCase()) {
    case "up": return up;
    case "down": return down;
    case "min": return Math.min(up, down);
    case "sum": return up + down;
    case "max":
    default:
      return Math.max(up, down);
  }
}

// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------

let baseURL = "";
let apiKey = "";
let offlineNotify = true;
let refreshSec = 5;
let trayFormat = "online_total";
let inputErr = "";
let siteName = "";
let serverVersion = "";
let defaultPingTaskIds = [];
let nodePingTaskIdsMap = {};

let nodes = [];
let rateHistory = new Map(); // uuid -> [{ts, up, down}] (up to 36 samples)
let seededHistory = false;
let onlineSet = new Set();
let hadSnapshot = false;

let selectedGroup = localStorage.getItem("komari.group") || "all";
let sortBy = localStorage.getItem("komari.sort") || "weight";
if (!["weight", "cpu", "ram", "net"].includes(sortBy)) sortBy = "weight";

let selectedUuid = null;
let infoExpanded = true;
let infoSection = localStorage.getItem("komari.infoSec") || "sys";
if (!["sys", "res", "net"].includes(infoSection)) infoSection = "sys";
let detailTab = localStorage.getItem("komari.detailTab") || "load";
if (!["load", "ping"].includes(detailTab)) detailTab = "load";
let hiddenPingTasks = new Set();
let detailSpan = localStorage.getItem("komari.detailSpan") || "realtime";
if (!["realtime", "1h", "4h", "24h"].includes(detailSpan)) detailSpan = "realtime";
let detailCache = new Map();

let loading = false;
let loadedAt = 0;
let error = "";
let inflight = null;

function parseBaseURL(raw) {
  const s = str(raw).replace(/\/+$/, "");
  if (!s) return { url: "", err: "" };
  try {
    const u = new URL(s);
    if (u.protocol !== "https:" && u.protocol !== "http:") {
      return { url: "", err: "Komari Server URL must use https:// or authorized local http://." };
    }
    if (u.hostname === "status.example.com") {
      return { url: "", err: "" };
    }
    return { url: u.origin + u.pathname.replace(/\/+$/, ""), err: "" };
  } catch (e) {
    return { url: "", err: "Invalid Komari Server URL. Example: https://status.example.com" };
  }
}

function readSecret(name) {
  try {
    return str($metrix.secret(name));
  } catch (e) {
    return "";
  }
}

function redact(msg) {
  const text = String(msg || "");
  return (apiKey ? text.split(apiKey).join("•••") : text).slice(0, 220);
}

function syncInputs(env) {
  const inputs = (env && env.inputs) || {};
  const parsed = parseBaseURL(inputs.baseURL);
  const nextKey = readSecret("apiKey");
  offlineNotify = inputs.offlineNotify !== false;
  const nextSec = Math.max(2, num(inputs.refreshInterval, 5));
  if (nextSec !== refreshSec) {
    refreshSec = nextSec;
    try {
      $metrix.schedule(refreshSec * 1000);
    } catch (e) {}
  }
  const nextTrayFmt = str(inputs.trayFormat) || "online_total";
  if (["online_total", "total", "online_both", "online"].includes(nextTrayFmt)) {
    trayFormat = nextTrayFmt;
  }
  const sig = `${parsed.url}\n${parsed.err}\n${nextKey}`;
  if (sig === syncInputs.sig) return;
  syncInputs.sig = sig;
  baseURL = parsed.url;
  inputErr = parsed.err;
  apiKey = nextKey;
  siteName = "";
  serverVersion = "";
  defaultPingTaskIds = [];
  nodePingTaskIdsMap = {};
  nodes = [];
  rateHistory.clear();
  seededHistory = false;
  onlineSet = new Set();
  hadSnapshot = false;
  selectedUuid = null;
  detailCache.clear();
  error = "";
  loadedAt = 0;
}

// ---------------------------------------------------------------------------
// Komari API (JSON-RPC /api/rpc2 + REST fallback)
// ---------------------------------------------------------------------------

function authHeaders(extra) {
  const headers = { Accept: "application/json", ...(extra || {}) };
  if (apiKey) headers.Authorization = `Bearer ${apiKey}`;
  return headers;
}

async function fetchJSON(path, options) {
  const res = await fetch(baseURL + path, {
    ...(options || {}),
    headers: authHeaders(options && options.headers),
  });
  const text = await res.text();
  let data = null;
  try {
    data = text ? JSON.parse(text) : null;
  } catch (e) {
    data = null;
  }
  if (!res.ok) {
    if (res.status === 401) throw new Error(apiKey ? "API key was rejected by Komari (401)." : "Authentication required. Add an API Key in settings.");
    if (res.status === 403) throw new Error("Access denied by Komari (403).");
    const msg = data && (data.message || (data.error && data.error.message));
    throw new Error(redact(msg || `Komari HTTP ${res.status}`));
  }
  if (data && data.status === "error") {
    const msg = str(data.message) || "Komari returned an error.";
    if (msg.toLowerCase().includes("private site")) {
      throw new Error("Private site enabled. Please configure an API Key in dashboard inputs.");
    }
    throw new Error(redact(msg));
  }
  return data;
}

async function rpcCall(calls) {
  const payload = calls.map((c, idx) => ({
    jsonrpc: "2.0",
    method: c.method,
    params: c.params || {},
    id: idx + 1,
  }));
  const raw = await fetchJSON("/api/rpc2", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload),
  });
  if (!Array.isArray(raw)) throw new Error("Invalid JSON-RPC batch response.");
  const byId = new Map(raw.map(item => [item && item.id, item]));
  return calls.map((_, idx) => byId.get(idx + 1) || null);
}

function normalizeClient(c) {
  if (!c || typeof c !== "object" || !str(c.uuid)) return null;
  return {
    uuid: str(c.uuid),
    name: str(c.name) || str(c.uuid).slice(0, 8),
    region: str(c.region),
    group: str(c.group),
    tags: str(c.tags)
      .split(/[;,]/)
      .map(s => s.trim())
      .filter(Boolean),
    os: str(c.os),
    kernel: str(c.kernel_version),
    arch: str(c.arch),
    virt: str(c.virtualization),
    cpuName: str(c.cpu_name),
    cpuCores: num(c.cpu_cores, 0),
    gpuName: str(c.gpu_name),
    memTotal: num(c.mem_total, 0),
    swapTotal: num(c.swap_total, 0),
    diskTotal: num(c.disk_total, 0),
    trafficLimit: num(c.traffic_limit, 0),
    trafficLimitType: str(c.traffic_limit_type) || "max",
    weight: num(c.weight, 0),
    price: num(c.price, 0),
    billingCycle: num(c.billing_cycle, 30),
    currency: str(c.currency) || "$",
    hidden: c.hidden === true,
    expiredAt: c.expired_at ? str(c.expired_at) : "",
    ipv4: str(c.ipv4),
    ipv6: str(c.ipv6),
    version: str(c.version),
  };
}

function extractPingList(rawPing, uuid) {
  if (!rawPing || typeof rawPing !== "object") return [];
  const entries = Object.entries(rawPing)
    .map(([k, v]) => {
      if (!v || typeof v !== "object") return null;
      return {
        id: String(k),
        name: str(v.name) || `#${k}`,
        latest: num(v.latest, -1),
        avg: num(v.avg, 0),
        loss: num(v.loss, 0),
      };
    })
    .filter(Boolean);
  if (!entries.length) return [];

  const byId = new Map(entries.map(e => [e.id, e]));
  const preferredIds =
    (nodePingTaskIdsMap && Array.isArray(nodePingTaskIdsMap[uuid]) && nodePingTaskIdsMap[uuid]) ||
    (Array.isArray(defaultPingTaskIds) && defaultPingTaskIds.length ? defaultPingTaskIds : null);

  if (preferredIds) {
    const picked = preferredIds.map(id => byId.get(String(id))).filter(Boolean);
    if (picked.length > 0) return picked.slice(0, 3);
  }
  return entries.slice(0, 3);
}

function normalizeStatus(s, client) {
  if (!s || typeof s !== "object") {
    return {
      online: false,
      cpu: 0,
      ramUsed: 0,
      ramTotal: client.memTotal,
      ramPct: 0,
      swapUsed: 0,
      swapTotal: client.swapTotal,
      diskUsed: 0,
      diskTotal: client.diskTotal,
      diskPct: 0,
      load1: 0,
      load5: 0,
      load15: 0,
      netUp: 0,
      netDown: 0,
      totalUp: 0,
      totalDown: 0,
      tcp: 0,
      udp: 0,
      process: 0,
      uptime: 0,
      temp: 0,
      pings: [],
      updatedAt: "",
    };
  }
  const cpuVal = typeof s.cpu === "object" && s.cpu !== null ? num(s.cpu.usage, 0) : num(s.cpu, 0);
  const ramUsed = typeof s.ram === "object" && s.ram !== null ? num(s.ram.used, 0) : num(s.ram, 0);
  const ramTotal =
    (typeof s.ram === "object" && s.ram !== null ? num(s.ram.total, 0) : num(s.ram_total, 0)) || client.memTotal;
  const swapUsed = typeof s.swap === "object" && s.swap !== null ? num(s.swap.used, 0) : num(s.swap, 0);
  const swapTotal =
    (typeof s.swap === "object" && s.swap !== null ? num(s.swap.total, 0) : num(s.swap_total, 0)) || client.swapTotal;
  const diskUsed = typeof s.disk === "object" && s.disk !== null ? num(s.disk.used, 0) : num(s.disk, 0);
  const diskTotal =
    (typeof s.disk === "object" && s.disk !== null ? num(s.disk.total, 0) : num(s.disk_total, 0)) || client.diskTotal;

  const loadObj = typeof s.load === "object" && s.load !== null ? s.load : null;
  const load1 = loadObj ? num(loadObj.load1, 0) : num(s.load1 !== undefined ? s.load1 : s.load, 0);
  const load5 = loadObj ? num(loadObj.load5, 0) : num(s.load5, 0);
  const load15 = loadObj ? num(loadObj.load15, 0) : num(s.load15, 0);

  const netObj = typeof s.network === "object" && s.network !== null ? s.network : null;
  const netUp = netObj ? num(netObj.up, 0) : num(s.net_out, 0);
  const netDown = netObj ? num(netObj.down, 0) : num(s.net_in, 0);
  const totalUp = netObj ? num(netObj.totalUp !== undefined ? netObj.totalUp : netObj.total_up, 0) : num(s.net_total_up, 0);
  const totalDown = netObj ? num(netObj.totalDown !== undefined ? netObj.totalDown : netObj.total_down, 0) : num(s.net_total_down, 0);

  const connObj = typeof s.connections === "object" && s.connections !== null ? s.connections : null;
  const tcp = connObj ? num(connObj.tcp, 0) : num(s.connections, 0);
  const udp = connObj ? num(connObj.udp, 0) : num(s.connections_udp, 0);

  const updatedAt = str(s.updated_at || s.time || "");
  let online = false;
  if (typeof s.online === "boolean") {
    online = s.online;
  } else if (typeof s.status === "string") {
    online = s.status.toLowerCase() === "online";
  } else if (updatedAt) {
    const ts = Date.parse(updatedAt);
    online = Number.isFinite(ts) ? Date.now() - ts < 180e3 : true;
  } else {
    online = cpuVal > 0 || ramUsed > 0 || num(s.uptime, 0) > 0;
  }

  return {
    online,
    cpu: clampPct(cpuVal),
    ramUsed,
    ramTotal,
    ramPct: ramTotal > 0 ? clampPct((ramUsed / ramTotal) * 100) : 0,
    swapUsed,
    swapTotal,
    diskUsed,
    diskTotal,
    diskPct: diskTotal > 0 ? clampPct((diskUsed / diskTotal) * 100) : 0,
    load1,
    load5,
    load15,
    netUp,
    netDown,
    totalUp,
    totalDown,
    tcp,
    udp,
    process: num(s.process, 0),
    uptime: num(s.uptime, 0),
    temp: num(s.temp, 0),
    pings: extractPingList(s.ping, client.uuid),
    updatedAt,
  };
}

function applyPublicInfo(pubInfo) {
  if (!pubInfo || typeof pubInfo !== "object") return;
  if (str(pubInfo.sitename)) siteName = str(pubInfo.sitename);
  const ts = pubInfo.theme_settings;
  if (ts && typeof ts === "object") {
    if (Array.isArray(ts.homepageMultiPingTaskIds)) {
      defaultPingTaskIds = ts.homepageMultiPingTaskIds;
    }
    if (ts.homepageMultiPingNodeTaskIds && typeof ts.homepageMultiPingNodeTaskIds === "object") {
      nodePingTaskIdsMap = ts.homepageMultiPingNodeTaskIds;
    }
  }
}

function extractClientList(raw) {
  if (!raw) return [];
  const target = raw.data !== undefined && !raw.uuid ? raw.data : raw;
  if (Array.isArray(target)) return target.map(normalizeClient).filter(Boolean);
  if (typeof target === "object" && target !== null) {
    if (target.uuid) {
      const single = normalizeClient(target);
      return single ? [single] : [];
    }
    return Object.values(target).map(normalizeClient).filter(Boolean);
  }
  return [];
}

async function fetchClusterViaRPC() {
  const calls = [
    { method: apiKey ? "admin:listClients" : "common:getNodes", params: {} },
    { method: "common:getNodesLatestStatus", params: {} },
    { method: "common:getPublicInfo", params: {} },
    { method: "common:getVersion", params: {} },
  ];
  const res = await rpcCall(calls);
  let clientRes = res[0];
  if (clientRes && clientRes.error && apiKey) {
    const fallback = await rpcCall([{ method: "common:getNodes", params: {} }]);
    clientRes = fallback[0];
  }
  if (!clientRes || clientRes.error) {
    const errMsg = clientRes && clientRes.error && clientRes.error.message;
    throw new Error(errMsg || "RPC getNodes failed");
  }
  const pubInfo = (res[2] && !res[2].error && res[2].result) || {};
  const verInfo = (res[3] && !res[3].error && res[3].result) || {};
  applyPublicInfo(pubInfo);
  if (verInfo && str(verInfo.version)) serverVersion = str(verInfo.version);

  const clientList = extractClientList(clientRes.result);
  const statusMap = (res[1] && !res[1].error && res[1].result) || {};

  const onlineArr = Array.isArray(statusMap.online) ? new Set(statusMap.online) : null;
  const statusEntries = statusMap.data && typeof statusMap.data === "object" ? statusMap.data : statusMap;

  return clientList.map(c => {
    const rawSt = statusEntries[c.uuid] || null;
    const st = normalizeStatus(rawSt, c);
    if (onlineArr) st.online = onlineArr.has(c.uuid);
    return { ...c, status: st };
  });
}

async function fetchClusterViaREST() {
  const [pubRes, verRes, nodesRes] = await Promise.allSettled([
    fetchJSON("/api/public"),
    fetchJSON("/api/version"),
    apiKey ? fetchJSON("/api/admin/client/list").catch(() => fetchJSON("/api/nodes")) : fetchJSON("/api/nodes"),
  ]);
  if (pubRes.status === "fulfilled" && pubRes.value && pubRes.value.data) {
    applyPublicInfo(pubRes.value.data);
  }
  if (verRes.status === "fulfilled" && verRes.value && verRes.value.data && str(verRes.value.data.version)) {
    serverVersion = str(verRes.value.data.version);
  }
  if (nodesRes.status === "rejected") throw nodesRes.reason;
  const clientList = extractClientList(nodesRes.value);

  const merged = [];
  for (let i = 0; i < clientList.length; i += 4) {
    const batch = clientList.slice(i, i + 4);
    const settled = await Promise.allSettled(
      batch.map(c => fetchJSON(`/api/recent/${encodeURIComponent(c.uuid)}`))
    );
    for (let j = 0; j < batch.length; j++) {
      const c = batch[j];
      const r = settled[j];
      let latest = null;
      if (r.status === "fulfilled" && r.value) {
        const arr = Array.isArray(r.value.data) ? r.value.data : Array.isArray(r.value) ? r.value : [];
        if (arr.length > 0) latest = arr[arr.length - 1];
      }
      merged.push({ ...c, status: normalizeStatus(latest, c) });
    }
  }
  return merged;
}

function checkOfflineTransitions(nextNodes) {
  const t = T();
  const nextOnline = new Set();
  for (const n of nextNodes) {
    if (n.status.online) {
      nextOnline.add(n.uuid);
    } else if (hadSnapshot && offlineNotify && onlineSet.has(n.uuid)) {
      $metrix.notify(t.offlineAlertTitle, t.offlineAlertBody(n.name, n.region));
    }
  }
  onlineSet = nextOnline;
  hadSnapshot = true;
}

const BAR_SLOTS = 60;

function appendRateSamples(list) {
  const now = Date.now();
  for (const n of list) {
    if (!n.status.online) continue;
    const arr = rateHistory.get(n.uuid) || [];
    arr.push({ ts: now, up: n.status.netUp, down: n.status.netDown });
    if (arr.length > BAR_SLOTS) arr.splice(0, arr.length - BAR_SLOTS);
    rateHistory.set(n.uuid, arr);
  }
}

async function seedRecentHistory(list) {
  const onlineNodes = list.filter(n => n.status.online);
  for (let i = 0; i < onlineNodes.length; i += 4) {
    const batch = onlineNodes.slice(i, i + 4);
    const settled = await Promise.allSettled(
      batch.map(n => fetchJSON(`/api/records/load?uuid=${encodeURIComponent(n.uuid)}&hours=1`))
    );
    for (let j = 0; j < batch.length; j++) {
      const n = batch[j];
      const r = settled[j];
      if (r.status === "fulfilled" && r.value) {
        const d = r.value.data !== undefined ? r.value.data : r.value;
        const rawArr = Array.isArray(d && d.records) ? d.records : Array.isArray(d) ? d : [];
        if (rawArr.length > 0) {
          const pts = rawArr.slice(-BAR_SLOTS).map(item => ({
            ts: Date.parse(str(item.time || item.updated_at)) || Date.now(),
            up: Math.max(0, num(item.net_out !== undefined ? item.net_out : item.network && item.network.up, 0)),
            down: Math.max(0, num(item.net_in !== undefined ? item.net_in : item.network && item.network.down, 0)),
          }));
          // Append the latest live sample from status if newer
          pts.push({ ts: Date.now(), up: n.status.netUp, down: n.status.netDown });
          if (pts.length > BAR_SLOTS) pts.splice(0, pts.length - BAR_SLOTS);
          rateHistory.set(n.uuid, pts);
        }
      }
    }
  }
  $metrix.invalidate();
}

async function loadCluster() {
  let list;
  try {
    list = await fetchClusterViaRPC();
  } catch (rpcErr) {
    const msg = String((rpcErr && rpcErr.message) || rpcErr);
    if (msg.includes("401") || msg.includes("403") || msg.toLowerCase().includes("private site")) {
      throw rpcErr;
    }
    list = await fetchClusterViaREST();
  }
  checkOfflineTransitions(list);
  appendRateSamples(list);
  nodes = list;
  if (!seededHistory && list.length > 0) {
    seededHistory = true;
    void seedRecentHistory(list);
  }
  if (selectedUuid && !nodes.some(n => n.uuid === selectedUuid)) {
    selectedUuid = null;
  }
}

function detailCacheKey(uuid, span) {
  return `${uuid}:${span || detailSpan}`;
}

function spanHours(span) {
  if (span === "24h") return 24;
  if (span === "4h") return 4;
  return 1;
}

async function loadNodeDetail(uuid, span = detailSpan) {
  if (!baseURL || !uuid) return;
  const key = detailCacheKey(uuid, span);
  const prev = detailCache.get(key) || { loadRecords: [], pingRecords: [], pingTasks: [], loadedAt: 0 };
  detailCache.set(key, { ...prev, loading: true, error: "" });
  $metrix.invalidate();

  const hrs = spanHours(span);
  const loadUrl =
    span === "realtime"
      ? `/api/recent/${encodeURIComponent(uuid)}`
      : `/api/records/load?uuid=${encodeURIComponent(uuid)}&hours=${hrs}`;
  const pingUrl = `/api/records/ping?uuid=${encodeURIComponent(uuid)}&hours=${hrs}`;

  try {
    const [loadRes, pingRes] = await Promise.allSettled([
      fetchJSON(loadUrl),
      fetchJSON(pingUrl),
    ]);

    let loadRecords = prev.loadRecords;
    let pingRecords = prev.pingRecords;
    let pingTasks = prev.pingTasks;
    let errText = "";

    if (loadRes.status === "fulfilled" && loadRes.value) {
      const d = loadRes.value.data !== undefined ? loadRes.value.data : loadRes.value;
      if (Array.isArray(d && d.records)) loadRecords = d.records;
      else if (Array.isArray(d)) loadRecords = d;
    } else if (loadRes.status === "rejected") {
      errText = String((loadRes.reason && loadRes.reason.message) || loadRes.reason);
    }

    if (pingRes.status === "fulfilled" && pingRes.value) {
      const d = pingRes.value.data !== undefined ? pingRes.value.data : pingRes.value;
      if (Array.isArray(d && d.records)) pingRecords = d.records;
      if (Array.isArray(d && d.tasks)) pingTasks = d.tasks;
    }

    detailCache.set(key, {
      loadRecords,
      pingRecords,
      pingTasks,
      loadedAt: Date.now(),
      loading: false,
      error: errText,
    });
  } catch (e) {
    detailCache.set(key, {
      ...prev,
      loading: false,
      error: redact((e && e.message) || e),
    });
  }
  $metrix.invalidate();
}

function refresh() {
  if (!baseURL) return Promise.resolve();
  if (inflight) return inflight;
  loading = true;
  $metrix.invalidate();
  inflight = loadCluster()
    .then(() => {
      error = "";
      loadedAt = Date.now();
      if (selectedUuid) {
        const ck = detailCacheKey(selectedUuid, detailSpan);
        const ce = detailCache.get(ck);
        if (!ce || Date.now() - ce.loadedAt >= 30e3) return loadNodeDetail(selectedUuid, detailSpan);
      }
    })
    .catch(e => {
      error = redact((e && e.message) || e);
    })
    .finally(() => {
      inflight = null;
      loading = false;
      $metrix.invalidate();
    });
  return inflight;
}

const launchRefresh = () => {
  void refresh();
};

function selectNode(uuid) {
  selectedUuid = uuid;
  const cached = detailCache.get(detailCacheKey(uuid, detailSpan));
  $metrix.invalidate();
  if (!cached || Date.now() - cached.loadedAt > 30e3) {
    return loadNodeDetail(uuid, detailSpan);
  }
}

// ---------------------------------------------------------------------------
// Derived Cluster Metrics & Filtering
// ---------------------------------------------------------------------------

function clusterStats() {
  const total = nodes.length;
  let online = 0;
  let netUp = 0;
  let netDown = 0;
  let totalUp = 0;
  let totalDown = 0;
  let cpuSum = 0;
  let ramUsedSum = 0;
  let ramTotalSum = 0;

  for (const n of nodes) {
    const st = n.status;
    if (st.online) {
      online++;
      netUp += st.netUp;
      netDown += st.netDown;
      cpuSum += st.cpu;
      ramUsedSum += st.ramUsed;
      ramTotalSum += st.ramTotal;
    }
    totalUp += st.totalUp;
    totalDown += st.totalDown;
  }

  const avgCpu = online > 0 ? cpuSum / online : 0;
  const avgRam = ramTotalSum > 0 ? (ramUsedSum / ramTotalSum) * 100 : 0;

  return { total, online, offline: total - online, netUp, netDown, totalUp, totalDown, avgCpu, avgRam };
}

function groupOptions() {
  const t = T();
  const set = new Set();
  for (const n of nodes) {
    if (n.group) set.add(n.group);
  }
  const groups = Array.from(set).sort();
  return [{ label: t.allGroup(nodes.length), value: "all" }].concat(
    groups.slice(0, 4).map(g => ({ label: g, value: g }))
  );
}

function sortOptions() {
  const t = T();
  return [
    { label: t.sortWeight, value: "weight" },
    { label: t.sortCpu, value: "cpu" },
    { label: t.sortRam, value: "ram" },
    { label: t.sortNet, value: "net" },
  ];
}

function visibleNodes() {
  const validGroups = new Set(nodes.map(n => n.group).filter(Boolean));
  const activeGroup = selectedGroup !== "all" && validGroups.has(selectedGroup) ? selectedGroup : "all";
  const filtered = activeGroup === "all" ? nodes.slice() : nodes.filter(n => n.group === activeGroup);

  filtered.sort((a, b) => {
    if (a.status.online !== b.status.online) return a.status.online ? -1 : 1;
    if (sortBy === "cpu") return b.status.cpu - a.status.cpu;
    if (sortBy === "ram") return b.status.ramPct - a.status.ramPct;
    if (sortBy === "net") return b.status.netDown + b.status.netUp - (a.status.netDown + a.status.netUp);
    if (a.weight !== b.weight) return a.weight - b.weight;
    return a.name.localeCompare(b.name);
  });
  return filtered;
}

// ---------------------------------------------------------------------------
// UI Components
// ---------------------------------------------------------------------------

const bone = (w, hgt, extra) =>
  h("Box", {
    ...extra,
    tw: `w-[${w}px] h-[${hgt}px] rounded bg-surfaceHover shrink-0 ${(extra && extra.tw) || ""}`,
  });

function IconButton(name, label, onClick, busy, key) {
  return h(
    "Column",
    {
      key,
      tw: "w-7 h-7 items-center justify-center rounded-[7px] shrink-0 cursor-pointer hover:bg-surfaceHover pressed:bg-surfacePressed",
      label,
      tooltip: label,
      onClick,
    },
    Icon(
      name,
      15,
      K.muted,
      busy
        ? {
            keyframes: {
              duration: 900,
              repeat: -1,
              ease: "linear",
              frames: [
                { at: 0, rotate: 0 },
                { at: 1, rotate: 360 },
              ],
            },
          }
        : null
    )
  );
}

function Header() {
  const t = T();
  const stats = clusterStats();
  const activeNode = selectedUuid ? nodes.find(n => n.uuid === selectedUuid) : null;
  const titleText = activeNode
    ? activeNode.name
    : siteName || (baseURL ? new URL(baseURL).host : "Komari");
  const allOnline = stats.total > 0 && stats.offline === 0;

  return h(
    "Column",
    { tw: "w-full shrink-0" },
    h(
      "Row",
      { tw: "gap-2 pt-3 pr-3 pb-2.5 pl-4 items-center w-full min-w-0" },
      activeNode
        ? IconButton("back", t.backToList, () => {
            selectedUuid = null;
            $metrix.invalidate();
          }, false, "btn-back")
        : Icon(isDarkTheme() ? "brand" : "brandLight", 18, "text"),
      activeNode && activeNode.region
        ? TX(activeNode.region, { tw: "text-[14px] shrink-0 leading-none" })
        : null,
      TX(titleText, {
        tw: "text-sm font-bold truncate min-w-0 shrink",
      }),
      activeNode
        ? h("Badge", {
            text: activeNode.status.online ? t.online : t.offline,
            textColor: activeNode.status.online ? K.up : K.down,
            background: K.hover,
          })
        : stats.total > 0
        ? h("Badge", {
            text: t.onlineBadge(stats.online, stats.total, stats.offline),
            textColor: allOnline ? K.up : K.warn,
            background: K.hover,
          })
        : null,
      h("Spacer"),
      baseURL ? IconButton("refresh", t.refresh, launchRefresh, loading, "btn-refresh") : null,
      baseURL
        ? IconButton("external", t.openKomari, () => $metrix.openURL(baseURL), false, "btn-open")
        : null
    ),
    h("Divider")
  );
}

function Problem(title, detail, retry) {
  const t = T();
  return h(
    "Column",
    { tw: "grow items-center justify-center gap-2 py-8 px-8" },
    Icon("alert", 22, K.down),
    TX(title, { tw: "text-sm font-semibold text-center" }),
    TX(detail, { tw: "text-xs text-textMuted text-center leading-[1.35]" }),
    retry
      ? h("Row", { tw: "mt-1.5" }, h("Button", { key: "btn-retry", onClick: launchRefresh }, t.retry))
      : null
  );
}

function SetupGuide() {
  const t = T();
  return h(
    "Column",
    { tw: "grow items-center justify-center gap-2.5 py-8 px-8" },
    h(
      "Column",
      { tw: "w-11 h-11 rounded-xl bg-accent items-center justify-center mb-1" },
      Icon("brand", 24, "accentText")
    ),
    TX(t.setupTitle, { tw: "text-base font-semibold text-center" }),
    TX(t.setupDesc, { tw: "text-xs text-textMuted text-center leading-[1.4]" })
  );
}

function Banner() {
  const t = T();
  if (!error) return null;
  return h(
    "Row",
    { tw: "gap-2 py-2 px-2.5 rounded-lg bg-surfaceHover items-center w-full min-w-0" },
    Icon("alert", 14, K.down),
    TX(error, { tw: "text-xs min-w-0 shrink grow leading-[1.3]" }),
    h(
      "Row",
      {
        tw: "py-0.75 px-2 rounded-[5px] cursor-pointer shrink-0 hover:bg-surfacePressed",
        label: t.retry,
        onClick: launchRefresh,
      },
      TX(t.retry, { tw: "text-xs font-medium" })
    )
  );
}

function ClusterSummary() {
  const t = T();
  const s = clusterStats();

  const segCount = Math.min(Math.max(s.total, 1), 10);
  const onlineSegs = s.total > 0 ? Math.round((s.online / s.total) * segCount) : 0;
  const segments = [];
  for (let i = 0; i < segCount; i++) {
    const isOn = i < onlineSegs;
    segments.push(
      h("Box", {
        key: `seg-${i}`,
        tw: `h-1.5 rounded-[2px] grow basis-0 bg-${isOn ? "[#52b788]" : K.down}`,
      })
    );
  }

  const totalRate = s.netUp + s.netDown;
  const bwSplit = splitRate(totalRate, 2);

  const totalBytes = s.totalUp + s.totalDown;
  const tfSplit = splitBytes(totalBytes, 2);

  return h(
    "Grid",
    { tw: "grid-cols-3 gap-2 w-full min-w-0" },
    // Card 1: Online Nodes
    h(
      "Column",
      {
        tw: "justify-between gap-2 py-2.5 px-3 rounded-xl border border-border min-w-0",
        linearGradient: { from: "#10b98118", to: isDarkTheme() ? "surface" : "background", angle: 135 },
      },
      h(
        "Row",
        { tw: "items-center w-full min-w-0" },
        TX(t.onlineNodes, { tw: "text-[11px] font-medium text-textMuted truncate min-w-0 shrink grow" }),
        Icon("server", 12, K.muted)
      ),
      h(
        "Row",
        { tw: "items-end gap-1 min-w-0" },
        TX(String(s.online), {
          tw: "text-xl font-bold tabular-nums leading-none",
          contentTransition: { numeric: true },
        }),
        TX(`/ ${s.total}`, { tw: "text-[11px] font-medium text-textMuted tabular-nums" })
      ),
      h("Row", { tw: "gap-0.75 items-center w-full h-3.5" }, segments)
    ),
    // Card 2: Live Bandwidth
    h(
      "Column",
      {
        tw: "justify-between gap-2 py-2.5 px-3 rounded-xl border border-border min-w-0",
        linearGradient: { from: "#f59e0b18", to: isDarkTheme() ? "surface" : "background", angle: 135 },
        tooltip: `↑ ${formatRate(s.netUp)} · ↓ ${formatRate(s.netDown)}`,
      },
      h(
        "Row",
        { tw: "items-center w-full min-w-0" },
        TX(t.liveBandwidth, { tw: "text-[11px] font-medium text-textMuted truncate min-w-0 shrink grow" }),
        Icon("activity", 12, K.muted)
      ),
      h(
        "Row",
        { tw: "items-end gap-1 min-w-0" },
        TX(bwSplit.num, {
          tw: "text-xl font-bold text-[#e07a2f] tabular-nums leading-none truncate",
          contentTransition: { numeric: true },
        }),
        TX(bwSplit.unit, { tw: "text-[10px] font-semibold text-textMuted shrink-0" })
      ),
      TX(`↑ ${formatRate(s.netUp, true)} · ↓ ${formatRate(s.netDown, true)}`, {
        tw: "text-[10px] text-textMuted tabular-nums truncate w-full",
      })
    ),
    // Card 3: Total Traffic
    h(
      "Column",
      {
        tw: "justify-between gap-2 py-2.5 px-3 rounded-xl border border-border min-w-0",
        linearGradient: { from: "#8b5cf618", to: isDarkTheme() ? "surface" : "background", angle: 135 },
        tooltip: `↑ ${formatBytes(s.totalUp, 2)} · ↓ ${formatBytes(s.totalDown, 2)}`,
      },
      h(
        "Row",
        { tw: "items-center w-full min-w-0" },
        TX(t.totalTraffic, { tw: "text-[11px] font-medium text-textMuted truncate min-w-0 shrink grow" }),
        Icon("barchart", 12, K.muted)
      ),
      h(
        "Row",
        { tw: "items-end gap-1 min-w-0" },
        TX(tfSplit.num, {
          tw: "text-xl font-bold tabular-nums leading-none truncate",
          contentTransition: { numeric: true },
        }),
        TX(tfSplit.unit, { tw: "text-[10px] font-semibold text-textMuted shrink-0" })
      ),
      TX(`↑ ${formatBytes(s.totalUp, 1)} · ↓ ${formatBytes(s.totalDown, 1)}`, {
        tw: "text-[10px] text-textMuted tabular-nums truncate w-full",
      })
    )
  );
}

function FilterToolbar() {
  const t = T();
  const groups = groupOptions();
  const sorts = sortOptions();
  const activeGroup = groups.some(g => g.value === selectedGroup) ? selectedGroup : "all";
  return h(
    "Column",
    { tw: "gap-2 w-full" },
    groups.length > 1
      ? h("Segmented", {
          key: "seg-group",
          items: groups,
          value: activeGroup,
          onChange: v => {
            selectedGroup = String(v || "all");
            localStorage.setItem("komari.group", selectedGroup);
            $metrix.invalidate();
          },
        })
      : null,
    h(
      "Row",
      { tw: "gap-2 items-center w-full" },
      Icon("sort", 12, K.muted),
      TX(t.sortBy, { tw: "text-[11px] text-textMuted shrink-0" }),
      h("Spacer"),
      h("Segmented", {
        key: "seg-sort",
        items: sorts,
        value: sortBy,
        onChange: v => {
          sortBy = String(v || "weight");
          localStorage.setItem("komari.sort", sortBy);
          $metrix.invalidate();
        },
      })
    )
  );
}

// Segmented capsule bar (like LuminaPlus resource & quota bars)
function SegmentedCapsuleBar(pct, count, activeColor, warnHigh = true) {
  const p = clampPct(pct);
  const filled = p > 0 ? Math.max(1, Math.round((p / 100) * count)) : 0;
  const barColor = warnHigh && p >= 90 ? K.down : warnHigh && p >= 75 ? K.warn : activeColor;
  const cells = [];
  for (let i = 0; i < count; i++) {
    cells.push(
      h("Box", {
        key: `c-${i}`,
        tw: `h-1.5 rounded-[1.5px] grow basis-0 bg-${i < filled ? barColor : "border"}`,
      })
    );
  }
  return h("Row", { tw: "gap-[2.5px] items-center w-full" }, cells);
}

function ResourceCell(iconName, label, valueText, subText, pct, activeColor) {
  return h(
    "Column",
    { tw: "gap-1 min-w-0 w-full" },
    h(
      "Row",
      { tw: "items-center gap-1 w-full min-w-0" },
      Icon(iconName, 11, K.muted),
      TX(label, { tw: "text-[11px] text-textMuted truncate" }),
      h("Spacer"),
      TX(valueText, { tw: "text-[11.5px] font-bold tabular-nums shrink-0" })
    ),
    subText
      ? TX(subText, { tw: "text-[10px] text-textMuted tabular-nums truncate leading-none" })
      : h("Box", { tw: "h-[10px]" }),
    SegmentedCapsuleBar(pct, 14, activeColor, true)
  );
}

function RemainingTrafficRow(node, st) {
  const t = T();
  if (!node.trafficLimit || node.trafficLimit <= 0) return null;
  const used = calcTrafficUsed(st, node.trafficLimitType);
  const remain = Math.max(0, node.trafficLimit - used);
  const usedPct = clampPct((used / node.trafficLimit) * 100);
  const barColor = usedPct >= 95 ? K.down : usedPct >= 75 ? "[#e07a2f]" : "[#52b788]";
  return h(
    "Column",
    { tw: "gap-1.5 pt-1 w-full min-w-0" },
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      Icon("disk", 11, K.muted),
      TX(t.remainTraffic, { tw: "text-[11px] text-textMuted shrink-0" }),
      TX(formatBytes(remain, 2), { tw: "text-[11px] font-bold tabular-nums shrink-0" }),
      h("Spacer"),
      TX(`${formatBytes(used, 2)} / ${formatBytes(node.trafficLimit, 2)}`, {
        tw: "text-[10.5px] text-textMuted tabular-nums truncate",
      })
    ),
    SegmentedCapsuleBar(usedPct, 24, barColor, false)
  );
}

function PingStrip(pings) {
  if (!Array.isArray(pings) || !pings.length) return null;
  return h(
    "Grid",
    { tw: `grid-cols-${Math.min(pings.length, 3)} gap-1.5 w-full min-w-0` },
    pings.slice(0, 3).map(p => {
      const ms = p.latest;
      const loss = Math.max(0, num(p.loss, 0));
      const msColor = ms < 0 ? K.down : ms >= 160 ? K.warn : "[#52b788]";
      const lossColor = loss >= 20 ? K.down : loss > 0 ? K.warn : "[#52b788]";
      const lossStr = loss === 0 ? "0%" : `${loss.toFixed(1).replace(/\.0$/, "")}%`;
      return h(
        "Row",
        {
          key: p.id,
          tw: "items-center gap-1 py-1 px-2 rounded-md bg-surfaceHover min-w-0",
        },
        h("Box", { tw: `w-1.5 h-1.5 rounded-full shrink-0 bg-${msColor}` }),
        TX(p.name, { tw: "text-[10px] text-textMuted truncate min-w-0 shrink grow" }),
        TX(ms >= 0 ? `${Math.round(ms)}ms` : "—", {
          tw: `text-[10px] font-bold text-${msColor} tabular-nums shrink-0`,
        }),
        TX(lossStr, {
          tw: `text-[9.5px] font-semibold text-${lossColor} tabular-nums shrink-0`,
        })
      );
    })
  );
}

function CardSurgeWave(node) {
  const hist = rateHistory.get(node.uuid) || [{ ts: Date.now(), up: node.status.netUp, down: node.status.netDown }];
  const sliced = hist.slice(-BAR_SLOTS);
  let maxRate = 1024;
  for (const pt of sliced) {
    if (pt.up > maxRate) maxRate = pt.up;
    if (pt.down > maxRate) maxRate = pt.down;
  }
  const padded = [];
  for (let i = 0; i < BAR_SLOTS - sliced.length; i++) {
    padded.push({ ts: 0, up: 0, down: 0 });
  }
  for (const pt of sliced) padded.push(pt);

  const halfH = 11;
  const minDot = 2;
  const cols = padded.map((item, idx) => {
    const upH = item.up > 0 ? Math.max(minDot, Math.round((item.up / maxRate) * halfH)) : minDot;
    const downH = item.down > 0 ? Math.max(minDot, Math.round((item.down / maxRate) * halfH)) : minDot;
    return h(
      "Column",
      { key: `w-${idx}`, tw: "grow basis-0 items-center gap-[1.5px]" },
      // Top half: Blue ↑ Upload bar growing upward
      h(
        "Column",
        { tw: `h-[${halfH}px] w-full justify-end items-center` },
        h("Box", {
          tw: `w-[4px] h-[${upH}px] rounded-full bg-[#3b82f6]`,
          opacity: item.up > 0 ? 0.92 : 0.28,
        })
      ),
      // Bottom half: Green ↓ Download bar growing downward
      h(
        "Column",
        { tw: `h-[${halfH}px] w-full justify-start items-center` },
        h("Box", {
          tw: `w-[4px] h-[${downH}px] rounded-full bg-[#10b981]`,
          opacity: item.down > 0 ? 0.92 : 0.28,
        })
      )
    );
  });

  return h("Row", { tw: "items-center gap-[1.5px] w-full" }, cols);
}

function ServerCard(node) {
  const t = T();
  const st = node.status;
  const upSplit = splitRate(st.netUp, 1);
  const downSplit = splitRate(st.netDown, 1);
  const loadPct = clampPct((st.load1 / Math.max(1, node.cpuCores || 1)) * 100);
  const daysLeft = calcDaysLeft(node.expiredAt);
  const priceText = formatPricePill(node);

  return h(
    "Column",
    {
      key: `srv-${node.uuid}`,
      tw: `gap-2.5 py-3 px-3.5 rounded-xl border border-border ${cardBg()} shadow-sm cursor-pointer w-full min-w-0 hover:bg-surfaceHover`,
      label: `Server ${node.name}`,
      onClick: () => selectNode(node.uuid),
    },
    // 1. Header: Flag/Region + Name + Group + Chart icon
    h(
      "Row",
      { tw: "gap-2 items-center w-full min-w-0" },
      h("Box", {
        tw: `w-2 h-2 rounded-full shrink-0 bg-${st.online ? "[#52b788]" : K.down}`,
      }),
      node.region
        ? TX(node.region, { tw: "text-[14px] shrink-0 leading-none" })
        : null,
      TX(node.name, { tw: "text-[13.5px] font-bold truncate min-w-0 shrink grow" }),
      node.group
        ? h("Badge", { text: node.group, textColor: K.muted, background: "background" })
        : null,
      !st.online
        ? h("Badge", { text: t.offline, textColor: K.down, background: K.press })
        : null
    ),
    // 2. 2x2 Hardware Grid (CPU, RAM, Disk, Load) with segmented bars
    st.online
      ? h(
          "Grid",
          { tw: "grid-cols-2 gap-x-4 gap-y-2.5 w-full min-w-0" },
          ResourceCell(
            "cpu",
            t.cpu,
            pctFixed(st.cpu, 2),
            t.cores(node.cpuCores),
            st.cpu,
            "[#4a8af4]"
          ),
          ResourceCell(
            "ram",
            t.memory,
            pctFixed(st.ramPct, 2),
            st.ramTotal > 0 ? `${formatBytes(st.ramUsed, 2)} / ${formatBytes(st.ramTotal, 2)}` : "",
            st.ramPct,
            "[#8b5cf6]"
          ),
          ResourceCell(
            "disk",
            t.disk,
            pctFixed(st.diskPct, 1),
            st.diskTotal > 0 ? `${formatBytes(st.diskUsed, 2)} / ${formatBytes(st.diskTotal, 1)}` : "",
            st.diskPct,
            "[#e07a2f]"
          ),
          ResourceCell(
            "gauge",
            t.load,
            st.load1.toFixed(2),
            `5m ${st.load5.toFixed(2)} · 15m ${st.load15.toFixed(2)}`,
            loadPct,
            "[#52b788]"
          )
        )
      : null,
    // 3. Compact Bandwidth + Slim Bidirectional Mirrored Wave (Top: Blue ↑ Upload, Bottom: Green ↓ Download)
    st.online ? h("Divider") : null,
    st.online
      ? h(
          "Column",
          { tw: "gap-1.5 w-full min-w-0" },
          // Top compact row: ↑ 上行  55.7 KB/s   |   ↓ 下行  53.2 KB/s
          h(
            "Grid",
            { tw: "grid-cols-2 gap-x-4 w-full min-w-0" },
            h(
              "Row",
              { tw: "items-center justify-between w-full min-w-0" },
              TX(t.upRate, { tw: "text-[11px] font-semibold text-[#3b82f6] shrink-0" }),
              h(
                "Row",
                { tw: "items-end gap-0.5 shrink-0" },
                TX(upSplit.num, { tw: "text-[12px] font-bold text-[#3b82f6] tabular-nums leading-none" }),
                TX(upSplit.unit, { tw: "text-[10px] font-medium text-textMuted" })
              )
            ),
            h(
              "Row",
              { tw: "items-center justify-between w-full min-w-0" },
              TX(t.downRate, { tw: "text-[11px] font-semibold text-[#10b981] shrink-0" }),
              h(
                "Row",
                { tw: "items-end gap-0.5 shrink-0" },
                TX(downSplit.num, { tw: "text-[12px] font-bold text-[#10b981] tabular-nums leading-none" }),
                TX(downSplit.unit, { tw: "text-[10px] font-medium text-textMuted" })
              )
            )
          ),
          // Middle: Slim bidirectional wave
          CardSurgeWave(node),
          // Bottom compact row: 出站 612 GB   |   入站 644 GB
          h(
            "Grid",
            { tw: "grid-cols-2 gap-x-4 w-full min-w-0" },
            h(
              "Row",
              { tw: "items-center gap-1 w-full min-w-0" },
              Icon("globe", 10, "[#3b82f6]"),
              TX(t.outbound, { tw: "text-[10.5px] text-textMuted shrink-0" }),
              h("Spacer"),
              TX(formatBytes(st.totalUp, 2), { tw: "text-[10.5px] font-semibold tabular-nums" })
            ),
            h(
              "Row",
              { tw: "items-center gap-1 w-full min-w-0" },
              Icon("globe", 10, "[#10b981]"),
              TX(t.inbound, { tw: "text-[10.5px] text-textMuted shrink-0" }),
              h("Spacer"),
              TX(formatBytes(st.totalDown, 2), { tw: "text-[10.5px] font-semibold tabular-nums" })
            )
          )
        )
      : null,
    st.online ? h("Divider") : null,
    // 4. Remaining Traffic Quota Bar
    st.online ? RemainingTrafficRow(node, st) : null,
    // 5. Compact Ping Strip (3 targets)
    st.online && st.pings.length ? PingStrip(st.pings) : null,
    // 6. Footer: Uptime Days + Expiry Days + Price Pill + TCP/UDP
    h(
      "Row",
      { tw: "gap-2.5 pt-0.5 items-center w-full min-w-0" },
      st.online && st.uptime > 0
        ? h(
            "Row",
            { tw: "gap-1 items-center shrink-0" },
            Icon("clock", 11, K.muted),
            TX(t.onlineDays(formatUptimeDays(st.uptime)), {
              tw: "text-[11px] font-medium text-accent tabular-nums",
            })
          )
        : TX(t.lastSeen(formatAge(st.updatedAt)), {
            tw: "text-[11px] text-textMuted tabular-nums truncate",
          }),
      daysLeft !== null
        ? h(
            "Row",
            { tw: "gap-1 items-center shrink-0" },
            Icon("calendar", 11, K.muted),
            TX(t.expireDays(daysLeft), {
              tw: `text-[11px] font-medium text-${daysLeft <= 7 ? K.down : daysLeft <= 30 ? "[#e07a2f]" : "[#52b788]"} tabular-nums`,
            })
          )
        : null,
      st.online
        ? TX(`TCP ${st.tcp} · UDP ${st.udp}`, {
            tw: "text-[10.5px] text-textMuted tabular-nums truncate min-w-0 shrink",
          })
        : null,
      h("Spacer"),
      priceText
        ? h(
            "Row",
            { tw: "py-0.5 px-2 rounded-full bg-[#10b9811a] shrink-0" },
            TX(priceText, { tw: "text-[10.5px] font-semibold text-[#52b788] tabular-nums" })
          )
        : null
    )
  );
}

// ---------------------------------------------------------------------------
// Single-Server Detail View & Historical Charts (LuminaPlus-style)
// ---------------------------------------------------------------------------

const pad2 = n => String(n).padStart(2, "0");
function hhmm(ts) {
  const d = new Date(ts);
  return Number.isFinite(d.getTime()) ? `${pad2(d.getHours())}:${pad2(d.getMinutes())}` : "";
}
function hhmmss(iso) {
  if (!iso) return "—";
  const d = new Date(iso);
  return Number.isFinite(d.getTime()) ? `${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}` : "—";
}
function mmddhhmm(ts) {
  const d = new Date(ts);
  if (!Number.isFinite(d.getTime())) return "";
  return `${pad2(d.getMonth() + 1)}/${pad2(d.getDate())} ${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
}

function parseSampleTime(r) {
  return Date.parse(str(r && (r.time || r.updated_at)));
}

function sortedUniquePoints(pts) {
  pts.sort((a, b) => a.x - b.x);
  const out = [];
  for (const p of pts) {
    if (!out.length || p.x > out[out.length - 1].x) out.push(p);
  }
  return out;
}

function computePeakSpeeds(records) {
  let maxUp = 0;
  let maxUpTime = 0;
  let maxDown = 0;
  let maxDownTime = 0;
  for (const r of records || []) {
    const ts = parseSampleTime(r);
    const up = num(r.net_out !== undefined ? r.net_out : r.network && r.network.up, 0);
    const down = num(r.net_in !== undefined ? r.net_in : r.network && r.network.down, 0);
    if (up >= maxUp) {
      maxUp = up;
      if (Number.isFinite(ts)) maxUpTime = ts;
    }
    if (down >= maxDown) {
      maxDown = down;
      if (Number.isFinite(ts)) maxDownTime = ts;
    }
  }
  const upTimeStr = maxUpTime ? ` (${hhmm(maxUpTime)})` : "";
  const downTimeStr = maxDownTime ? ` (${hhmm(maxDownTime)})` : "";
  return `↑ ${formatRate(maxUp, true)}${upTimeStr} · ↓ ${formatRate(maxDown, true)}${downTimeStr}`;
}

function buildMetricChartsData(records, node) {
  const cpuPts = [];
  const ramPts = [];
  const swapPts = [];
  const diskPts = [];
  const netDownPts = [];
  const netUpPts = [];
  const tcpPts = [];
  const udpPts = [];
  const procPts = [];

  for (const r of records || []) {
    const ts = parseSampleTime(r);
    if (!Number.isFinite(ts)) continue;

    const ptLabel = detailSpan === "realtime" ? hhmmss(ts) : mmddhhmm(ts);
    const cpuVal = clampPct(typeof r.cpu === "object" && r.cpu ? r.cpu.usage : r.cpu);
    cpuPts.push({ x: ts, y: Number(cpuVal.toFixed(2)), label: ptLabel, valueLabel: `${cpuVal.toFixed(2)}%` });

    const ramUsed = typeof r.ram === "object" && r.ram ? num(r.ram.used, 0) : num(r.ram, 0);
    const ramTotal = (typeof r.ram === "object" && r.ram ? num(r.ram.total, 0) : num(r.ram_total, 0)) || node.memTotal;
    const ramPct = ramTotal > 0 ? clampPct((ramUsed / ramTotal) * 100) : 0;
    ramPts.push({ x: ts, y: Number(ramPct.toFixed(2)), label: ptLabel, valueLabel: `${ramPct.toFixed(1)}% (${formatBytes(ramUsed, 2)})` });

    const swapUsed = typeof r.swap === "object" && r.swap ? num(r.swap.used, 0) : num(r.swap, 0);
    const swapTotal = (typeof r.swap === "object" && r.swap ? num(r.swap.total, 0) : num(r.swap_total, 0)) || node.swapTotal;
    const swapPct = swapTotal > 0 ? clampPct((swapUsed / swapTotal) * 100) : 0;
    swapPts.push({ x: ts, y: Number(swapPct.toFixed(2)), label: ptLabel, valueLabel: `${swapPct.toFixed(1)}% (${formatBytes(swapUsed, 2)})` });

    const diskUsed = typeof r.disk === "object" && r.disk ? num(r.disk.used, 0) : num(r.disk, 0);
    const diskTotal = (typeof r.disk === "object" && r.disk ? num(r.disk.total, 0) : num(r.disk_total, 0)) || node.diskTotal;
    const diskPct = diskTotal > 0 ? clampPct((diskUsed / diskTotal) * 100) : 0;
    diskPts.push({ x: ts, y: Number(diskPct.toFixed(2)), label: ptLabel, valueLabel: `${diskPct.toFixed(2)}% (${formatBytes(diskUsed, 2)})` });

    const down = Math.max(0, num(r.net_in !== undefined ? r.net_in : r.network && r.network.down, 0));
    const up = Math.max(0, num(r.net_out !== undefined ? r.net_out : r.network && r.network.up, 0));
    netDownPts.push({ x: ts, y: Number((down / 1024).toFixed(1)), label: ptLabel, valueLabel: formatRate(down) });
    netUpPts.push({ x: ts, y: Number((up / 1024).toFixed(1)), label: ptLabel, valueLabel: formatRate(up) });

    const tcp = num(r.connections !== undefined && typeof r.connections !== "object" ? r.connections : r.connections && r.connections.tcp, 0);
    const udp = num(r.connections_udp !== undefined ? r.connections_udp : r.connections && r.connections.udp, 0);
    tcpPts.push({ x: ts, y: tcp, label: ptLabel, valueLabel: `TCP ${tcp}` });
    udpPts.push({ x: ts, y: udp, label: ptLabel, valueLabel: `UDP ${udp}` });

    const proc = num(r.process, 0);
    procPts.push({ x: ts, y: proc, label: ptLabel, valueLabel: `${proc}` });
  }

  return {
    cpu: sortedUniquePoints(cpuPts),
    ram: sortedUniquePoints(ramPts),
    swap: sortedUniquePoints(swapPts),
    disk: sortedUniquePoints(diskPts),
    netDown: sortedUniquePoints(netDownPts),
    netUp: sortedUniquePoints(netUpPts),
    tcp: sortedUniquePoints(tcpPts),
    udp: sortedUniquePoints(udpPts),
    proc: sortedUniquePoints(procPts),
  };
}

const PING_COLORS = ["#ec4899", "#84cc16", "#0ea5e9", "#a855f7", "#f59e0b", "#14b8a6"];

function analyzePingData(records, tasks, nodePings) {
  const taskMeta = new Map();
  for (const tk of tasks || []) {
    if (tk && tk.id !== undefined) {
      taskMeta.set(String(tk.id), {
        id: String(tk.id),
        name: str(tk.name) || `Task #${tk.id}`,
        avg: num(tk.avg, 0),
        loss: num(tk.loss, 0),
      });
    }
  }
  for (const np of nodePings || []) {
    if (np && np.id !== undefined && !taskMeta.has(String(np.id))) {
      taskMeta.set(String(np.id), {
        id: String(np.id),
        name: str(np.name) || `Task #${np.id}`,
        avg: num(np.avg || np.latest, 0),
        loss: num(np.loss, 0),
      });
    }
  }

  const rawByTask = new Map();
  for (const r of records || []) {
    const ts = Date.parse(str(r.time));
    if (!Number.isFinite(ts)) continue;
    const tid = String(r.task_id !== undefined ? r.task_id : "default");
    if (!rawByTask.has(tid)) rawByTask.set(tid, []);
    rawByTask.get(tid).push({ ts, val: num(r.value, -1) });
  }

  const taskIds = Array.from(new Set([...taskMeta.keys(), ...rawByTask.keys()]));
  const summaries = [];
  const latencySeries = [];
  const lossSeries = [];
  let minTs = Infinity;
  let maxTs = -Infinity;
  let totalPts = 0;

  taskIds.forEach((tid, idx) => {
    const color = PING_COLORS[idx % PING_COLORS.length];
    const meta = taskMeta.get(tid) || { id: tid, name: `Ping #${tid}`, avg: 0, loss: 0 };
    const arr = (rawByTask.get(tid) || []).slice().sort((a, b) => a.ts - b.ts);

    let validSum = 0;
    let validCnt = 0;
    let lostCnt = 0;
    const latPts = [];
    const lossPts = [];
    const winSize = 10;

    for (let i = 0; i < arr.length; i++) {
      const item = arr[i];
      const alignedTs = Math.round(item.ts / 30000) * 30000;
      if (alignedTs < minTs) minTs = alignedTs;
      if (alignedTs > maxTs) maxTs = alignedTs;
      const lbl = mmddhhmm(alignedTs);

      if (item.val >= 0) {
        validSum += item.val;
        validCnt++;
        latPts.push({
          x: alignedTs,
          y: Number(item.val.toFixed(1)),
          label: lbl,
          valueLabel: `${item.val.toFixed(1)} ms`,
        });
      } else {
        lostCnt++;
      }

      // Sliding window packet loss % over up to last winSize samples
      const startIdx = Math.max(0, i - winSize + 1);
      let winLost = 0;
      for (let j = startIdx; j <= i; j++) {
        if (arr[j].val < 0) winLost++;
      }
      const winLossPct = Number(((winLost / (i - startIdx + 1)) * 100).toFixed(1));
      lossPts.push({
        x: alignedTs,
        y: winLossPct,
        label: lbl,
        valueLabel: `${winLossPct.toFixed(1)}%`,
      });
    }

    const avgMs = validCnt > 0 ? validSum / validCnt : meta.avg;
    const lossPct = arr.length > 0 ? (lostCnt / arr.length) * 100 : meta.loss;
    const dedupLat = sortedUniquePoints(latPts);
    const dedupLoss = sortedUniquePoints(lossPts);
    if (dedupLat.length > totalPts) totalPts = dedupLat.length;

    summaries.push({
      id: tid,
      name: meta.name,
      color,
      avgMs,
      lossPct,
      hidden: hiddenPingTasks.has(tid),
    });

    if (!hiddenPingTasks.has(tid)) {
      if (dedupLat.length > 0) {
        latencySeries.push({ name: meta.name, color, points: dedupLat });
      }
      if (dedupLoss.length > 0) {
        lossSeries.push({
          name: meta.name,
          color,
          fill: { from: 0.2, to: 0.01 },
          points: dedupLoss,
        });
      }
    }
  });

  return { summaries, latencySeries, lossSeries, minTs, maxTs, totalPts };
}

function InfoRow(label, value, valueColor) {
  const sVal = String(value);
  return h(
    "Row",
    { key: label, tw: "items-center gap-2 py-1 w-full min-w-0" },
    TX(label, { tw: "text-[11px] text-textMuted shrink-0 w-20" }),
    TX(sVal, {
      tw: `text-[11px] font-semibold ${valueColor ? "text-" + valueColor : ""} truncate min-w-0 shrink grow text-end tabular-nums`,
      ...(sVal.length > 32 ? { tooltip: sVal } : {}),
    })
  );
}

function CollapsibleNodeInfoCard(node, loadRecords) {
  const t = T();
  const st = node.status;
  const usedTraffic = calcTrafficUsed(st, node.trafficLimitType);
  const quotaPct = node.trafficLimit > 0 ? clampPct((usedTraffic / node.trafficLimit) * 100) : 0;
  const peakText =
    loadRecords && loadRecords.length
      ? computePeakSpeeds(loadRecords)
      : `↑ ${formatRate(st.netUp, true)} · ↓ ${formatRate(st.netDown, true)}`;

  const sysRows = [
    [t.lblStatus, st.online ? t.online : t.offline, st.online ? "[#52b788]" : K.down],
    ["CPU", node.cpuName ? `${node.cpuName}${node.cpuCores ? ` (x${node.cpuCores})` : ""}` : "—"],
    [t.specArch, [node.arch, node.virt].filter(Boolean).join(" · ") || "—"],
    [t.lblGpu, node.gpuName || "None"],
    [t.specOs, node.os || "—"],
  ];

  const resRows = [
    [t.memory, `${formatBytes(st.ramUsed, 2)} / ${formatBytes(st.ramTotal, 2)}`],
    ["Swap", st.swapTotal > 0 ? `${formatBytes(st.swapUsed, 2)} / ${formatBytes(st.swapTotal, 2)}` : t.specNone],
    [t.disk, `${formatBytes(st.diskUsed, 2)} / ${formatBytes(st.diskTotal, 2)}`],
    [t.load, `${st.load1.toFixed(2)} | ${st.load5.toFixed(2)} | ${st.load15.toFixed(2)}`],
    [t.uptime, formatUptimeDays(st.uptime)],
  ];

  const netRows = [
    [t.lblLiveNet, `↑ ${formatRate(st.netUp)} · ↓ ${formatRate(st.netDown)}`],
    [t.lblLastUpdate, hhmmss(st.updatedAt)],
    [t.lblPeakSpeed, peakText],
  ];

  const activeRows = infoSection === "res" ? resRows : infoSection === "net" ? netRows : sysRows;

  const netTrafficFooter =
    infoSection === "net"
      ? h(
          "Column",
          { tw: "gap-1.5 pt-1 w-full min-w-0" },
          h("Divider"),
          h(
            "Row",
            { tw: "items-center justify-between w-full min-w-0 pt-0.5" },
            TX(t.lblTotalTraffic, { tw: "text-[11px] text-textMuted" }),
            TX(`↑ ${formatBytes(st.totalUp, 2)} · ↓ ${formatBytes(st.totalDown, 2)}`, {
              tw: "text-[11px] font-bold tabular-nums",
            })
          ),
          node.trafficLimit > 0
            ? h(
                "Column",
                { tw: "gap-1 w-full" },
                h(
                  "Box",
                  { tw: "h-1.5 rounded-full bg-border w-full" },
                  h("Box", {
                    tw: "h-1.5 rounded-full",
                    widthPercent: Math.max(quotaPct, 2),
                    linearGradient: { from: "#3b82f6", to: "#8b5cf6", angle: 0 },
                  })
                ),
                TX(`${formatBytes(usedTraffic, 2)} / ${formatBytes(node.trafficLimit, 2)}`, {
                  tw: "text-[10px] text-textMuted tabular-nums",
                })
              )
            : null
        )
      : null;

  const secItems = [
    { label: t.secSystem, value: "sys" },
    { label: t.secResource, value: "res" },
    { label: t.secNetwork, value: "net" },
  ];

  return h(
    "Column",
    { tw: `gap-1.5 py-3 px-3.5 rounded-xl border border-border ${cardBg()} shadow-sm w-full min-w-0` },
    h(
      "Row",
      { tw: "items-center gap-2 w-full min-w-0" },
      h(
        "Row",
        {
          key: "btn-toggle-info",
          tw: "items-center gap-1.5 cursor-pointer min-w-0 shrink grow",
          onClick: () => {
            infoExpanded = !infoExpanded;
            $metrix.invalidate();
          },
        },
        Icon("cpu", 13, K.muted),
        TX(t.infoSuffix, { tw: "text-xs font-bold truncate min-w-0 shrink" }),
        Icon(infoExpanded ? "chevUp" : "chevDown", 13, K.muted),
        h("Spacer")
      ),
      h("Segmented", {
        key: "seg-info-sec",
        items: secItems,
        value: infoSection,
        onChange: v => {
          infoSection = ["sys", "res", "net"].includes(v) ? v : "sys";
          infoExpanded = true;
          localStorage.setItem("komari.infoSec", infoSection);
          $metrix.invalidate();
        },
      })
    ),
    infoExpanded
      ? h(
          "Column",
          { tw: "gap-0.5 pt-0.5 w-full min-w-0" },
          ...activeRows.map((r, idx) =>
            h(
              "Column",
              { key: `ir-${infoSection}-${idx}`, tw: "w-full min-w-0" },
              h("Divider"),
              InfoRow(r[0], r[1], r[2])
            )
          ),
          netTrafficFooter
        )
      : null
  );
}

function MetricChartCard({ keyId, iconName, iconColor, tintHex, title, mainValue, subValue, series, yDomain, emptyText }) {
  const hasPoints = series.some(s => s.points && s.points.length >= 2);
  return h(
    "Column",
    {
      key: keyId,
      tw: "gap-2 py-3 px-3.5 rounded-xl border border-border w-full min-w-0",
      linearGradient: { from: `${tintHex}14`, to: isDarkTheme() ? "surface" : "background", angle: 165 },
    },
    h(
      "Row",
      { tw: "items-start justify-between gap-2 w-full min-w-0" },
      h(
        "Row",
        { tw: "items-center gap-1.5 pt-0.5 shrink-0" },
        Icon(iconName, 13, iconColor),
        TX(title, { tw: "text-xs font-bold" })
      ),
      h(
        "Column",
        { tw: "items-end gap-0.5 min-w-0 shrink" },
        TX(mainValue, { tw: "text-xs font-bold tabular-nums truncate" }),
        TX(subValue, { tw: "text-[10.5px] text-textMuted tabular-nums truncate" })
      )
    ),
    hasPoints
      ? h("Chart", {
          key: `${keyId}-chart`,
          type: "area",
          curve: "monotone",
          xKind: "time",
          height: 118,
          ...(yDomain ? { yDomain } : {}),
          hover: true,
          tw: "w-full",
          series,
        })
      : h(
          "Row",
          { tw: "h-28 items-center justify-center w-full" },
          TX(emptyText, { tw: "text-xs text-textMuted" })
        )
  );
}

function LoadChartsGrid(node, entry) {
  const t = T();
  const st = node.status;
  if (!entry || (entry.loading && !entry.loadRecords.length)) {
    return h(
      "Column",
      { tw: "gap-2.5 w-full" },
      [0, 1, 2].map(i => bone(388, 160, { key: `sk-ch-${i}`, tw: "rounded-xl w-full" }))
    );
  }

  const m = buildMetricChartsData(entry.loadRecords, node);
  const sampleCount = m.cpu.length;
  const rangeStr =
    sampleCount >= 2 ? t.coverage(mmddhhmm(m.cpu[0].x), hhmm(m.cpu[sampleCount - 1].x)) : "";

  return h(
    "Column",
    { tw: "gap-2.5 w-full min-w-0" },
    // Section Header with coverage & sample count pills
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      TX(t.loadChartsTitle, { tw: "text-[13px] font-bold shrink-0" }),
      h("Spacer"),
      rangeStr
        ? h(
            "Row",
            { tw: "py-0.5 px-2 rounded-full border border-border bg-surfaceHover shrink-0" },
            TX(rangeStr, { tw: "text-[10px] font-medium text-textMuted tabular-nums" })
          )
        : null,
      sampleCount > 0
        ? h(
            "Row",
            { tw: "py-0.5 px-2 rounded-full border border-border bg-surfaceHover shrink-0" },
            TX(t.samples(sampleCount), { tw: "text-[10px] font-medium text-textMuted tabular-nums" })
          )
        : null
    ),
    // 1. CPU Card (Blue)
    MetricChartCard({
      keyId: `mc-cpu-${node.uuid}`,
      iconName: "cpu",
      iconColor: "[#3b82f6]",
      tintHex: "#3b82f6",
      title: "CPU",
      mainValue: `${st.cpu.toFixed(2)}%`,
      subValue: t.usageSub,
      series: [{ name: "CPU %", color: "#3b82f6", fill: { from: 0.26, to: 0.02 }, points: m.cpu }],
      emptyText: t.noLoadData,
    }),
    // 2. Memory + Swap Card (Purple + Amber)
    MetricChartCard({
      keyId: `mc-ram-${node.uuid}`,
      iconName: "ram",
      iconColor: "[#8b5cf6]",
      tintHex: "#8b5cf6",
      title: t.memory,
      mainValue: `${formatBytes(st.ramUsed, 2)} / ${formatBytes(st.ramTotal, 2)}`,
      subValue: `Swap ${formatBytes(st.swapUsed, 2)} / ${formatBytes(st.swapTotal, 2)}`,
      series: [
        { name: "RAM %", color: "#8b5cf6", fill: { from: 0.26, to: 0.02 }, points: m.ram },
        ...(node.swapTotal > 0
          ? [{ name: "Swap %", color: "#d97706", fill: { from: 0.14, to: 0.01 }, points: m.swap }]
          : []),
      ],
      emptyText: t.noLoadData,
    }),
    // 3. Disk Card (Orange)
    MetricChartCard({
      keyId: `mc-disk-${node.uuid}`,
      iconName: "disk",
      iconColor: "[#e07a2f]",
      tintHex: "#e07a2f",
      title: t.disk,
      mainValue: `${formatBytes(st.diskUsed, 2)} / ${formatBytes(st.diskTotal, 2)}`,
      subValue: t.usedSpaceSub,
      series: [{ name: "Disk %", color: "#e07a2f", fill: { from: 0.24, to: 0.02 }, points: m.disk }],
      emptyText: t.noLoadData,
    }),
    // 4. Network Card (Unified MetricChartCard: Blue Upload + Green Download)
    MetricChartCard({
      keyId: `mc-net-${node.uuid}`,
      iconName: "activity",
      iconColor: "[#10b981]",
      tintHex: "#10b981",
      title: t.network,
      mainValue: `↑ ${formatRate(st.netUp)} / ↓ ${formatRate(st.netDown)}`,
      subValue: `↑ ${formatBytes(st.totalUp, 1)} · ↓ ${formatBytes(st.totalDown, 1)}`,
      series: [
        { name: t.ulSeries, color: "#3b82f6", fill: { from: 0.25, to: 0.02 }, points: m.netUp },
        { name: t.dlSeries, color: "#10b981", fill: { from: 0.18, to: 0.01 }, points: m.netDown },
      ],
      emptyText: t.noNetData,
    }),
    // 5. Connections Card (Purple + Blue)
    MetricChartCard({
      keyId: `mc-conn-${node.uuid}`,
      iconName: "link",
      iconColor: "[#8b5cf6]",
      tintHex: "#8b5cf6",
      title: t.connTitle,
      mainValue: `TCP ${st.tcp} / UDP ${st.udp}`,
      subValue: t.connSub,
      series: [
        { name: "TCP", color: "#8b5cf6", fill: { from: 0.25, to: 0.02 }, points: m.tcp },
        { name: "UDP", color: "#3b82f6", fill: { from: 0.16, to: 0.01 }, points: m.udp },
      ],
      emptyText: t.noLoadData,
    }),
    // 6. Processes Card (Gold)
    MetricChartCard({
      keyId: `mc-proc-${node.uuid}`,
      iconName: "gauge",
      iconColor: "[#ca8a04]",
      tintHex: "#ca8a04",
      title: t.procTitle,
      mainValue: String(st.process),
      subValue: `${t.load} ${st.load1.toFixed(2)} | ${st.load5.toFixed(2)} | ${st.load15.toFixed(2)}`,
      series: [{ name: t.procTitle, color: "#ca8a04", fill: { from: 0.24, to: 0.02 }, points: m.proc }],
      emptyText: t.noLoadData,
    })
  );
}

function PingChartsSection(node, entry) {
  const t = T();
  const st = node.status;
  if (!entry || (entry.loading && !entry.pingRecords.length)) {
    return bone(388, 220, { tw: "rounded-xl w-full" });
  }
  const info = analyzePingData(entry.pingRecords, entry.pingTasks, st.pings);
  const activeSeries = info.latencySeries;
  const rangeStr =
    Number.isFinite(info.minTs) && Number.isFinite(info.maxTs) && info.maxTs > info.minTs
      ? t.coverage(mmddhhmm(info.minTs), hhmm(info.maxTs))
      : "";

  // Compact task pills so 3 tasks fit on one line: [● 上海移动 216ms 0.0%]
  const pills = info.summaries.map(item => {
    const msColor = item.avgMs >= 160 ? "[#ca8a04]" : "[#52b788]";
    const lossColor = item.lossPct >= 10 ? K.down : item.lossPct > 0 ? K.warn : "[#52b788]";
    return h(
      "Row",
      {
        key: `ptask-${item.id}`,
        tw: "items-center gap-1 py-0.5 px-2 rounded-full border cursor-pointer shrink-0",
        borderColor: item.hidden ? "border" : item.color,
        background: item.hidden ? "background" : "surfaceHover",
        opacity: item.hidden ? 0.45 : 1,
        onClick: () => {
          if (hiddenPingTasks.has(item.id)) hiddenPingTasks.delete(item.id);
          else hiddenPingTasks.add(item.id);
          $metrix.invalidate();
        },
      },
      h("Box", { tw: `w-1.5 h-1.5 rounded-full shrink-0 bg-[${item.color}]` }),
      TX(item.name, { tw: "text-[10px] font-semibold shrink-0" }),
      TX(`${Math.round(item.avgMs)}ms`, { tw: `text-[10px] font-bold text-${msColor} tabular-nums shrink-0` }),
      TX(`${item.lossPct.toFixed(1)}%`, { tw: `text-[9.5px] font-semibold text-${lossColor} tabular-nums shrink-0` })
    );
  });

  return h(
    "Column",
    {
      tw: "gap-2.5 w-full min-w-0",
    },
    // Top Header: Ping 图表 + coverage & sample pills
    h(
      "Row",
      { tw: "items-center gap-1.5 w-full min-w-0" },
      TX(t.pingChartsTitle, { tw: "text-[13px] font-bold shrink-0" }),
      h("Spacer"),
      rangeStr
        ? h(
            "Row",
            { tw: "py-0.5 px-2 rounded-full border border-border bg-background shrink-0" },
            TX(rangeStr, { tw: "text-[10px] font-medium text-textMuted tabular-nums" })
          )
        : null,
      info.totalPts > 0
        ? h(
            "Row",
            { tw: "py-0.5 px-2 rounded-full border border-border bg-background shrink-0" },
            TX(t.samples(info.totalPts), { tw: "text-[10px] font-medium text-textMuted tabular-nums" })
          )
        : null
    ),
    // Task Pills Row (wrapping)
    pills.length
      ? h("Row", { tw: "flex-wrap gap-1 items-center w-full" }, pills)
      : null,
    // Chart
    activeSeries.length > 0 && activeSeries.some(s => s.points.length >= 2)
      ? h("Chart", {
          key: `chart-${node.uuid}-ping`,
          type: "line",
          curve: "monotone",
          xKind: "time",
          height: 175,
          hover: true,
          tw: "w-full",
          series: activeSeries,
        })
      : h(
          "Row",
          { tw: "h-36 items-center justify-center w-full" },
          TX(t.noPingData, { tw: "text-xs text-textMuted" })
        )
  );
}

function DetailView(node) {
  const t = T();
  const entry = detailCache.get(detailCacheKey(node.uuid, detailSpan));
  const loadRecords = entry ? entry.loadRecords : [];

  const tabItems = [
    { label: t.tabLoad, value: "load" },
    { label: t.tabPing, value: "ping" },
  ];
  const spanItems = [
    { label: t.spanRealtime, value: "realtime" },
    { label: t.span1h, value: "1h" },
    { label: t.span4h, value: "4h" },
    { label: t.span24h, value: "24h" },
  ];

  return h(
    "Scroll",
    { tw: "grow min-h-0 w-full" },
    h(
      "Column",
      { tw: "gap-3 pt-3.5 pr-4 pb-4 pl-4 w-full min-w-0" },
      Banner(),
      CollapsibleNodeInfoCard(node, loadRecords),
      // Switcher Toolbar: Load/Ping + Realtime/1h/4h/1d
      h(
        "Row",
        { tw: "items-center gap-2 w-full min-w-0" },
        h("Segmented", {
          key: "seg-detail-tab",
          items: tabItems,
          value: detailTab,
          onChange: v => {
            detailTab = v === "ping" ? "ping" : "load";
            localStorage.setItem("komari.detailTab", detailTab);
            $metrix.invalidate();
          },
        }),
        h("Spacer"),
        h("Segmented", {
          key: "seg-detail-span",
          items: spanItems,
          value: detailSpan,
          onChange: v => {
            const nextSpan = String(v || "realtime");
            detailSpan = nextSpan;
            localStorage.setItem("komari.detailSpan", detailSpan);
            const cached = detailCache.get(detailCacheKey(node.uuid, detailSpan));
            $metrix.invalidate();
            if (!cached || Date.now() - cached.loadedAt > 30e3) {
              return loadNodeDetail(node.uuid, detailSpan);
            }
          },
        })
      ),
      detailTab === "ping" ? PingChartsSection(node, entry) : LoadChartsGrid(node, entry)
    )
  );
}

function Skeleton() {
  return h(
    "Column",
    { tw: "gap-3.5 pt-3.5 pr-4 pb-4 pl-4 w-full" },
    h(
      "Grid",
      { tw: "grid-cols-3 gap-2 w-full" },
      [0, 1, 2].map(i => bone(120, 74, { key: `sk-top-${i}`, tw: "rounded-xl w-full" }))
    ),
    bone(388, 28, { tw: "rounded-md w-full" }),
    [0, 1, 2].map(i => bone(388, 190, { key: `sk-${i}`, tw: "rounded-xl w-full" }))
  );
}

function Body() {
  const t = T();
  if (!baseURL) return inputErr ? Problem(t.invalidUrlTitle, inputErr, false) : SetupGuide();
  if (!nodes.length) {
    return error
      ? Problem(t.connErrTitle, error, true)
      : loading || !loadedAt
      ? Skeleton()
      : Problem(t.emptyTitle, t.emptyDesc, true);
  }
  const activeNode = selectedUuid ? nodes.find(n => n.uuid === selectedUuid) : null;
  if (activeNode) return DetailView(activeNode);

  const list = visibleNodes();
  return h(
    "Scroll",
    { tw: "grow min-h-0 w-full" },
    h(
      "Column",
      { tw: "gap-3 pt-3.5 pr-4 pb-4 pl-4 w-full min-w-0" },
      Banner(),
      ClusterSummary(),
      FilterToolbar(),
      h(
        "Column",
        { tw: "gap-2.5 w-full min-w-0" },
        list.map(ServerCard)
      )
    )
  );
}

function panelTree() {
  return h(
    "Column",
    {
      preferredWidth: W,
      preferredHeight: 620,
      safeArea: true,
      tw: "size-full text-[13px] text-text min-w-0 min-h-0",
      shortcuts: {
        "CmdOrCtrl+R": launchRefresh,
        Escape: () => {
          if (selectedUuid) {
            selectedUuid = null;
            $metrix.invalidate();
          }
        },
      },
    },
    Header(),
    Body()
  );
}

function trayTree() {
  const t = T();
  const s = clusterStats();
  const hasData = nodes.length > 0;
  let title = "";
  if (hasData) {
    const totalBw = formatRate(s.netUp + s.netDown, true);
    if (trayFormat === "total") {
      title = totalBw;
    } else if (trayFormat === "online") {
      title = `${s.online}/${s.total}`;
    } else if (trayFormat === "online_both") {
      title = `${s.online}/${s.total} · ↑${formatRate(s.netUp, true)} ↓${formatRate(s.netDown, true)}`;
    } else {
      title = `${s.online}/${s.total} · ${totalBw}`;
    }
  }
  const tooltip = hasData
    ? t.trayTooltip(siteName || "Komari", s.online, s.total, formatRate(s.netDown), formatRate(s.netUp), pctText(s.avgCpu))
    : baseURL || "Komari";

  return {
    icon: "data:image/svg+xml," + encodeURIComponent(BRAND),
    iconTemplate: true,
    title,
    tooltip,
    error: error || inputErr,
    menu: [
      { label: t.refresh, onClick: launchRefresh, disabled: !baseURL },
      { label: t.openKomari, onClick: () => { if (baseURL) $metrix.openURL(baseURL); }, disabled: !baseURL },
    ],
  };
}

export default {
  async scheduled(env) {
    syncInputs(env);
    try {
      $metrix.schedule(refreshSec * 1000);
    } catch (e) {}
    await detectHostLocale();
    await refresh();
  },

  render(env) {
    syncInputs(env);
    return { tray: trayTree(), panel: panelTree() };
  },

  event(name, payload) {
    if (
      name === "lifecycle" &&
      payload &&
      payload.type === "expand" &&
      baseURL &&
      !inflight &&
      Date.now() - loadedAt > 30e3
    ) {
      launchRefresh();
    }
  },
};
  ]]></script>
</bar>
