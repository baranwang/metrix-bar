<bar protocol-version="0"
     category="monitoring"
     version="1.2.0"
     icon="data:image/svg+xml;base64,"
     description="Monitor multi-server status, real-time bandwidth, total traffic, and historical load &amp; ping trends with Komari."
     license="AGPL-3.0-only"
     homepage="https://komari-document.pages.dev/"
     id="komari"
     title="Komari"
     refresh="5s"
     material="solid">

  <permissions>
    <network origin="{{ inputs.baseURL }}" />
  </permissions>

  <inputs>
    <input name="baseURL"
           type="string"
           label="Komari Server URL"
           placeholder="https://status.example.com"
           required="true"
           help="Base URL of your Komari instance (e.g. `https://status.example.com`)." />
    <input name="apiKey"
           type="secret"
           label="API Key"
           help="Optional. Bearer API key (`Authorization: Bearer token`) for private sites (`private_site`) or viewing hidden nodes." />
    <input name="refreshInterval"
           type="select"
           label="Refresh Interval / 刷新间隔"
           default="5"
           help="Polling interval for fetching real-time server status.">
      <option value="2" label="2s (2 秒)" />
      <option value="5" label="5s (5 秒 - 默认)" />
      <option value="10" label="10s (10 秒)" />
      <option value="30" label="30s (30 秒)" />
      <option value="60" label="60s (60 秒)" />
    </input>
    <input name="trayFormat"
           type="select"
           label="Tray Display / 托盘显示"
           default="online_total"
           help="Metrics shown in the macOS menu bar / system tray.">
      <option value="online_total" label="10/10 · 1.1M/s (在线数 + 总带宽)" />
      <option value="total" label="1.1M/s (仅总带宽)" />
      <option value="online_both" label="10/10 · ↑Up ↓Down (在线数 + 上下行)" />
      <option value="online" label="10/10 (仅在线节点数)" />
    </input>
    <input name="offlineNotify"
           type="bool"
           label="Offline Alerts / 离线通知"
           default="true"
           help="Send a desktop notification when an online server goes offline." />
  </inputs>

  <docs><![CDATA[Connect to a Komari monitoring server. Set Komari Server URL to your instance origin (for example https://status.example.com). Public Komari sites work without credentials; for private sites or hidden nodes, add an admin API key (requires Komari > 1.0.3).]]></docs>

  <script apis="app localStorage match-media notification shell"><![CDATA[
// Komari multi-server monitoring dashboard for Metrix.Bar.

const h = (type, props, ...children) => ({
  type,
  props: props || {},
  children: children.flat().filter(c => c !== null && c !== undefined && c !== false),
});
const TX = (text, props) => h("Text", props, String(text));

const K = {
  muted: "textMuted",
  hover: "surfaceHover",
  press: "surfacePressed",
  line: "border",
  up: "success",
  warn: "warning",
  down: "danger",
  accent: "accent",
};
const W = 460;

const svg = paths =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

const BRAND_DARK = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 200 200\"><g transform=\"translate(0,200) scale(0.1,-0.1)\" fill=\"currentColor\"><path d=\"M844 1875 c-40 -7 -89 -18 -110 -25 -71 -22 -220 -101 -277 -145 -81\n-65 -188 -194 -240 -294 -134 -253 -134 -570 0 -823 61 -116 89 -145 146 -153\n48 -7 119 16 145 47 11 14 6 17 -35 22 -64 9 -166 59 -210 103 -80 81 -131\n194 -103 228 30 36 74 12 100 -53 15 -37 90 -118 119 -127 21 -6 71 10 71 23\n0 5 -19 17 -42 28 -133 60 -227 243 -228 447 0 102 18 147 59 147 16 0 33 -6\n38 -12 4 -7 8 -60 9 -118 1 -142 10 -161 40 -81 40 106 115 226 250 396 81\n103 119 166 129 213 4 17 9 32 11 32 3 0 23 -9 45 -21 l41 -20 -9 -52 c-14\n-88 -8 -187 16 -248 12 -31 50 -103 84 -160 75 -125 83 -143 92 -203 4 -25 11\n-46 17 -46 5 0 31 22 58 49 91 91 135 220 111 326 -7 31 -22 77 -33 101 -18\n42 -18 47 -4 70 9 13 23 24 31 24 11 0 4 18 -24 63 l-40 62 46 24 c45 22 47\n23 60 5 73 -104 161 -182 258 -229 66 -33 192 -72 201 -62 2 2 -31 25 -73 50\n-104 62 -153 109 -153 148 0 22 7 32 25 41 21 9 29 7 57 -16 47 -38 179 -126\n190 -126 24 0 -70 108 -151 174 -205 167 -466 237 -717 191z M1256 1428 c25\n-65 81 -154 127 -203 28 -29 29 -29 22 -5 -4 14 -20 49 -36 79 -16 30 -29 66\n-30 80 0 19 -14 37 -54 68 l-53 43 24 -62z M585 1312 c-89 -136 -182 -308\n-173 -318 3 -2 29 13 59 35 60 44 58 43 95 89 28 35 50 39 92 18 15 -7 64 -16\n110 -19 l83 -5 -18 28 c-75 118 -105 175 -125 237 -13 40 -25 73 -28 73 -3 0\n-45 -62 -95 -138z M1481 1301 c47 -82 184 -257 187 -238 5 25 -15 113 -40 179\n-22 55 -23 56 -77 71 -31 7 -64 18 -75 22 -16 7 -16 4 5 -34z M1766 1309 c-22\n-5 -41 -11 -43 -12 -1 -2 6 -31 17 -65 46 -146 44 -312 -5 -419 -20 -43 -21\n-53 -9 -53 36 0 114 62 140 112 22 42 18 234 -6 333 -33 131 -23 120 -94 104z\nM1249 1153 c-36 -131 -201 -293 -297 -293 -45 0 -65 30 -63 94 l1 55 -37 -6\nc-21 -3 -39 -7 -40 -7 -1 -1 7 -22 19 -46 31 -63 35 -137 10 -187 -48 -92\n-133 -129 -226 -98 -27 9 -49 15 -51 13 -5 -6 -35 -67 -35 -72 0 -2 16 0 36 6\n71 19 106 -12 90 -80 -13 -55 -13 -55 48 -74 141 -43 356 -47 543 -9 180 37\n307 101 361 181 23 34 23 34 4 50 -36 28 -34 51 7 119 l39 63 -38 34 c-46 42\n-54 42 -46 4 10 -53 -11 -124 -49 -160 -30 -29 -43 -34 -93 -38 -95 -7 -162\n37 -187 122 -33 109 -2 237 66 272 l29 15 -32 44 c-18 24 -36 44 -39 45 -4 0\n-12 -21 -20 -47z m-79 -543 c24 -24 25 -32 5 -75 -17 -34 -50 -55 -89 -55 -60\n0 -98 88 -57 129 29 29 112 30 141 1z M1351 991 c-37 -37 -19 -78 40 -87 29\n-5 41 -2 58 15 26 26 26 33 4 60 -27 32 -76 38 -102 12z M630 983 c-52 -19\n-66 -72 -26 -98 28 -19 64 -12 95 16 50 47 0 107 -69 82z M1312 878 c-7 -7\n-12 -27 -12 -45 0 -82 128 -125 190 -63 21 21 26 65 11 88 -17 28 -165 44\n-189 20z M642 849 c-62 -24 -82 -54 -64 -94 26 -57 138 -71 188 -24 38 36 38\n106 0 131 -19 13 -69 8 -124 -13z M447 840 c-41 -18 -39 -24 21 -54 36 -18 38\n-14 23 45 l-6 26 -38 -17z M1713 579 c-98 -48 -171 -180 -133 -239 15 -24 107\n79 194 218 l26 42 -22 0 c-13 0 -42 -9 -65 -21z M1395 391 l-50 -18 36 -4 c46\n-6 57 -2 69 22 13 23 10 23 -55 0z M566 392 c-3 -5 -2 -18 1 -30 6 -25 43 -29\n90 -11 l28 11 -50 19 c-56 21 -62 22 -69 11z M435 341 l-30 -6 53 -42 c61 -49\n85 -58 109 -44 17 10 17 10 1 11 -34 0 -66 23 -75 53 -9 34 -15 37 -58 28z\nM1060 335 c-137 -11 -149 -14 -225 -51 -85 -42 -175 -93 -175 -100 0 -17 173\n-64 241 -64 45 0 45 0 41 30 -2 17 1 37 8 45 18 22 93 20 113 -3 21 -23 21\n-31 2 -52 -14 -16 -13 -18 13 -23 16 -3 45 0 66 7 l36 13 -25 11 c-34 16 -32\n48 5 67 56 29 109 11 110 -37 0 -25 47 -14 135 30 67 34 69 35 45 46 -14 6\n-27 13 -30 17 -3 4 -30 12 -60 18 -30 7 -73 23 -97 36 -23 14 -45 24 -50 24\n-4 -1 -73 -7 -153 -14z\"/></g></svg>";
const BRAND_LIGHT = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 200 200\"><g transform=\"translate(0,200) scale(0.1,-0.1)\" fill=\"currentColor\"><path d=\"M819 1975 c-473 -95 -809 -500 -809 -975 0 -609 558 -1081 1155 -976\n415 73 738 396 811 811 83 473 -203 950 -664 1104 -148 50 -348 64 -493 36z\nm338 -100 c215 -41 419 -167 548 -340 l30 -39 -60 33 c-53 30 -131 85 -145\n102 -6 7 -46 29 -54 29 -13 0 -36 -34 -36 -54 0 -35 81 -105 194 -167 101 -56\n-64 -21 -174 37 -103 54 -178 122 -266 242 -4 6 -84 -38 -84 -46 0 -4 15 -32\n34 -62 l35 -55 -25 -13 c-28 -15 -32 -57 -10 -100 8 -15 20 -56 27 -90 15 -73\n4 -144 -33 -220 -23 -46 -118 -152 -136 -152 -6 0 -13 22 -17 49 -4 32 -23 78\n-52 128 -153 261 -169 319 -137 494 6 34 4 37 -35 57 -23 12 -44 22 -46 22 -2\n0 -7 -17 -11 -37 -9 -47 -37 -93 -128 -208 -128 -162 -212 -294 -250 -396 -30\n-80 -39 -61 -41 84 -1 59 -7 113 -12 118 -6 6 -23 9 -39 7 -43 -5 -57 -57 -50\n-178 11 -201 95 -352 230 -417 20 -9 36 -20 36 -25 0 -11 -36 -28 -60 -28 -28\n0 -100 75 -136 141 -30 56 -60 73 -90 49 -51 -44 64 -228 183 -292 27 -15 77\n-32 112 -39 l64 -12 -31 -28 c-37 -33 -105 -46 -156 -29 -25 8 -45 26 -69 63\n-105 158 -151 310 -151 497 0 351 196 659 514 807 166 78 351 101 527 68z\nm154 -448 c26 -19 35 -34 32 -46 -3 -10 5 -37 16 -59 11 -22 32 -66 46 -98\nl26 -59 -31 35 c-50 56 -135 191 -149 235 -7 22 -15 47 -18 55 -3 8 5 4 18\n-10 13 -14 40 -38 60 -53z m-581 -111 c11 -27 40 -79 64 -115 24 -36 46 -71\n49 -78 10 -16 -149 -5 -185 13 -15 8 -35 14 -44 14 -21 0 -64 -38 -64 -56 0\n-7 -10 -18 -21 -25 -12 -6 -42 -27 -67 -45 -24 -19 -47 -33 -49 -30 -11 10 80\n178 173 320 l97 148 13 -48 c7 -27 22 -71 34 -98z m781 10 c24 -8 56 -17 70\n-20 38 -8 68 -88 92 -241 l5 -30 -30 35 c-76 89 -201 270 -186 270 3 0 24 -6\n49 -14z m333 -58 c31 -108 38 -156 39 -258 1 -117 -8 -143 -65 -196 -37 -36\n-69 -54 -93 -54 -13 0 -13 5 4 38 32 64 44 142 38 253 -4 91 -12 131 -42 225\n-6 19 -1 23 32 32 67 18 70 16 87 -40z m-537 -113 l33 -44 -30 -18 c-43 -25\n-80 -104 -80 -168 0 -142 70 -225 188 -225 94 0 154 66 154 170 0 33 2 60 5\n60 3 0 23 -15 43 -34 l38 -34 -39 -63 c-41 -68 -43 -91 -7 -119 19 -16 19 -16\n-4 -50 -116 -172 -604 -265 -904 -172 -61 19 -61 19 -48 74 16 68 -19 99 -90\n80 -20 -6 -36 -9 -36 -7 0 3 8 20 17 40 14 29 21 35 38 30 99 -31 158 -24 208\n23 70 66 85 160 39 252 -12 24 -20 45 -19 46 1 0 19 4 40 7 l37 6 0 -56 c0\n-88 35 -112 117 -78 97 41 213 174 242 278 8 26 16 47 20 47 3 -1 21 -21 38\n-45z m138 -170 c30 -30 31 -39 4 -66 -36 -36 -119 -10 -119 38 0 22 38 53 65\n53 14 0 37 -11 50 -25z m-741 -11 c49 -49 -40 -128 -100 -89 -14 9 -24 25 -24\n39 0 51 88 87 124 50z m755 -94 c39 -11 51 -24 51 -60 0 -61 -65 -94 -141 -71\n-60 18 -92 86 -59 126 15 17 96 20 149 5z m-693 -18 c39 -26 38 -95 -2 -133\n-74 -69 -235 3 -182 82 25 39 151 74 184 51z m-267 -75 c1 -17 -1 -17 -31 -1\n-60 30 -62 36 -21 54 l38 17 6 -26 c4 -14 7 -34 8 -44z m1270 -239 c-36 -62\n-133 -183 -163 -203 -35 -25 -46 14 -25 89 20 71 132 166 196 166 22 0 22 -1\n-8 -52z m-315 -153 c-10 -24 -35 -33 -79 -27 l-39 5 54 17 c70 23 70 23 64 5z\nm-823 -11 c27 -9 49 -20 49 -24 0 -8 -50 -20 -86 -20 -23 0 -41 30 -29 50 8\n13 7 13 66 -6z m-134 -71 c13 -27 28 -41 52 -49 26 -8 30 -12 16 -17 -29 -12\n-39 -8 -100 40 l-60 48 30 6 c17 4 33 7 37 8 3 0 15 -16 25 -36z m778 7 c31\n-16 65 -30 74 -30 30 0 121 -30 121 -40 0 -14 -129 -77 -173 -85 -30 -6 -36\n-5 -32 7 3 8 -3 25 -13 38 -15 19 -24 22 -54 16 -63 -12 -86 -66 -35 -82 17\n-5 15 -8 -18 -20 -21 -7 -51 -10 -67 -7 -27 5 -28 7 -13 23 42 46 -55 96 -109\n57 -14 -10 -17 -23 -14 -45 l5 -32 -47 0 c-60 0 -194 34 -234 60 -17 11 -25\n20 -18 20 8 0 71 28 140 62 l127 61 140 12 c77 7 145 13 151 14 7 0 38 -12 69\n-29z M1029 609 c-41 -41 -3 -129 57 -129 39 0 72 21 89 55 20 43 19 51 -5 75\n-29 29 -112 28 -141 -1z\"/></g></svg>";
const isDarkTheme = () => {
  try {
    return !!(globalThis.matchMedia && globalThis.matchMedia("(prefers-color-scheme: dark)").matches);
  } catch (e) {
    return true;
  }
};
const BRAND = BRAND_DARK;
const cardBg = () => (isDarkTheme() ? "bg-surface" : "bg-background");

const ICON = {
  brand: BRAND_DARK,
  brandLight: BRAND_LIGHT,
  server: svg(`<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/><path d="M13 6h5"/><path d="M13 18h5"/>`),
  refresh: svg(`<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>`),
  external: svg(`<path d="M7 7h10v10"/><path d="M7 17 17 7"/>`),
  back: svg(`<path d="m15 18-6-6 6-6"/>`),
  alert: svg(`<circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>`),
  cpu: svg(`<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>`),
  ram: svg(`<rect width="18" height="12" x="3" y="6" rx="2"/><path d="M7 10v4"/><path d="M12 10v4"/><path d="M17 10v4"/>`),
  disk: svg(`<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>`),
  gauge: svg(`<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>`),
  activity: svg(`<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>`),
  barchart: svg(`<line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/>`),
  globe: svg(`<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>`),
  calendar: svg(`<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>`),
  clock: svg(`<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`),
  sort: svg(`<path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/>`),
  chevDown: svg(`<path d="m6 9 6 6 6-6"/>`),
  chevUp: svg(`<path d="m18 15-6-6-6 6"/>`),
  link: svg(`<circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="M8.59 8.59 15.42 15.42"/>`),
};

const Icon = (name, size, color, extra) =>
  h("Icon", {
    svg: ICON[name] || BRAND,
    ...extra,
    tw: `text-[${size || 14}px] size-[${size || 14}px] text-${color || K.muted} shrink-0 ${(extra && extra.tw) || ""}`,
  });

// ---------------------------------------------------------------------------
// i18n Dictionary (auto-detected, fallback zh)
// ---------------------------------------------------------------------------

const I18N = {
  zh: {
    onlineBadge: (on, total, off) => (off > 0 ? `${on}/${total} 在线` : `${on} 在线`),
    onlineNodes: "在线节点",
    liveBandwidth: "实时带宽",
    totalTraffic: "累计流量",
    allGroup: n => `全部 (${n})`,
    sortBy: "排序",
    sortWeight: "权重",
    sortCpu: "CPU",
    sortRam: "内存",
    sortNet: "网速 ↓",
    cores: n => `${n || "?"} 核`,
